#!/bin/bash -p
# grassfield-update-helper: the program of Software Update's polkit action org.grassfield.packages.update-system (ADR-0033
# "Step 3", owner decision SU-M1; "Step 5", owner decision SU-M2; docs/specs/updates.md U24-U30, U32). OPUS SECURITY REVIEW
# REQUIRED: it runs as root.
# Started only as `pkexec /usr/lib/grassfield/grassfield-update-helper run <op-id> [<migration>...]` by
# grassfield-update-run (the user's runner, started by Settings' Update Now), which waits for it:
#   run <op-id> [<migration>...]  Omarchy's system update without a terminal (s3.2): a plan from a copy of the sync
#                                 databases, the compatibility check (s3.4), the steps that would need a person (s3.6),
#                                 then a snapshot, the checked databases, the keyring and `pacman -Su`. <migration>: up to
#                                 64 names of Omarchy migrations already pending for the user (`omarchy-migrate --pending`),
#                                 scanned with those the update adds.
# The operation id is 32 lowercase hexadecimal digits the runner made; it is used once.
# It runs no Omarchy script as root: each root step is the system program an Omarchy update script calls with sudo, with
# its arguments (omarchy-update-requires-free-space, omarchy-update-pkg-prune, omarchy-snapshot, omarchy-update-stay-awake,
# omarchy-update-keyring, omarchy-update-system-pkgs, omarchy-update-analyze-logs, omarchy-update-restart; pinned in
# docs/upstream/omarchy.lock and omarchy-4.5.0.lock). It follows Omarchy 4.0.6 and 4.5.0; of 4.5.0's new steps, omarchy-update-boot
# is a no-op outside Apple Silicon (omarchy-lifecycle-dispatch registers no update-verify elsewhere) and omarchy-update-pacman
# only wraps the same pacman in a systemd scope, which this unit already is. Omarchy's own files are read as data only: the new omarchy package's migrations and
# commands, extracted where only root reads, for the scan. One exception, SU-M2 (s5): when the migrations this update adds
# use `sudo` and nothing that needs a person, it runs them after the transaction AS THE PERSON who chose Update Now (an
# administrator: a member of wheel), in the transient unit grassfield-update-migrate.service, under the primary group
# grassfield-update that no one is a member of (so none of that person's other processes can open the unit's /proc
# entries), whose `sudo` (/usr/lib/grassfield/update-sudo/sudo) gets each command a transient root unit from systemd,
# granted by polkit to that unit alone (/usr/share/polkit-1/rules.d/49-grassfield-update.rules). That person is pkexec's
# caller, this process's parent: its real uid, and two values of its session (WAYLAND_DISPLAY,
# HYPRLAND_INSTANCE_SIGNATURE), read from /proc and checked, for that unit only. Every migration of the run goes into that
# unit, so none may run code the person can change (rc7 audit R7-SEC-01): a migration that reaches omarchy-hook (it runs
# ~/.config/omarchy/hooks), an interpreter or tool that reads the home folder's code or settings (python, git, npm, npx,
# mise), or a `source`/`.`/shell of a home path, sends the run to Omarchy's terminal like a person's step would; in the unit
# PYTHONNOUSERSITE=1 and GIT_CONFIG_GLOBAL=/dev/null also keep a program the scan does not see from the person's Python
# packages and git settings.
# Exit: 0 done, or up to date (`packages 0`); 1 failed during the transaction (the system can be partly updated); 2 usage,
# or an operation id used before; 3 busy (another run, or a process holding pacman's db.lck); 4 less than 10 GiB free on /;
# 5 on battery below 50 %; 6 needs a newer Grassfield (the compatibility check); 7 needs a person (Omarchy's terminal; also a
# db.lck no process holds: `needs stalelock`); 8 failed before installing anything (`synced` when the checked sync databases
# had already become the system's). pkexec itself exits 126 (the dialog dismissed) and 127 (not authorized). A run that ran
# the migrations (SU-M2) says `migrations ran`.
#
# Its only input is its argument vector. -p keeps bash from reading BASH_ENV or importing a function; then, while its
# environment holds anything at all, it runs itself again under `env -i`, so no variable reaches it or a program it starts
# (grassfield-store-helper's rule; it reads no variable, not even PKEXEC_UID). The variables bash exports itself (PWD,
# SHLVL) are removed last.
#
# On a system run by systemd it starts itself again as the transient system service grassfield-update.service
# (`systemd-run --wait`, as `unit <op-id> <uid> <wayland-display> <hyprland-instance> [<migration>...]`, a form taken only
# inside that unit) and waits for it: the transaction then belongs to no user session, so closing Settings, the
# runner's end or a log out cannot stop pacman, and the unit's name allows one run at a time. A stop of the unit
# (KillMode=mixed: SIGTERM to this process only) ends the run at once while nothing has changed; from the snapshot on, it is
# logged and the run goes on to its end (pacman is never signalled), within TimeoutStopSec (30 min). Without systemd as the
# system's manager (a container) it runs in place.
#
# What it writes, besides what pacman writes: in /run/grassfield-update/ (root, 0755), <op-id>.log (its messages and
# pacman's output, 0644, at most 8 MiB), <op-id>.started (its pid and start time), <op-id>.progress (one line, by rename:
# checking | snapshot | keyring | downloading <done> <total> | installing <done> <total> | finishing), <op-id>.exit (by
# rename, last: the code, then `key value` lines), last (the newest operation id, by rename), helper.lock (0600); the
# temporary databases and the extracted files (sync.<op-id>, work.<op-id>), removed when it ends. Only the 16 newest
# operations' files are kept. Its descriptors are /dev/null and the log, it ignores SIGHUP and SIGPIPE, and the only
# processes it signals are its own sleep inhibitor's.
# No here-string or here-document anywhere: bash writes a large one to a file in /tmp, and an unwritable or full /tmp would
# then make a list read empty (the integrator's re-review of 1ce7c37). Lists come through pipes or files in its own folder,
# each read checked.
if IFS= read -r -d '' _ 2>/dev/null </proc/$$/environ; then   # stderr first: without /proc, no message
  exec /usr/bin/env -i /usr/bin/bash -p /usr/lib/grassfield/grassfield-update-helper "$@"
fi
while read -r gu_var; do unset -v "$gu_var" 2>/dev/null; done < <(compgen -e)
unset -v gu_var
export PATH=/usr/bin LC_ALL=C
IFS=$' \t\n'
umask 022
set -uo pipefail
shopt -s lastpipe
trap '' HUP PIPE
cd / || exit 1
exec </dev/null
[[ -t 1 ]] || exec >/dev/null
[[ -t 2 ]] || exec 2>/dev/null

GU_SELF=/usr/lib/grassfield/grassfield-update-helper
GU_DIR=/run/grassfield-update
GU_UNIT=grassfield-update
GU_LOG_MAX=$((8 << 20))
GU_KEEP=16
GU_MIN_FREE=$((10 << 30))   # omarchy-update-requires-free-space
GU_MIN_BATTERY=50           # macOS's rule for an update on battery
GU_OMARCHY_FPR=40DFB630FF42BCFFB047046CF0134EE680CAC571   # omarchy-update-keyring
GU_RECORD=usr/share/grassfield/BUILD-DEPS
# s3.4: the packages Grassfield is built against, and how much of their version must match its record.
GU_TRACKED=(qt6-base quickshell hyprland aquamarine kcoreaddons)
# s3.7: a change to one of these asks for a restart (the session's own libraries and compositor).
GU_TOOLKIT=(qt6-base quickshell aquamarine kcoreaddons)
# s3.6: what makes an Omarchy migration or command need a person; s5: what makes it need root (sudo, which SU-M2 gives it).
GU_PERSON_WORDS='pkexec|su|run0|doas|gum'
GU_PERSON_EXTRA='/dev/tty|/(usr/)?s?bin/sudo([^[:alnum:]_.-]|$)'   # a sudo by its path is not the unit's sudo
GU_ROOT_WORDS='sudo'
# s5 (rc7 audit R7-SEC-01): what makes a migration run code the person can change, which the unit's sudo would then make root:
# Omarchy's hook runner (bash ~/.config/omarchy/hooks/<name> and <name>.d/*), interpreters and tools that load code or
# settings from the home folder (Python's user site-packages and .pth files, a repository's or ~/.gitconfig's commands, npm's
# ~/.npmrc and scripts, mise's config and plugins), and a script of the home folder sourced or run by a shell. Scanned as the
# person words are (the commands that reach them too, comments count); they matter only when the run would give root: then
# any migration of the run that matches keeps the whole run out of the unit (Omarchy's terminal runs them). Bare `node` is
# not a word (PipeWire's "node" is in Omarchy's audio commands): a migration that runs node through npm or npx is caught.
GU_USER_WORDS='omarchy-hook|python3?(\.[0-9]+)?|git|npm|npx|mise'
GU_USER_EXTRA='(^|[^[:alnum:]_.-])(source|\.|bash|sh|zsh)[[:space:]]+["'"'"']?(~|\$HOME|\$\{HOME\}|\$XDG_CONFIG_HOME|\$\{XDG_CONFIG_HOME)'
# s5 (SU-M2): the migrations' unit, its primary group (sysusers.d, no member: the kernel lets a process open another's /proc
# entries, descriptors included, or attach to it, only when all its uids AND gids match), its sudo, the polkit rule that
# lets that unit alone start root units, and the group of the administrators (Arch's polkit rule, Omarchy's sudoers).
GU_MIGRATE_UNIT=grassfield-update-migrate
GU_MIGRATE_GROUP=grassfield-update
GU_ADMIN_GROUP=wheel
GU_SUDO_DIR=/usr/lib/grassfield/update-sudo
GU_RULE=/usr/share/polkit-1/rules.d/49-grassfield-update.rules

usage() {
  echo "usage: grassfield-update-helper run <op-id> [<migration>...] (run by grassfield-update-run through pkexec)" >&2
  exit 2
}
((EUID == 0)) || { echo "grassfield-update-helper: must run as root" >&2; exit 2; }
in_unit() { grep -qxF "0::/system.slice/$GU_UNIT.service" /proc/self/cgroup 2>/dev/null; }
# The person (s5): "-" until the unit's instance is told, by the instance pkexec started.
caller_uid=- caller_wayland=- caller_hypr=-
if [[ ${1-} == unit ]] && in_unit; then
  (($# >= 5 && $# <= 69)) || usage
  caller_uid=$3 caller_wayland=$4 caller_hypr=$5
  [[ $caller_uid == - || ($caller_uid =~ ^[1-9][0-9]{3,9}$ && $caller_uid -le 2147483646) ]] || usage
  [[ $caller_wayland == - || $caller_wayland =~ ^wayland-[0-9]{1,4}$ ]] || usage
  [[ $caller_hypr == - || $caller_hypr =~ ^[A-Za-z0-9_]{1,128}$ ]] || usage
  set -- run "$2" "${@:6}"
fi
(($# >= 2 && $# <= 66)) || usage
[[ $1 == run && $2 =~ ^[0-9a-f]{32}$ ]] || usage
op=$2
shift 2
for name in "$@"; do
  [[ $name =~ ^[0-9]{1,20}\.sh$ ]] || usage
done

# The status folder: root's own, 0755 (Settings and the runner read it as the user), never a link.
(umask 022 && mkdir -p -- "$GU_DIR") 2>/dev/null
[[ -d $GU_DIR && ! -L $GU_DIR && $(stat -c %u:%a -- "$GU_DIR") == 0:755 ]] ||
  { echo "grassfield-update-helper: $GU_DIR is not root's own folder (0755): refused" >&2; exit 1; }

# The transient unit (systemd only). This instance makes no file of the operation: the unit's does. When the unit never
# ran this operation (its name is taken by another run), this one says busy.
if [[ -d /run/systemd/system ]] && ! in_unit; then
  # The person whose Update Now this is (s5): pkexec's caller, which waits for this run (pkexec refuses a caller that is
  # gone). Its real uid; below 1000 (root, a system user) no migration runs here. Two values of its session, for the
  # migrations' unit only, which runs as that person: anything else in its environment is not read.
  while read -r key value _; do
    [[ $key == Uid: && $value =~ ^[1-9][0-9]{3,9}$ ]] && ((value <= 2147483646)) && caller_uid=$value
  done <"/proc/$PPID/status" 2>/dev/null
  if [[ $caller_uid != - ]]; then
    while IFS= read -r -d '' entry; do
      case $entry in
        WAYLAND_DISPLAY=*) [[ ${entry#*=} =~ ^wayland-[0-9]{1,4}$ ]] && caller_wayland=${entry#*=} ;;
        HYPRLAND_INSTANCE_SIGNATURE=*) [[ ${entry#*=} =~ ^[A-Za-z0-9_]{1,128}$ ]] && caller_hypr=${entry#*=} ;;
      esac
    done <"/proc/$PPID/environ" 2>/dev/null
  fi
  systemd-run --unit="$GU_UNIT" --description="Grassfield Software Update" --collect --quiet --wait \
    --service-type=exec -p KillMode=mixed -p TimeoutStopSec=30min -- \
    "$GU_SELF" unit "$op" "$caller_uid" "$caller_wayland" "$caller_hypr" "$@"
  if [[ -f $GU_DIR/$op.exit ]]; then
    read -r code <"$GU_DIR/$op.exit"
    [[ $code =~ ^[0-9]{1,3}$ ]] && exit "$code"
    exit 1
  fi
  if (set -C && : >"$GU_DIR/$op.log") 2>/dev/null; then
    echo "grassfield-update-helper: another update is running" >>"$GU_DIR/$op.log"
    printf '3\n' >|"$GU_DIR/.$op.exit" && mv -f -- "$GU_DIR/.$op.exit" "$GU_DIR/$op.exit"
  fi
  exit 3
fi

log=$GU_DIR/$op.log
# An operation id is used once: its log is made here or the run stops (noclobber makes > fail on an existing file).
(set -C && : >"$log") 2>/dev/null || { echo "grassfield-update-helper: operation $op was used before" >&2; exit 2; }
exec >>"$log" 2>&1

say() { echo "grassfield-update-helper: $*"; }
outcome=()   # the exit file's `key value` lines
tmpdb=$GU_DIR/sync.$op
work=$GU_DIR/work.$op
inhibitor=""
own_db_lock=""
changing=0
cleanup() {
  [[ -n $own_db_lock ]] && rm -f -- "$own_db_lock"
  [[ -n $inhibitor ]] && kill "$inhibitor" 2>/dev/null
  rm -rf -- "$tmpdb" "$work" 2>/dev/null
}
trap cleanup EXIT
# The exit file, by rename (no reader sees half a file), then the exit.
finish() { # code [message]
  (($# > 1)) && say "$2"
  { printf '%s\n' "$1"; ((${#outcome[@]} == 0)) || printf '%s\n' "${outcome[@]}"; } >|"$GU_DIR/.$op.exit" &&
    mv -f -- "$GU_DIR/.$op.exit" "$GU_DIR/$op.exit"
  exit "$1"
}
# A stop (the unit's SIGTERM): at once while nothing has changed; afterwards the run goes on to its end.
on_term() {
  if ((changing)); then
    say "asked to stop while the system changes: going on to the end"
  else
    finish 8 "stopped before anything changed"
  fi
}
trap on_term TERM
progress() { # phase [done total]
  printf '%s\n' "$*" >|"$GU_DIR/.$op.progress" && mv -f -- "$GU_DIR/.$op.progress" "$GU_DIR/$op.progress"
}

# Its pid and start time (field 22 of /proc/<pid>/stat; the command name before it is in parentheses and may hold spaces).
read -r stat </proc/$$/stat || finish 1 "cannot read /proc/$$/stat"
rest=${stat##*) }
read -r -a fields < <(printf '%s\n' "$rest")
printf '%s %s\n' "$$" "${fields[19]-}" >|"$GU_DIR/.$op.started" && mv -f -- "$GU_DIR/.$op.started" "$GU_DIR/$op.started" ||
  finish 1 "cannot write $GU_DIR/$op.started"
printf '%s\n' "$op" >|"$GU_DIR/.last" && mv -f -- "$GU_DIR/.last" "$GU_DIR/last"
progress checking
say "run $* (operation $op)"

# The files of older operations: the 16 newest kept; a temporary folder an interrupted run left goes too.
mapfile -t olds < <(find "$GU_DIR" -maxdepth 1 -type f -name '*.started' -printf '%T@ %f\n' | sort -rn | awk -v keep="$GU_KEEP" 'NR > keep { sub(/\.started$/, "", $2); print $2 }')
for old in "${olds[@]}"; do
  [[ $old =~ ^[0-9a-f]{32}$ ]] && rm -f -- "$GU_DIR/$old".{started,log,exit,progress,migrations}
done

# One run at a time: a lock only root can open. Every program started below gets `9<&-`: a process a package's scriptlet
# leaves running would otherwise keep the lock.
lock=$GU_DIR/helper.lock
(umask 077 && : >>"$lock") || finish 1 "cannot create $lock"
[[ -f $lock && ! -L $lock && $(stat -c %u:%a -- "$lock") == 0:600 ]] || finish 1 "$lock is not root's own (0600): refused"
exec 9<"$lock" || finish 1 "cannot open $lock"
flock -n 9 || finish 3 "another update is running"
find "$GU_DIR" -mindepth 1 -maxdepth 1 -type d \( -name 'sync.*' -o -name 'work.*' \) -exec rm -rf -- {} + 2>/dev/null

dbpath=$(pacman-conf DBPath 9<&-) || finish 8 "pacman-conf DBPath failed"
dbpath=${dbpath%/}
[[ $dbpath == /* && -d $dbpath/local ]] || finish 8 "pacman's database folder is unknown"
# pacman's db.lck: a process that holds it open is a running pacman (libalpm keeps its descriptor until it unlocks); a lock
# no process holds was left by one that stopped mid-way, which a person clears (Omarchy's terminal shows pacman's advice).
# A pacman that unlocks closes the lock before it removes it: a lock no process holds is looked at again a second later, and
# only one still there is stale.
no_db_lock() {
  local try
  for try in 1 2; do
    [[ -e $dbpath/db.lck || -L $dbpath/db.lck ]] || return 0
    if [[ -n $(find /proc/[0-9]*/fd -maxdepth 1 -lname "$dbpath/db.lck" -print -quit 2>/dev/null 9<&-) ]]; then
      finish 3 "pacman is running ($dbpath/db.lck is held)"
    fi
    ((try == 1)) && sleep 1
  done
  outcome+=("needs stalelock")
  finish 7 "$dbpath/db.lck was left by a pacman that stopped mid-way: nothing was changed"
}
no_db_lock

# --- Preconditions (s3.2 step 3) ---------------------------------------------------------------------------------------
read -r free < <(df --output=avail --block-size=1 / 2>/dev/null 9<&- | tail -n 1)
if [[ ${free:-} =~ ^[0-9]+$ ]] && ((free < GU_MIN_FREE)); then
  finish 4 "less than 10 GiB free on / ($free bytes)"
fi
# On battery: refused only when no supply is online and a system battery discharges below 50 %.
online=0 low=0
for supply in /sys/class/power_supply/*/; do
  [[ -r ${supply}type ]] || continue
  read -r kind <"${supply}type" || continue
  scope=System
  [[ -r ${supply}scope ]] && read -r scope <"${supply}scope"
  case $kind in
    Mains | USB*)
      read -r value 2>/dev/null <"${supply}online" && [[ $value == 1 ]] && online=1
      ;;
    Battery)
      [[ $scope == Device ]] && continue
      read -r status 2>/dev/null <"${supply}status" || status=""
      read -r capacity 2>/dev/null <"${supply}capacity" || capacity=""
      [[ $status == Discharging && $capacity =~ ^[0-9]+$ ]] && ((capacity < GU_MIN_BATTERY)) && low=1
      ;;
  esac
done
((online == 0 && low == 1)) && finish 5 "on battery below $GU_MIN_BATTERY %"

declare -A installed=()
while read -r name version; do installed[$name]=$version; done < <(pacman -Q 2>/dev/null 9<&-)
# An empty answer would skip the compatibility and key checks: refused (the integrator's re-review of 0294373).
((${#installed[@]})) || finish 8 "pacman lists no installed package"

# --- The plan, from a copy of the sync databases (s3.2 step 4) ---------------------------------------------------------
(umask 022 && mkdir -m 0755 -- "$tmpdb" && mkdir -m 0755 -- "$tmpdb/sync") || finish 8 "cannot make $tmpdb"
ln -s -- "$dbpath/local" "$tmpdb/local" || finish 8 "cannot link the local database"
mapfile -t repos < <(pacman-conf --repo-list 2>/dev/null 9<&-)
# None would leave the checked databases unswapped, and the transaction on the system's own: refused.
((${#repos[@]})) || finish 8 "pacman's configuration names no repository"
for repo in "${repos[@]}"; do
  [[ $repo =~ ^[A-Za-z0-9._-]+$ ]] || finish 8 "a repository name pacman cannot have: $repo"
  for file in "$dbpath/sync/$repo.db" "$dbpath/sync/$repo.db.sig"; do
    [[ -f $file && ! -L $file ]] && cp -p -- "$file" "$tmpdb/sync/"
  done
done
say "pacman -Sy (a copy of the databases)"
pacman -Sy --dbpath "$tmpdb" --logfile /dev/null --noprogressbar 9<&- || finish 8 "the package servers could not be reached"
plan=$(pacman -Su --print --print-format '%n %v %l' --noconfirm --dbpath "$tmpdb" --logfile /dev/null 9<&-) ||
  finish 8 "pacman cannot plan this update"
declare -A after=() url=()
count=0
while read -r pkg version location extra; do
  [[ -z $pkg ]] && continue
  [[ $pkg =~ ^[a-z0-9@_+][a-z0-9@._+-]*$ && $version =~ ^[A-Za-z0-9:._+~-]+$ && -n $location && -z $extra ]] ||
    finish 8 "pacman's plan cannot be read"
  after[$pkg]=$version
  url[$pkg]=$location
  count=$((count + 1))
done < <(printf '%s\n' "$plan")
# A plan with text but no package read is no "up to date".
[[ $count -gt 0 || -z ${plan//[[:space:]]/} ]] || finish 8 "pacman's plan cannot be read"
if ((count == 0)); then
  outcome+=("packages 0")
  finish 0 "up to date"
fi
say "plan: $count packages"

mapfile -t caches < <(pacman-conf CacheDir 9<&-)
((${#caches[@]})) || finish 8 "pacman's configuration names no cache folder"
cached() { # package -> the path of its file in pacman's cache, if there
  local file=${url[$1]##*/} cache
  [[ -n $file && $file != .* && $file == "$1"-* ]] || return 1
  for cache in "${caches[@]}"; do
    [[ -f ${cache%/}/$file && ! -L ${cache%/}/$file ]] && { printf '%s\n' "${cache%/}/$file"; return 0; }
  done
  return 1
}

# --- The files the checks read (s3.2 step 5): each downloaded from the copy, its signature checked ----------------------
download() { # package
  say "downloading $1 to read it"
  pacman -Sw --noconfirm --noprogressbar --dbpath "$tmpdb" --logfile /dev/null -- "$1" 9<&- ||
    finish 8 "pacman could not download $1"
}
(umask 077 && mkdir -m 0700 -- "$work") || finish 8 "cannot make $work"

# s5 (SU-M2): a program as the person, in grassfield-update-migrate.service:
#   - the person's uid, the primary group grassfield-update (no member); systemd adds the person's own groups as
#     supplementary ones (its initgroups), and its primary group explicitly, so its files stay its own. The person's other
#     processes then cannot open the unit's /proc entries (descriptors, environment, memory) or attach to it: the kernel
#     compares the real, effective and saved gids, not the supplementary ones (the step 5 review's MAJOR: a pipe of the
#     unit could be reopened through /proc/<pid>/fd by any process of the same uid and gid);
#   - no namespace of its own (RestrictNamespaces): a user namespace a migration made would belong to the person, whose
#     other processes could then reach into it (the integrator's review, MINOR 1); its personality locked, no setuid or
#     setgid file made;
#   - no new privileges (no setuid program, so no real sudo or pkexec), a /tmp of its own that the root units of its sudo
#     join (no other process can reach its temporary files), its sudo first in PATH, Omarchy's folder, the person's runtime
#     folder and session bus, and the two session values pkexec's caller had;
#   - standard input /dev/null, its output to $migrations (root's, 0600; read below with the log, cut to 8 MiB once the
#     migrations end), no file the unit's own processes write past 64 MiB (their root commands, in units of their own, are
#     not bound by it: a boot image or a package is bigger; their output is cut with the rest at the end), at most 30
#     minutes, and every process of the unit ends with it, given 5 seconds.
# Its exit status.
# A path root's alone (the integrator's review, MINOR 2: the unit runs the installed migrations, which nothing but root may
# then change): every folder on the path as written, each link on it owned by root (the folder that holds a link decides who
# can swap it: its follow-up 1), then the file and every folder above it, links resolved; each owned by root and writable
# by no one else.
root_alone() { # path
  local p=$1 owner mode
  [[ $p == /* ]] || return 1
  while [[ $p != / ]]; do
    if [[ -L $p ]]; then
      read -r owner < <(stat -c %u -- "$p" 2>/dev/null) && [[ $owner == 0 ]] || return 1
    fi
    p=${p%/*}
    [[ -n $p ]] || p=/
    read -r owner mode < <(stat -L -c '%u %a' -- "$p" 2>/dev/null) || return 1
    [[ $owner == 0 && $mode =~ ^[0-7]{3,4}$ ]] && (((8#$mode & 8#022) == 0)) || return 1
  done
  p=$(realpath -e -- "$1" 2>/dev/null) || return 1
  while :; do
    read -r owner mode < <(stat -c '%u %a' -- "$p" 2>/dev/null) || return 1
    [[ $owner == 0 && $mode =~ ^[0-7]{3,4}$ ]] && (((8#$mode & 8#022) == 0)) || return 1
    [[ $p == / ]] && return 0
    p=${p%/*}
    [[ -n $p ]] || p=/
  done
}
migrations=$GU_DIR/$op.migrations
migrate_unit() { # program [argument...]
  local env=(--setenv=PATH="$GU_SUDO_DIR:/usr/share/omarchy/bin:/usr/bin" --setenv=OMARCHY_PATH=/usr/share/omarchy
    --setenv=PYTHONNOUSERSITE=1 --setenv=GIT_CONFIG_GLOBAL=/dev/null
    --setenv=XDG_RUNTIME_DIR="/run/user/$caller_uid" --setenv=DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$caller_uid/bus")
  [[ $caller_wayland != - ]] && env+=(--setenv=WAYLAND_DISPLAY="$caller_wayland")
  [[ $caller_hypr != - ]] && env+=(--setenv=HYPRLAND_INSTANCE_SIGNATURE="$caller_hypr")
  (umask 077 && : >>"$migrations") && [[ -f $migrations && ! -L $migrations ]] || return 1
  systemd-run --unit="$GU_MIGRATE_UNIT" --description="Grassfield Software Update: Omarchy's migrations" --collect --quiet \
    --wait --service-type=exec --expand-environment=no --uid="$caller_uid" --gid="$GU_MIGRATE_GROUP" \
    -p SupplementaryGroups="$caller_gid" -p NoNewPrivileges=yes -p RestrictNamespaces=yes -p LockPersonality=yes \
    -p RestrictSUIDSGID=yes -p PrivateTmp=yes -p LimitFSIZE=64M -p RuntimeMaxSec=30min \
    -p TimeoutStopSec=5s -p KillMode=control-group -p 'WorkingDirectory=~' -p StandardInput=null \
    -p StandardOutput=append:"$migrations" -p StandardError=append:"$migrations" "${env[@]}" -- "$@" 9<&-
}
# The root units the migrations' sudo started (one per command): the run waits for them (30 minutes at most), so a long
# command (pacman) ends under this run's lock and sleep inhibitor, never after it.
wait_root_units() {
  local i units
  for ((i = 0; i < 1800; i++)); do
    units=$(systemctl list-units --plain --no-legend --state=activating,active,deactivating 'grassfield-update-root-*' 9<&- 2>/dev/null) ||
      { say "cannot list the migrations' root commands: not waiting for them"; return 0; }
    [[ -z $units ]] && return 0
    sleep 1
  done
  say "a migration's root command still runs after 30 minutes"
}
# s5: the loop of omarchy-migrate (Omarchy 4.0.6, bin/omarchy-migrate: each pending migration in order, `bash -euo pipefail`,
# its marker after it; the first failure stops), for the migrations this update adds only, by name: a marker removed meanwhile
# never brings an older migration into the unit. Run as the person; it reads nothing but its arguments and the person's
# markers.
GU_MIGRATE_LOOP='set -uo pipefail
state=$HOME/.local/state/omarchy/migrations
mkdir -p -- "$state" || exit 1
for name in "$@"; do
  [[ -f $state/$name || ! -f /usr/share/omarchy/migrations/$name ]] && continue
  printf "\nRunning migration (%s)\n" "${name%.sh}"
  bash -euo pipefail "/usr/share/omarchy/migrations/$name" 3<&- || exit 1
  touch -- "$state/$name" || exit 1
done'


# --- The compatibility check (s3.4) -------------------------------------------------------------------------------------
compare_key() { # package version -> the part of the version that must match
  local v=${2%-*}
  case $1 in
    quickshell) printf '%s' "$v" ;;
    *) if [[ $v =~ ^([0-9]+:)?([0-9]+)\.([0-9]+) ]]; then
         printf '%s%s.%s' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}"
       else
         printf '%s' "$v"
       fi ;;
  esac
}
check_needed=0
[[ -n ${after[grassfield-desktop]-} ]] && check_needed=1
for pkg in "${GU_TRACKED[@]}"; do
  [[ -n ${after[$pkg]-} ]] && check_needed=1
done
if ((check_needed)) && [[ -n ${after[grassfield-desktop]-} || -n ${installed[grassfield-desktop]-} ]]; then
  record=""
  if [[ -n ${after[grassfield-desktop]-} ]]; then
    download grassfield-desktop
    file=$(cached grassfield-desktop) || finish 8 "grassfield-desktop's package file is not in pacman's cache"
    record=$(bsdtar -xOf "$file" "$GU_RECORD" 2>/dev/null 9<&- | head -c 4096)
    say "the record of grassfield-desktop ${after[grassfield-desktop]} (this update)"
  elif [[ -f /$GU_RECORD && ! -L /$GU_RECORD ]]; then
    record=$(head -c 4096 -- "/$GU_RECORD")
    say "the record of the installed grassfield-desktop ${installed[grassfield-desktop]}"
  fi
  declare -A built=()
  while read -r name version extra; do
    [[ $name =~ ^[a-z0-9@_+][a-z0-9@._+-]*$ && $version =~ ^[A-Za-z0-9:._+~-]+$ && -z $extra ]] && built[$name]=$version
  done < <(printf '%s\n' "$record")
  refused=()
  for pkg in "${GU_TRACKED[@]}"; do
    now=${after[$pkg]-${installed[$pkg]-}}
    [[ -z $now ]] && continue
    if [[ -z ${built[$pkg]-} ]]; then
      refused+=("$pkg")
      say "$pkg $now: the record does not name it"
    elif [[ $(compare_key "$pkg" "$now") != $(compare_key "$pkg" "${built[$pkg]}") ]]; then
      refused+=("$pkg")
      say "$pkg $now: Grassfield was built with ${built[$pkg]}"
    fi
  done
  if ((${#refused[@]})); then
    for pkg in "${refused[@]}"; do outcome+=("incompatible $pkg"); done
    finish 6 "this update needs a newer Grassfield: nothing was changed"
  fi
  say "compatible"
fi

# --- The steps that would need a person (s3.6) --------------------------------------------------------------------------
# omarchy-update-keyring's test, after the compatibility check (an update it refuses is said so first). When it fails,
# Omarchy fetches its key from a keyserver and signs it: a trust decision, left to Omarchy's terminal.
if [[ -n ${installed[omarchy]-} ]]; then
  if [[ -z ${installed[omarchy-keyring]-} ]] || ! pacman-key --list-keys "$GU_OMARCHY_FPR" >/dev/null 2>&1 9<&-; then
    outcome+=("needs keyring")
    finish 7 "Omarchy's signing key is not in pacman's keyring: Omarchy's terminal update adds it"
  fi
fi
# The migrations pending after this update: those the new omarchy package adds, and those the runner named. The commands
# they may call: the new package's, else the installed ones. Omarchy 4.x ships its commands as files in usr/bin and links
# to them in usr/share/omarchy/bin: both folders are read, regular files only (a link would point at the installed, older
# command).
mig_dir=/usr/share/omarchy/migrations
bin_dirs=(/usr/bin /usr/share/omarchy/bin)
pending=("$@")
before=$#   # the first $before names are the runner's: migrations pending from before this update
if [[ -n ${after[omarchy]-} ]]; then
  download omarchy
  file=$(cached omarchy) || finish 8 "omarchy's package file is not in pacman's cache"
  # The members wanted, from the package's own list, read through a pipe whose status is checked (bsdtar -t exits 0 even
  # when it cannot write its list), every write of the member file checked: a folder the package lacks is no error.
  # bsdtar's -T reads patterns, so a name is taken only in a charset with no pattern character (no * ? [ ] \); any other
  # name there fails closed, as a migration omarchy-migrate would run unscanned.
  : >"$work/.members" || finish 8 "cannot write $work/.members"
  listed=0
  bsdtar -tf "$file" 9<&- | while IFS= read -r member; do
    listed=$((listed + 1))
    [[ $member =~ ^(usr/share/omarchy/migrations/|usr/share/omarchy/bin/|usr/bin/omarchy-) ]] || continue
    tail=${member#"${BASH_REMATCH[1]}"}
    [[ -z $tail || $tail == */* ]] && continue   # the folder itself, or deeper
    [[ $member =~ ^[A-Za-z0-9/._+-]+$ ]] ||
      { outcome+=("needs scan"); finish 7 "an Omarchy file name the scan cannot take: nothing was changed"; }
    printf '%s\n' "$member" >>"$work/.members" || finish 8 "cannot write $work/.members"
  done
  ((PIPESTATUS[0] == 0 && listed > 0)) || finish 8 "cannot read omarchy's package"
  if [[ -s $work/.members ]]; then
    bsdtar -xf "$file" -C "$work" --no-same-owner --no-same-permissions -T "$work/.members" 9<&- ||
      finish 8 "cannot read omarchy's package"
  fi
  # Omarchy always ships its migrations: a package without one cannot be scanned against what it brings.
  [[ -n $(find "$work/usr/share/omarchy/migrations" -maxdepth 1 \( -type f -o -type l \) -name '*.sh' -print -quit 2>/dev/null) ]] ||
    { outcome+=("needs scan"); finish 7 "the new omarchy package has no migration to read: Omarchy's terminal update runs it"; }
  mig_dir=$work/usr/share/omarchy/migrations
  bin_dirs=("$work/usr/bin" "$work/usr/share/omarchy/bin")
  declare -A had=()
  while IFS= read -r path; do
    [[ $path == /usr/share/omarchy/migrations/*.sh ]] && had[${path##*/}]=1
  done < <(pacman -Qlq omarchy 2>/dev/null 9<&-)
  while IFS= read -r path; do
    name=${path##*/}
    [[ -n ${had[$name]-} ]] && continue
    # omarchy-migrate runs every *.sh: one with another name would run unscanned, so it fails closed.
    [[ $name =~ ^[0-9]{1,20}\.sh$ ]] || { outcome+=("needs scan"); finish 7 "an Omarchy migration name the scan cannot take: $name"; }
    pending+=("$name")
  done < <(find "$mig_dir" -maxdepth 1 \( -type f -o -type l \) -name '*.sh' 2>/dev/null)
fi
migrate_here=0
if ((${#pending[@]})); then
  # The commands that reach the words, until the set stops growing: a command whose text matches, and any command that
  # names one of them. Comments count: the scan is conservative. Two sets: what needs a person (pkexec, su, run0, doas, gum,
  # /dev/tty, a sudo by its path), and what needs root (sudo, Omarchy's own requires-sudo header).
  # Without one command file to read, the scan would find nothing: it fails closed.
  [[ -n $(find "${bin_dirs[@]}" -maxdepth 1 -type f -name 'omarchy-*' -print -quit 2>/dev/null) ]] ||
    { outcome+=("needs scan"); finish 7 "no Omarchy command file to scan: Omarchy's terminal update runs the migrations"; }
  reach() { # words extra -> the words and the names of the commands that reach them, as one alternation
    local words=$1 extra=$2 pattern grew path name
    local -A hit=()
    while :; do
      pattern="(^|[^[:alnum:]_.-])($words)([^[:alnum:]_.-]|\$)|$extra"
      grew=0
      while IFS= read -r path; do
        name=${path##*/}
        [[ $name =~ ^omarchy-[a-z0-9-]+$ && -z ${hit[$name]-} ]] || continue
        hit[$name]=1
        words+="|$name"
        grew=1
      done < <(find "${bin_dirs[@]}" -maxdepth 1 -type f -name 'omarchy-*' -exec grep -lE -- "$pattern" {} + 2>/dev/null)
      ((grew)) || break
    done
    printf '%s\n' "$words"
  }
  person_words=$(reach "$GU_PERSON_WORDS" "$GU_PERSON_EXTRA") || finish 8 "the scan failed"
  root_words=$(reach "$GU_ROOT_WORDS" 'omarchy:requires-sudo=true') || finish 8 "the scan failed"
  user_words=$(reach "$GU_USER_WORDS" "$GU_USER_EXTRA") || finish 8 "the scan failed"
  person_pattern="(^|[^[:alnum:]_.-])($person_words)([^[:alnum:]_.-]|\$)|$GU_PERSON_EXTRA"
  root_pattern="(^|[^[:alnum:]_.-])($root_words)([^[:alnum:]_.-]|\$)"
  user_pattern="(^|[^[:alnum:]_.-])($user_words)([^[:alnum:]_.-]|\$)|$GU_USER_EXTRA"
  declare -A seen=()
  needs=() rooted=() usercode=()
  for name in "${pending[@]}"; do
    [[ -n ${seen[$name]-} ]] && continue
    seen[$name]=1
    path=$mig_dir/$name
    [[ -e $path || -L $path ]] || continue   # gone from the new package: it never runs
    # A migration that is not a regular file cannot be read here: it fails closed.
    if [[ ! -f $path || -L $path ]] || grep -qE -- "$person_pattern" "$path"; then
      needs+=("$name")
    elif grep -qE -- "$root_pattern" "$path"; then
      rooted+=("$name")
    fi
    # R7-SEC-01: rooted or not, it would run in the unit with the others. A file grep cannot read counts (fails closed).
    grep -qE -- "$user_pattern" "$path"
    (($? == 1)) || usercode+=("$name")
  done
  if ((${#needs[@]})); then
    for name in "${needs[@]}" "${rooted[@]}"; do outcome+=("needs migration ${name%.sh}"); done
    finish 7 "Omarchy's migrations ${needs[*]} need a person: Omarchy's terminal update runs them"
  fi
  # s5 (SU-M2): migrations that need root run here, after the transaction, as the person, with their sudo commands as root.
  # Only in grassfield-update.service; for a person of uid 1000 or more who is an administrator (wheel: the grant is an
  # administrator's sudo, never more than that person has in Omarchy's terminal; the step 5 review's BLOCKER); when no
  # migration from before this update is pending (the unit runs this update's own migrations, by name); with the unit's own
  # group in place; and once the whole channel answered a trial `sudo true` through it (the unit, the polkit rule,
  # systemd). Otherwise Omarchy's terminal, as before: nothing changed yet.
  if ((${#rooted[@]})); then
    why="" caller_name="" caller_gid=""
    if [[ $caller_uid != - ]]; then
      IFS=: read -r caller_name _ _ caller_gid _ < <(getent passwd "$caller_uid" 2>/dev/null 9<&-)
    fi
    IFS=: read -r _ _ migrate_gid migrate_members < <(getent group "$GU_MIGRATE_GROUP" 2>/dev/null 9<&-)
    # Nor a password newgrp would take (sysusers locks it: "!*").
    IFS=: read -r _ migrate_password _ < <(getent gshadow "$GU_MIGRATE_GROUP" 2>/dev/null 9<&-)
    if ! in_unit; then
      why="no systemd unit for this run"
    elif ((${#usercode[@]})); then
      why="${usercode[*]} would run code the person can change: a hook, an interpreter or a tool that reads the home folder"
    elif [[ ! $caller_name =~ ^[a-z_][a-z0-9_-]{0,31}\$?$ || ! $caller_gid =~ ^[0-9]{1,10}$ ]]; then
      why="no person to run them as"
    elif ! id -Gn -- "$caller_name" 2>/dev/null 9<&- | tr ' ' '\n' | grep -qx -- "$GU_ADMIN_GROUP"; then
      why="$caller_name is not an administrator ($GU_ADMIN_GROUP)"
    elif ((before > 0)); then
      why="migrations from before this update are pending"
    elif [[ ! ${migrate_gid-} =~ ^[0-9]{1,10}$ || -n ${migrate_members-} || $migrate_gid == "$caller_gid" ||
      ! ${migrate_password-} =~ ^(!.*|\*)$ ]]; then
      why="the group $GU_MIGRATE_GROUP is missing, has members or a password, or is the person's own"
    elif [[ ! -f $GU_RULE || -L $GU_RULE || ! -x $GU_SUDO_DIR/sudo || -L $GU_SUDO_DIR/sudo ]]; then
      why="Grassfield's sudo for migrations is not installed"
    elif ! root_alone /usr/share/omarchy/migrations || ! root_alone /usr/share/omarchy/bin || ! root_alone "$GU_SUDO_DIR/sudo"; then
      why="Omarchy's migrations or commands folder, or Grassfield's sudo, is not root's alone"
    elif ! migrate_unit "$GU_SUDO_DIR/sudo" -n /usr/bin/true; then
      why="the trial sudo through the migrations' unit failed"
    fi
    if [[ -n $why ]]; then
      for name in "${rooted[@]}"; do outcome+=("needs migration ${name%.sh}"); done
      finish 7 "Omarchy's migrations ${rooted[*]} need root, which this run cannot give them ($why): Omarchy's terminal update runs them"
    fi
    migrate_here=1
    say "migrations that need root, run after the transaction with their sudo commands as root (SU-M2): ${rooted[*]}"
  fi
  say "migrations pending after this update, none needs a person: ${!seen[*]}"
fi

# --- From here, the system changes (s3.3) -------------------------------------------------------------------------------
changing=1
# Sleep, idle and shutdown wait (omarchy-update-stay-awake) for as long as this process lives: the inhibitor's command
# ends with it, whatever ends it. A failure (no logind) is no reason to stop.
systemd-inhibit --what=sleep:idle:shutdown --who="Grassfield Software Update" --why="Updating this computer" \
  --mode=block tail --pid=$$ -f /dev/null >/dev/null 2>&1 9<&- &
inhibitor=$!

progress snapshot
# omarchy-update-pkg-prune, before the snapshot (the cache is on the snapshotted subvolume).
if [[ -x /usr/bin/paccache ]]; then
  paccache -rk2 9<&- || say "could not prune the package cache"
fi
# omarchy-snapshot create: every snapper configuration; none, unconfigured or failed, the update goes on.
snapshot=none
if [[ -x /usr/bin/snapper ]]; then
  desc=unknown
  [[ -f /usr/share/omarchy/version ]] && read -r desc </usr/share/omarchy/version
  [[ $desc =~ ^[A-Za-z0-9\ ._+:-]{1,64}$ ]] || desc=unknown
  mapfile -t configs < <(snapper --csvout list-configs 2>/dev/null 9<&- | awk -F, 'NR > 1 { print $1 }')
  for config in "${configs[@]}"; do
    [[ $config =~ ^[A-Za-z0-9_-]+$ ]] || continue
    if snapper -c "$config" create -c number -d "$desc" 9<&-; then
      [[ $snapshot == none ]] && snapshot=made
      snapper -c "$config" cleanup number 9<&- || say "snapper could not clean up $config"
    else
      snapshot=failed
    fi
  done
  ((${#configs[@]})) || say "no snapper configuration: no snapshot"
fi
outcome+=("snapshot $snapshot")
say "snapshot: $snapshot"

# The databases checked become the system's: the transaction installs what was checked, never a newer plan. Under pacman's
# own lock (db.lck made here, exclusively, as libalpm makes it), so no pacman reads half of them.
no_db_lock
(set -C && : >"$dbpath/db.lck") 2>/dev/null || finish 3 "pacman started meanwhile ($dbpath/db.lck)"
own_db_lock=$dbpath/db.lck
outcome+=("synced")
for repo in "${repos[@]}"; do
  for ext in db db.sig; do
    src=$tmpdb/sync/$repo.$ext
    dst=$dbpath/sync/$repo.$ext
    if [[ -f $src && ! -L $src ]]; then
      cp -p -- "$src" "$dbpath/sync/.$repo.$ext.gu" && mv -f -- "$dbpath/sync/.$repo.$ext.gu" "$dst" ||
        finish 8 "cannot replace $dst"
    elif [[ $ext == db.sig ]]; then
      rm -f -- "$dst"
    fi
  done
done
rm -f -- "$own_db_lock" && own_db_lock=""

# pacman, its output appended to the log up to the log's cap and, when `report` is 1, read for the progress; its exit
# code. `downloads`: how many files the plan still has to download. `started`: pacman began changing packages.
started=0
pacman_run() { # report downloads pacman-argument...
  local report=$1 downloads=$2 got=0 done=0 total=0 used line
  shift 2
  used=$(stat -c %s -- "$log" 2>/dev/null || echo "$GU_LOG_MAX")
  env LC_ALL=C OMARCHY_UPDATE_PACMAN=1 pacman "$@" 2>&1 9<&- | while IFS= read -r line; do
    if ((used < GU_LOG_MAX - 65536)); then
      printf '%s\n' "$line"
      used=$((used + ${#line} + 1))
    fi
    case $line in
      ' '*' downloading...')
        got=$((got + 1))
        ((report && got <= downloads)) && progress downloading "$got" "$downloads"
        ;;
      'Packages ('*')'*)
        total=${line#Packages (}
        total=${total%%)*}
        [[ $total =~ ^[0-9]+$ ]] || total=0
        ;;
      ':: Processing package changes...')
        started=1
        ((report)) && progress installing 0 "$total"
        ;;
      'installing '*... | 'upgrading '*... | 'reinstalling '*... | 'downgrading '*... | 'removing '*...)
        done=$((done + 1))
        ((report && done <= total)) && progress installing "$done" "$total"
        ;;
      ':: Running post-transaction hooks...')
        ((report)) && progress finishing
        ;;
    esac
  done
  return "${PIPESTATUS[0]}"
}

# omarchy-update-keyring: the signing keyrings first, when a newer one is out (`--needed`, Omarchy 4.0.6's form: new or
# revoked keys come as a new version). Omarchy 4.5.0 refreshes omarchy-keyring beside archlinux-keyring: the same here, each
# one only when installed (anything else has no such package). Not ported: the Arch Linux ARM keyring and the platform
# keyrings Omarchy 4.5.0 reads from /usr/share/omarchy-platform/keyrings, which belong to the ARM platforms (Grassfield is
# x86_64 only); a failed refresh of any keyring stops the update before the transaction, as Omarchy's set -e does.
keyrings=()
for pkg in archlinux-keyring omarchy-keyring; do
  [[ -n ${installed[$pkg]-} ]] && keyrings+=("$pkg")
done
if ((${#keyrings[@]})); then
  progress keyring
  no_db_lock
  pacman_run 0 0 -S --needed --noconfirm --noprogressbar "${keyrings[@]}" || finish 8 "the signing keyrings (${keyrings[*]}) could not be updated"
  started=0
fi

# omarchy-update-system-pkgs, without -y: the databases are the ones checked. OMARCHY_UPDATE_PACMAN=1 is what
# omarchy-update-pacman-guard, Omarchy's pre-transaction hook, accepts from Omarchy's own update.
downloads=0
for pkg in "${!after[@]}"; do
  cached "$pkg" >/dev/null || downloads=$((downloads + 1))
done
if ((downloads)); then
  progress downloading 0 "$downloads"
else
  progress installing 0 0
fi
no_db_lock
say "pacman -Su --noconfirm --noprogressbar --overwrite /usr/share/omarchy/*"
pacman_run 1 "$downloads" -Su --noconfirm --noprogressbar --overwrite '/usr/share/omarchy/*'
code=$?
if ((code != 0)); then
  # omarchy-update-system-pkgs-when-conflicted's two cases (a package conflict, files no package owns) are a person's
  # call there: here pacman stopped before changing a package, and Omarchy's terminal update takes it from there.
  if grep -q 'unresolvable package conflicts detected\|exists in filesystem' -- "$log"; then
    ((started)) || { outcome+=("needs conflict"); finish 7 "pacman needs an answer: nothing was installed"; }
  fi
  ((started)) || finish 8 "pacman stopped before installing anything ($code)"
  finish 1 "pacman exited with $code during the transaction"
fi
outcome+=("packages $count")

# --- After it (s3.2 step 11, s3.7) --------------------------------------------------------------------------------------
progress finishing
# s5 (SU-M2): Omarchy's migrations, as Omarchy's update runs them after its transaction; before the log is read below, which
# then covers their output too. A failure leaves the failed one and those after it pending: the runner sees them.
if ((migrate_here)); then
  mapfile -t ordered < <(printf '%s\n' "${!seen[@]}" | sort)
  # The installed migrations, as the transaction left them: each a regular file, root's alone (MINOR 2), and Omarchy's
  # commands folder, which they call inside the unit (follow-up 2). Otherwise none runs here; the runner then runs them
  # without root, and what needs it stays pending for Omarchy's terminal.
  if ! root_alone /usr/share/omarchy/bin; then
    say "/usr/share/omarchy/bin is not root's alone: no migration runs with root"
    migrate_here=0
  fi
  ((migrate_here)) && for name in "${ordered[@]}"; do
    path=/usr/share/omarchy/migrations/$name
    [[ -e $path || -L $path ]] || continue
    if [[ ! -f $path || -L $path ]] || ! root_alone "$path"; then
      say "$path is not root's alone: no migration runs with root"
      migrate_here=0
      break
    fi
  done
fi
if ((migrate_here)); then
  say "Omarchy's migrations of this update as $caller_name, their sudo commands as root (SU-M2): ${ordered[*]}"
  migrate_unit /usr/bin/bash -c "$GU_MIGRATE_LOOP" grassfield-migrate "${ordered[@]}" ||
    say "a migration failed: it stays pending, Omarchy's terminal update finishes it"
  wait_root_units
  outcome+=("migrations ran")
  # Their output, root's alone (it holds the root commands' output too), at most the log's cap.
  size=$(stat -c %s -- "$migrations" 2>/dev/null || echo 0)
  ((size <= GU_LOG_MAX)) || truncate -s "$GU_LOG_MAX" -- "$migrations"
  say "the migrations' output: $migrations"
  # A migration may run pacman itself (Omarchy 4.0.6's 1791403252 runs omarchy-update-system-pkgs): what it changed of the
  # packages s3.4 and s3.7 follow is read again, for the end's restart, and logged when the record does not match.
  declare -A now=()
  while read -r name version; do now[$name]=$version; done < <(pacman -Q -- "${GU_TRACKED[@]}" grassfield-desktop 2>/dev/null 9<&-)
  for pkg in "${GU_TRACKED[@]}" grassfield-desktop; do
    expected=${after[$pkg]-${installed[$pkg]-}}
    [[ ${now[$pkg]-} == "$expected" ]] && continue
    say "a migration changed $pkg: ${expected:-none} -> ${now[$pkg]:-none} (not checked against the record)"
    after[$pkg]=${now[$pkg]:-removed}
  done
fi
# omarchy-update-analyze-logs, on this run's log and the migrations' output.
logs=("$log")
((migrate_here)) && logs+=("$migrations")
if grep -q 'Updating linux initcpios' -- "${logs[@]}" && ! grep -q 'Initcpio image generation successful' -- "${logs[@]}"; then
  outcome+=("bootimage failed")
fi
# omarchy-update-restart's kernel rule: no package's kernel under /usr/lib/modules is the running one. Omarchy 4.0.6 looks at
# each kernel's vmlinuz, 4.5.0 at its modules.builtin (every kernel package owns it; Arch Linux ARM's ships no vmlinuz):
# either file, owned by a package, in the running kernel's folder counts, which gives the rule of both versions.
running=$(uname -r)
kernel_updated=1
for kernel in /usr/lib/modules/*/modules.builtin /usr/lib/modules/*/vmlinuz; do
  if [[ -f $kernel ]] && pacman -Qo -- "$kernel" >/dev/null 2>&1 9<&-; then
    release=${kernel%/*}
    if [[ ${release##*/} == "$running" ]]; then
      kernel_updated=0
      break
    fi
  fi
done
((kernel_updated)) && outcome+=("restart kernel")
[[ -n ${after[hyprland]-} ]] && outcome+=("restart hyprland")
for pkg in "${GU_TOOLKIT[@]}"; do
  if [[ -n ${after[$pkg]-} ]]; then
    outcome+=("restart toolkit")
    break
  fi
done
[[ -n ${after[grassfield-desktop]-} ]] && outcome+=("logout grassfield")
finish 0 "done"
