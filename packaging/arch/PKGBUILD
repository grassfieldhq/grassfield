# The source tree every step reads: the snapshot of HEAD made by prepare(), never the live working tree.
_root() { echo "$srcdir/snapshot"; }
# _no_hidden <dir>: fails, naming them, when <dir> holds a file or directory whose name starts with a dot.
_no_hidden() {
  local found
  found=$(find "$1" -mindepth 1 -name '.*' -print | head -n 5)
  [[ -z $found ]] && return 0
  echo "PKGBUILD: hidden paths refused in $1: $found" >&2
  return 1
}

prepare() {
  local repo
  repo=$(git -C "$startdir" rev-parse --show-toplevel)
  # Nothing a previous `makepkg` run left may survive: `git archive` gives every file the commit's time, so a build directory
  # of another commit with the same VERSION would answer "no work to do" and ship that commit's plugin and libraries under
  # this commit's BUILD-COMMIT. Every build and output directory goes, and the files are extracted with the time of now (tar -m).
  # ${srcdir:?}: an empty $srcdir must stop here, never turn these into paths at the root.
  rm -rf "${srcdir:?}/snapshot" "${srcdir:?}"/*-build "${srcdir:?}/compositor-out" "${srcdir:?}/icons" "${srcdir:?}/grassfield-icons" "${srcdir:?}/plymouth-grassfield" "${srcdir:?}/grassfield.db" "${srcdir:?}/BUILD-COMMIT" "${srcdir:?}/BUILD-DEPS" "${srcdir:?}/pacman"
  mkdir -p "$srcdir/snapshot"
  git -C "$repo" archive --format=tar HEAD | tar -x -m -C "$srcdir/snapshot"
  git -C "$repo" rev-parse HEAD >"$srcdir/BUILD-COMMIT"
  # BUILD-DEPS (ADR-0033 s3.4): the versions of the toolkit this build compiles and runs against, one `<name> <version>`
  # per line, read by grassfield-update-helper's compatibility check before an update changes one of them. All of them or
  # no build: a record that lacks one refuses every update of it.
  if ! pacman -Q qt6-base quickshell hyprland aquamarine kcoreaddons >"$srcdir/BUILD-DEPS"; then
    echo "PKGBUILD: the build environment lacks a package BUILD-DEPS records (qt6-base quickshell hyprland aquamarine kcoreaddons)" >&2
    return 1
  fi
  if [[ $(tr -d '[:space:]' <"$srcdir/snapshot/VERSION") != "$_ver" ]]; then
    echo "PKGBUILD: VERSION of HEAD ($(<"$srcdir/snapshot/VERSION")) is not the VERSION this PKGBUILD read ($_ver): commit it first" >&2
    return 1
  fi
  if [[ -n $(git -C "$repo" status --porcelain) ]]; then
    echo "PKGBUILD: WARNING: uncommitted changes are NOT in this package (it is built from HEAD $(<"$srcdir/BUILD-COMMIT"))" >&2
  fi
}

build() {
  # The plugin, its stamp and its unit tests go to $srcdir/compositor-out (never the tree's compositor/build, which
  # just plugin-build also writes): package() ships exactly what this build made.
  cmake -S "$(_root)/compositor" -B "$srcdir/compositor-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo -DGRASSFIELD_BUILD_TESTS=ON -DGRASSFIELD_OUTPUT_DIR="$srcdir/compositor-out"
  cmake --build "$srcdir/compositor-build"
  # Grassfield.I18n QML module (Translator singleton) and the compiled catalogs (translations/*.ts).
  cmake -S "$(_root)/ui/i18n" -B "$srcdir/i18n-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/i18n-build"
  cmake -S "$(_root)/apps/settings" -B "$srcdir/settings-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/settings-build"
  # grassfield-wallpaper (ADR-0016): the one-shot helper that parses wallpaper pictures for the shell and Settings.
  cmake -S "$(_root)/apps/wallpaper-tool" -B "$srcdir/wallpaper-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/wallpaper-build"
  # The wallpaper photographs (ADR-0040 step 2c): each no wider than 5120 px, JPEG quality 90, no metadata, by the build-only
  # tool just built (it writes atomically and stops the build on a picture it cannot read or write).
  mkdir -p "$srcdir/photos"
  local id
  for id in "${GF_PHOTO_IDS[@]}"; do
    LC_ALL=C.UTF-8 "$srcdir/wallpaper-build/grassfield-wallpaper-shrink" --width 5120 --quality 90 \
      --out "$srcdir/photos/$id.jpg" -- "$srcdir/photo-$id.jpg" >/dev/null
  done
  # grassfield-stack-helper (ADR-0025): lists, orders and watches one Dock stack folder.
  cmake -S "$(_root)/apps/stack-helper" -B "$srcdir/stack-helper-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/stack-helper-build"
  # grassfield-clipboard-helper (ADR-0034): the clipboard history's capture and store (ext-data-control-v1, lock notifier).
  cmake -S "$(_root)/apps/clipboard-helper" -B "$srcdir/clipboard-helper-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/clipboard-helper-build"
  # grassfield-secrets-handover (ADR-0035 D-12): the session's one-time Secret Service handover from KWallet to the keychain.
  cmake -S "$(_root)/apps/secrets-handover" -B "$srcdir/secrets-handover-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/secrets-handover-build"
  # grassfield-portal-settings (ADR-0035 D-8): the Settings portal backend (appearance and accent for other toolkits).
  cmake -S "$(_root)/apps/portal-settings" -B "$srcdir/portal-settings-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/portal-settings-build"
  # The 36 Grassfield GTK themes (ADR-0035 D-8, owner decision Q7, decision 2b-2), generated from the tokens.
  rm -rf "$srcdir/gtk-themes"
  python3 -I "$(_root)/ui/tools/gen-gtk-themes.py" "$srcdir/gtk-themes"
  cmake -S "$(_root)/apps/files" -B "$srcdir/files-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/files-build"
  # grassfield-portal (ADR-0035 D-4): the Open and Save panels, the Files library and Files' QML (installed by files-build).
  cmake -S "$(_root)/apps/portal" -B "$srcdir/portal-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/portal-build"
  cmake -S "$(_root)/apps/preview" -B "$srcdir/preview-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/preview-build"
  # Activity Monitor (ADR-0038): the app, its QML, its desktop entry and its icon; packaged in grassfield-desktop (AD2).
  cmake -S "$(_root)/apps/activity" -B "$srcdir/activity-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/activity-build"
  # Grassfield Memos (ADR-0051): the app, its QML, its desktop entry and its icon; packaged in grassfield-desktop.
  cmake -S "$(_root)/apps/memos" -B "$srcdir/memos-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/memos-build"
  # Grassfield Store (ADR-0037): the app, its QML, its root helper and polkit policy; packaged as grassfield-store.
  cmake -S "$(_root)/apps/store" -B "$srcdir/store-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build "$srcdir/store-build"
  # grassfield-menu-bridge (ADR-0008): global menus, systemd user unit, D-Bus diagnostics XML.
  cmake -S "$(_root)/bridges/menu-bridge" -B "$srcdir/menu-bridge-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DGRASSFIELD_BUILD_TESTS=ON
  cmake --build "$srcdir/menu-bridge-build"
  # grassfield-prompter (ADR-0035 D-9): gcr's system prompter for the session, the shell draws the prompts, and its
  # NetworkManager secret agent (step 9c); its user unit; grassfield-askpass, udiskie's password command (step 9c).
  cmake -S "$(_root)/bridges/prompter" -B "$srcdir/prompter-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DGRASSFIELD_BUILD_TESTS=ON
  cmake --build "$srcdir/prompter-build"
  # Grassfield cursors (ADR-0014): hyprcursor SVG theme + XCursor fallback from branding/cursors.
  "$(_root)/branding/cursors/build.sh" --out "$srcdir/icons"
  # grassfield-icons (ADR-0017): compose the theme into a scratch directory; the composer fails on pin drift (a listed
  # file missing) and when a listed logo, a dangling link or a forbidden word remains.
  python3 -I "$(_root)/packaging/arch/icons-compose.py" --mactahoe "$srcdir/mactahoe-icon-theme" --pebble "$srcdir/pebble-icon-theme" \
    --branding "$(_root)/branding/icons/theme" --list "$(_root)/packaging/arch/icons-apple-logos.txt" --out "$srcdir/grassfield-icons"
  # Login and boot themes (ADR-0042): the Plymouth theme's images rendered from SVG (rsvg-convert); the SDDM theme is QML only.
  "$(_root)/packaging/plymouth/build.sh" --out "$srcdir/plymouth-grassfield"
  # Software Update (ADR-0033): the [grassfield] section templates, this build's repository values and its pinned key,
  # checked (the key file must be the pinned fingerprint, public only) and generated from packaging/pacman/repository.conf.
  python3 -I "$(_root)/packaging/pacman/generate.py" --conf "$(_root)/packaging/pacman/repository.conf" \
    --key "$(_root)/packaging/pacman/grassfield-signing-key.asc" --out "$srcdir/pacman"
}

check() {
  "$srcdir/compositor-out/grassfield-compositor-tests"
  # The peer-to-peer D-Bus case skips itself where Unix sockets cannot be created (build sandboxes).
  "$srcdir/menu-bridge-build/menu-bridge-unit-tests"
  # The prompter's logic and its GcrPrompt object (no bus; the socket-pair case skips itself without a cgroup of its own).
  "$srcdir/prompter-build/prompter-unit-tests"
}

package_grassfield-desktop() {
  pkgdesc+=" — shell, design system, session"
  # python, librsvg (rsvg-convert) and hyprcursor (hyprcursor-util) are RUNTIME dependencies (owner decision 2026-10-19):
  # the shell runs /usr/share/grassfield/cursors/build.sh to regenerate the cursor theme for the pointer colours
  # (Settings > Accessibility > Pointer, ADR-0014) into $XDG_DATA_HOME/icons/grassfield-cursors-custom.
  # inotify-tools (inotifywait): the applications directories are watched by shell/launchpad/watch-applications.sh; without it the
  # Launchpad falls back to slow polling or to the shell's own signals. The Dock's stack folders are watched by the native
  # grassfield-stack-helper (ADR-0025), which needs nothing beyond Qt.
  # networkmanager and bluez-utils (which pulls bluez) are the D-Bus services the Settings Wi-Fi and Bluetooth pages talk to (GF-049:
  # Settings no longer runs nmcli or bluetoothctl; the packages stay declared because the services must be installed), wireplumber
  # (wpctl, the Sound page) and wl-clipboard (wl-copy) are used by Settings and the shell (ARCH-08): declared, not assumed to come
  # with Omarchy. grim and slurp take Grassfield's screenshots (packaging/bin/grassfield-capture, ADR-0035 D-10, step 8): declared
  # too, now that Grassfield runs them itself. pipewire (pw-play, pw-dump) plays the sound effects and reads the outputs'
  # devices for the automatic routing (ADR-0047).
  # Software Update (ADR-0033): grassfield-keyring (O12: the keys pacman trusts for [grassfield], built and published beside
  # these packages by grassfieldhq/grassfield-packages, as omarchy depends on omarchy-keyring; added once that repository
  # built it, owner decision O21), pacman-contrib (checkupdates) and fakeroot (the checker's [grassfield]-only sync),
  # declared as omarchy declares them. Until [grassfield] is published, a local `makepkg -si` needs grassfield-keyring
  # installed first (docs/owner-setup/real-session.md, section 3).
  # gnome-keyring is the session's only Secret Service (ADR-0035 D-12, Q17-b: packaging/xdg-config/kwalletrc keeps KWallet's
  # ksecretd off org.freedesktop.secrets), so libsecret clients such as Chromium keep a keychain instead of plain-text storage:
  # declared, not assumed to come with Omarchy.
  # xdg-desktop-portal and xdg-desktop-portal-gtk: the session routes Settings to grassfield-portal-settings, then to gtk for
  # the keys it does not own, and GTK 3 apps read their theme through the portal (GTK_USE_PORTAL=1, ADR-0035 D-8): declared,
  # not assumed to come with Omarchy.
  # libcups: grassfield-portal's print sheet asks CUPS for the printers and sends the jobs (ADR-0035 D-7, owner decision Q6);
  # already there with qt6-base and gtk3, declared since the backend links it.
  # gcr-4: libgcr-4, which grassfield-prompter links for gcr's system prompter protocol and its exchange (ADR-0035 D-9);
  # already installed with gnome-keyring (probe P15), declared because Grassfield's own binary needs it. libsecret: the
  # bridge's KIO password server keeps remembered network passwords in the Secret Service with it (ADR-0035 D-12 b, step
  # 9e); already installed with gcr-4, declared for the same reason.
  depends=(hyprland uwsm quickshell qt6-declarative qt6-wayland wayland qt6-svg inter-font kio solid kcoreaddons kservice kwindowsystem qt6-multimedia qt6-imageformats qt6-webengine ffmpeg curl python librsvg hyprcursor breeze-icons grassfield-icons grassfield-wallpapers networkmanager bluez-utils wireplumber pipewire wl-clipboard grim slurp grassfield-keyring pacman-contrib fakeroot gnome-keyring xdg-desktop-portal xdg-desktop-portal-gtk libcups gcr-4 libsecret)
  # Quickshell's v0.3.2 tag lets a session lock the compositor drops go unnoticed (WlSessionLock::unlock() never emits,
  # fixed upstream in 18c95fae, shipped from 0.3.2.r7): the lock would not be taken again (fail-open). That exact version is
  # refused; 0.3.1 and the 0.3.2 snapshots from r7 on are not matched by `=0.3.2`.
  conflicts=('quickshell=0.3.2')
  # Own code MIT; own art (symbolic icons, cursor templates) CC-BY-SA-4.0, except the Grassfield logo (branding/icons/symbolic/grassfield-logo*.svg:
  # all rights reserved, the owner's mark, owner decision 2026-10-27: LicenseRef-Grassfield-logo-all-rights-reserved); Unicode-derived grapheme tables Unicode-3.0; the
  # clipboard helper's code generated from hyprland-lock-notify-v1.xml BSD-3-Clause (packaging/licenses/clipboard-protocols-notices.txt).
  license=(MIT CC-BY-SA-4.0 Unicode-3.0 BSD-3-Clause LicenseRef-Grassfield-logo-all-rights-reserved)
  optdepends=(
    'grassfield-compositor: titlebars with traffic lights, minimize, global menu protocol'
    'brightnessctl: display brightness OSD and Quick Settings slider'
    'localsearch: file results in Search'
    'plocate: file names in Search when localsearch has no index (ADR-0027)'
    'kio-extras: network locations and image thumbnails in Files'
    'libnotify: notices from the session helpers (log out blocked by an open document, crash, low battery, a screenshot and its Open in Preview)'
    'udiskie: mounts removable media when they are connected'
    'hyprsunset: Night Light (grassfield-nightshift)'
    'kimageformats: HEIF, AVIF and JPEG XL pictures as wallpapers (the helper reads what Qt can read)'
  )
  # Login screen entry and a login-path check after install and upgrade (GF-015); the SDDM drop-in is a config file.
  install=grassfield-desktop.install
  backup=(etc/sddm.conf.d/grassfield.conf)
  local root
  root=$(_root)

  install -d "$pkgdir/usr/share/grassfield"
  cp -a --no-preserve=ownership "$root/shell" "$pkgdir/usr/share/grassfield/shell"
  find "$pkgdir/usr/share/grassfield/shell" \( -name '.qmlls.ini' -o -name '*.qmlc' \) -delete
  # No hidden path ships in a QML root: QML loads one by name (Loader { source: ".x.qml" }) and a glob-based lint skips it
  # (tests/security/ipc_inventory.sh and tests/ci/import_graph.py refuse them in the tree; this refuses them in the package).
  _no_hidden "$pkgdir/usr/share/grassfield/shell" || return 1

  # Design system as a regular QML module; icons copied into the module (repo symlink resolved).
  install -d "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui"
  cp -a --no-preserve=ownership "$root/ui/Grassfield/Ui/." "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/"
  _no_hidden "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui" || return 1
  rm -f "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/icons"
  install -d "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/icons"
  install -m644 "$root"/branding/icons/symbolic/*.svg "$pkgdir/usr/lib/qt6/qml/Grassfield/Ui/icons/"
  # The Qt Quick Controls style "Grassfield" (module Grassfield, next to Grassfield.Ui): selected by Grassfield's own apps only.
  install -m644 "$root/ui/Grassfield/qmldir" "$root"/ui/Grassfield/*.qml "$pkgdir/usr/lib/qt6/qml/Grassfield/"

  # Grassfield.I18n -> /usr/lib/qt6/qml/Grassfield/I18n; grassfield_<lang>.qm -> /usr/share/grassfield/translations.
  DESTDIR="$pkgdir" cmake --install "$srcdir/i18n-build"

  # Compatibility only: the unit loads by path (-p /usr/share/grassfield/shell). Keep this symlink for one release so an old
  # unit still loaded by the user manager can restart; remove it after.
  install -d "$pkgdir/etc/xdg/quickshell"
  ln -s /usr/share/grassfield/shell "$pkgdir/etc/xdg/quickshell/grassfield"

  install -d "$pkgdir/usr/share/grassfield/hypr/grassfield"
  install -m644 "$root/config/hypr/session.lua" "$pkgdir/usr/share/grassfield/hypr/session.lua"
  install -m644 "$root"/config/hypr/grassfield/*.lua "$pkgdir/usr/share/grassfield/hypr/grassfield/"
  install -Dm644 "$root/config/defaults/grassfield.json" "$pkgdir/usr/share/grassfield/defaults/grassfield.json"
  install -Dm644 "$root/config/schema/grassfield.schema.json" "$pkgdir/usr/share/grassfield/schema/grassfield.schema.json"

  install -Dm644 "$root/packaging/wayland-sessions/grassfield.desktop" "$pkgdir/usr/share/wayland-sessions/grassfield.desktop"
  install -Dm644 "$root/packaging/systemd/grassfield-shell.service" "$pkgdir/usr/lib/systemd/user/grassfield-shell.service"
  # Omarchy's sleep-lock unit is skipped inside the Grassfield session only while grassfield-shell runs (D-12: the Omarchy
  # shell it talks to is not running there, and grassfield-shell locks before sleep itself); the gate script decides.
  install -Dm644 "$root/packaging/systemd/omarchy-sleep-lock.service.d/10-grassfield.conf" \
    "$pkgdir/usr/lib/systemd/user/omarchy-sleep-lock.service.d/10-grassfield.conf"
  install -Dm755 "$root/packaging/systemd/sleep-lock-gate" "$pkgdir/usr/lib/grassfield/sleep-lock-gate"
  # The "compositor certainly gone" test the gate and the shell failure counter share (ADR-0041 step 1a); the counter's
  # script comes from packaging/bin below and its unit from the loop further down.
  install -Dm755 "$root/packaging/systemd/session-gone" "$pkgdir/usr/lib/grassfield/session-gone"
  # Session services and helpers that Omarchy's own session provides through its shell or autostart (audit GF-AUDIT-001,
  # 02 §5.3): crash, low-battery and migration notices, removable media, Night Shift, lid, graceful log out / restart /
  # shut down, login choice. All user units skip themselves outside the Grassfield session.
  install -d "$pkgdir/usr/lib/grassfield/omarchy-shims"
  # Regular files only: an ignored __pycache__ or editor directory in the tree must neither break nor enter the package.
  find "$root/packaging/bin" -maxdepth 1 -type f -exec install -m755 -t "$pkgdir/usr/lib/grassfield/" {} +
  # The commands a person types are on PATH (grassfield-report: the diagnostic report a beta tester attaches, ADR-0053).
  install -d "$pkgdir/usr/bin"
  for tool in grassfield-login grassfield-login-check grassfield-nightshift grassfield-channel-set grassfield-report; do
    ln -s "../lib/grassfield/$tool" "$pkgdir/usr/bin/$tool"
  done
  # Software Update (ADR-0033 c and "Step 3"; OPUS SECURITY REVIEW for these root programs): grassfield-channel-helper (the
  # program of the first polkit action below, run by grassfield-channel-set through pkexec), grassfield-update-helper (the
  # second's, run by grassfield-update-run: Update Now, owner decision SU-M1) and grassfield-channel-scriptlet (this
  # package's pre_remove and post_upgrade) over their shared library, the Grassfield code of this package that runs as root;
  # the templates they write /etc/pacman.d/grassfield.conf from; Omarchy's pre-refresh-pacman hook that
  # grassfield-channel-set links. grassfield-channel-set, grassfield-update-check and grassfield-update-run come from
  # packaging/bin above.
  install -m755 -t "$pkgdir/usr/lib/grassfield/" "$root/packaging/pacman/grassfield-channel-helper" \
    "$root/packaging/pacman/grassfield-update-helper" "$root/packaging/pacman/grassfield-channel-scriptlet"
  install -m644 -t "$pkgdir/usr/lib/grassfield/" "$root/packaging/pacman/grassfield-channel.sh"
  install -Dm644 "$root/packaging/pacman/org.grassfield.packages.policy" "$pkgdir/usr/share/polkit-1/actions/org.grassfield.packages.policy"
  # Owner decision SU-M2 (ADR-0033 s5; OPUS SECURITY REVIEW): the sudo of Omarchy's migrations that grassfield-update-helper
  # runs, alone in its folder (the first of their PATH), the polkit rule that lets their unit alone start root units, and
  # that unit's primary group (no member; pacman's sysusers hook creates it).
  install -Dm755 "$root/packaging/pacman/grassfield-update-sudo" "$pkgdir/usr/lib/grassfield/update-sudo/sudo"
  install -Dm644 "$root/packaging/pacman/49-grassfield-update.rules" "$pkgdir/usr/share/polkit-1/rules.d/49-grassfield-update.rules"
  install -Dm644 "$root/packaging/pacman/grassfield-update.sysusers" "$pkgdir/usr/lib/sysusers.d/grassfield-update.conf"
  install -Dm644 -t "$pkgdir/usr/share/grassfield/pacman/" "$srcdir/pacman/repository.conf" "$srcdir/pacman/grassfield-stable.conf" \
    "$srcdir/pacman/grassfield-beta.conf" "$srcdir/pacman/grassfield-stable-cohort.conf" "$srcdir/pacman/grassfield-beta-cohort.conf" \
    "$srcdir/pacman/grassfield-signing-key.asc"
  install -Dm755 "$root/packaging/pacman/pre-refresh-pacman" "$pkgdir/usr/share/grassfield/omarchy-hooks/pre-refresh-pacman"
  # GF-032: stand-ins that keep Omarchy's update, theme and font tools from starting Omarchy's shell in this session.
  find "$root/packaging/shims" -maxdepth 1 -type f -exec install -m755 -t "$pkgdir/usr/lib/grassfield/omarchy-shims/" {} +
  # ADR-0035 D-3: stand-ins for the compositor's own helpers (hyprland-dialog), first in Hyprland's PATH in this session
  # only (config/hypr/session.lua).
  install -d "$pkgdir/usr/lib/grassfield/session-bin"
  find "$root/packaging/session-bin" -maxdepth 1 -type f -exec install -m755 -t "$pkgdir/usr/lib/grassfield/session-bin/" {} +
  install -Dm644 "$root/packaging/sddm/grassfield.conf" "$pkgdir/etc/sddm.conf.d/grassfield.conf"
  # Browsers' traffic lights (owner report on 1.0.0-rc6; config/hypr/grassfield/windows.lua): Omarchy's theme switcher writes
  # the machine policy BrowserThemeColor (color.json) into the Chromium and Google Chrome policy directories, and a colour
  # theme from policy replaces the GTK appearance's window buttons in every profile (nested, Chromium 155: no lights with
  # color.json, the Grassfield lights without it). A later file in the same directory wins (Chromium reads them in name order,
  # the last one deciding) and an empty colour is no theme: the profile's own appearance applies again. Machine-wide, so in
  # the Omarchy session too: there the browsers keep their own theme instead of Omarchy's colour. Root-owned, so Omarchy's
  # policy setup, which removes only files that are not root's, keeps it.
  for policy_dir in etc/chromium/policies/managed etc/opt/chrome/policies/managed; do
    install -d "$pkgdir/$policy_dir"
    printf '{"BrowserThemeColor": ""}\n' >"$pkgdir/$policy_dir/zz-grassfield-gtk.json"
    chmod 644 "$pkgdir/$policy_dir/zz-grassfield-gtk.json"
  done
  install -Dm644 "$root/packaging/sddm/grassfield-login.desktop" "$pkgdir/usr/share/grassfield/sddm/wayland-sessions/grassfield-login.desktop"
  for unit in crash-watch battery-watch migrate-notify automount secrets-handover portal-settings portal shell-failed security pacman-watch shell-watchdog; do
    install -Dm644 "$root/packaging/systemd/grassfield-$unit.service" "$pkgdir/usr/lib/systemd/user/grassfield-$unit.service"
  done
  # ADR-0041 step 2b (U31): the path unit that starts grassfield-pacman-watch.service when pacman's local database changes.
  install -Dm644 "$root/packaging/systemd/grassfield-pacman-watch.path" "$pkgdir/usr/lib/systemd/user/grassfield-pacman-watch.path"
  # ADR-0041 step 6a (SQ-5 A): the timer that starts the shell's liveness probe, grassfield-shell-watchdog.service, every 30 s.
  install -Dm644 "$root/packaging/systemd/grassfield-shell-watchdog.timer" "$pkgdir/usr/lib/systemd/user/grassfield-shell-watchdog.timer"
  # bt-agent (Omarchy's pairing agent that answers bluetoothd without asking): grassfield-prompter is the pairing agent of
  # this session (ADR-0035 D-11, decision 10-1). owed (Omarchy 4.5.0's video wallpaper daemon, package owe): the shell draws
  # the wallpaper in this session.
  for unit in omarchy-crash-watch omarchy-migrate-notify omarchy-update-user-notify bt-agent owed; do
    install -Dm644 "$root/packaging/systemd/$unit.service.d/10-grassfield.conf" \
      "$pkgdir/usr/lib/systemd/user/$unit.service.d/10-grassfield.conf"
  done
  # Menu bridge: /usr/bin/grassfield-menu-bridge, /usr/lib/systemd/user/grassfield-menu-bridge.service,
  # /usr/share/dbus-1/interfaces/org.grassfield.MenuBridge1.xml (started by the session's autostart.lua); ongoing activities
  # (ADR-0052): /usr/share/dbus-1/interfaces/org.grassfield.Ongoing1.xml and /usr/bin/grassfield-ongoing.
  DESTDIR="$pkgdir" cmake --install "$srcdir/menu-bridge-build"
  # grassfield-prompter (ADR-0035 D-9): /usr/lib/grassfield/grassfield-prompter and its user unit
  # /usr/lib/systemd/user/grassfield-prompter.service (started by the session's autostart.lua);
  # /usr/lib/grassfield/grassfield-askpass (run by udiskie in grassfield-automount.service, step 9c).
  DESTDIR="$pkgdir" cmake --install "$srcdir/prompter-build"

  # Grassfield Settings app (M4).
  DESTDIR="$pkgdir" cmake --install "$srcdir/settings-build"
  # grassfield-wallpaper: /usr/lib/grassfield/grassfield-wallpaper (run by the shell and Settings, never by the user).
  DESTDIR="$pkgdir" cmake --install "$srcdir/wallpaper-build"
  # grassfield-stack-helper: /usr/lib/grassfield/grassfield-stack-helper (run by the Dock and the stack popup).
  DESTDIR="$pkgdir" cmake --install "$srcdir/stack-helper-build"
  # grassfield-clipboard-helper: /usr/lib/grassfield/grassfield-clipboard-helper (run by the shell while the history is on).
  DESTDIR="$pkgdir" cmake --install "$srcdir/clipboard-helper-build"
  # grassfield-secrets-handover: /usr/lib/grassfield/grassfield-secrets-handover (run by its user unit, above).
  DESTDIR="$pkgdir" cmake --install "$srcdir/secrets-handover-build"
  # grassfield-portal-settings: /usr/lib/grassfield/grassfield-portal-settings (its user unit, above, and D-Bus activation),
  # the session's portal routing and .portal file (read through env-grassfield's XDG_DATA_DIRS), and its D-Bus service file.
  DESTDIR="$pkgdir" cmake --install "$srcdir/portal-settings-build"
  install -Dm644 "$root/packaging/xdg/xdg-desktop-portal/hyprland-portals.conf" \
    "$pkgdir/usr/share/grassfield/xdg/xdg-desktop-portal/hyprland-portals.conf"
  install -Dm644 "$root/packaging/xdg/xdg-desktop-portal/portals/grassfield-settings.portal" \
    "$pkgdir/usr/share/grassfield/xdg/xdg-desktop-portal/portals/grassfield-settings.portal"
  # The portal frontend starts after the Settings backend in the Grassfield session (its proxy is made once, at its start).
  install -Dm644 "$root/packaging/systemd/xdg-desktop-portal.service.d/10-grassfield.conf" \
    "$pkgdir/usr/lib/systemd/user/xdg-desktop-portal.service.d/10-grassfield.conf"
  install -Dm644 "$root/packaging/dbus/org.freedesktop.impl.portal.desktop.grassfield_settings.service" \
    "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.grassfield_settings.service"
  # grassfield-portal (ADR-0035 D-4): /usr/lib/grassfield/grassfield-portal (D-Bus activation through its unit, above), its
  # .portal file next to the Settings backend's, and its D-Bus service file.
  DESTDIR="$pkgdir" cmake --install "$srcdir/portal-build"
  install -Dm644 "$root/packaging/xdg/xdg-desktop-portal/portals/grassfield.portal" \
    "$pkgdir/usr/share/grassfield/xdg/xdg-desktop-portal/portals/grassfield.portal"
  install -Dm644 "$root/packaging/dbus/org.freedesktop.impl.portal.desktop.grassfield.service" \
    "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.grassfield.service"
  # The GTK themes: /usr/share/themes/Grassfield-<accent>[-hc][-dark] (named by the portal backend for GTK 3 and GTK 4).
  install -dm755 "$pkgdir/usr/share/themes"
  cp -r --no-preserve=ownership "$srcdir/gtk-themes/." "$pkgdir/usr/share/themes/"
  # Grassfield Files (M4, KIO).
  DESTDIR="$pkgdir" cmake --install "$srcdir/files-build"
  # Grassfield Preview and Glance (M4; QtPdf comes from qt6-webengine).
  DESTDIR="$pkgdir" cmake --install "$srcdir/preview-build"
  # Activity Monitor (ADR-0038; no root part, no polkit action).
  DESTDIR="$pkgdir" cmake --install "$srcdir/activity-build"
  # Grassfield Memos (ADR-0051; no root part, no service).
  DESTDIR="$pkgdir" cmake --install "$srcdir/memos-build"
  # The Dock's Apps tile: Grassfield's own drawing (ADR-0040 IQ-B5 C), found through any icon theme's hicolor fallback.
  install -Dm644 "$root/branding/icons/apps/org.grassfield.Apps.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/org.grassfield.Apps.svg"

  # grassfield-cursors: /usr/share/icons/grassfield-cursors/{index.theme,manifest.hl,hyprcursors,cursors}
  install -d "$pkgdir/usr/share/icons"
  cp -a --no-preserve=ownership "$srcdir/icons/grassfield-cursors" "$pkgdir/usr/share/icons/grassfield-cursors"
  install -Dm644 "$root/branding/cursors/build.sh" "$pkgdir/usr/share/grassfield/cursors/build.sh"
  install -Dm644 "$root/branding/cursors/xcursor-pack.py" "$pkgdir/usr/share/grassfield/cursors/xcursor-pack.py"
  install -Dm644 "$root/branding/cursors/cursors.tsv" "$pkgdir/usr/share/grassfield/cursors/cursors.tsv"
  install -d "$pkgdir/usr/share/grassfield/cursors/src"
  install -m644 "$root"/branding/cursors/src/*.svg.in "$pkgdir/usr/share/grassfield/cursors/src/"
  chmod 755 "$pkgdir/usr/share/grassfield/cursors/build.sh"

  # The grassfield sound theme (ADR-0047 B-2): Grassfield's own sounds (branding/sounds, generated and committed) under the
  # freedesktop Sound Theme Specification; bell.wav is the default alert for libcanberra users (the shell plays the chosen one).
  install -Dm644 "$root/branding/sounds/grassfield/index.theme" "$pkgdir/usr/share/sounds/grassfield/index.theme"
  install -d "$pkgdir/usr/share/sounds/grassfield/stereo"
  install -m644 "$root"/branding/sounds/grassfield/stereo/*.wav "$pkgdir/usr/share/sounds/grassfield/stereo/"
  ln -s grassfield-alert-meadow.wav "$pkgdir/usr/share/sounds/grassfield/stereo/bell.wav"

  # The session icon theme grassfield-icons (ADR-0017) is its own package (a dependency): it also carries Grassfield's own
  # generic phone, tablet and media player glyphs under the names of the Apple device pictures of Breeze and Adwaita (E27).
  # Session environment for uwsm (Grassfield desktop name only): Qt icon theme, the GTK dconf profile, the fontconfig file and
  # the session's kwalletrc (read through XDG_CONFIG_DIRS; ADR-0035 Q17-b).
  install -Dm644 "$root/packaging/uwsm/env-grassfield" "$pkgdir/usr/share/uwsm/env-grassfield"
  install -Dm644 "$root/packaging/dconf/profile" "$pkgdir/usr/share/grassfield/dconf/profile"
  install -Dm644 "$root/packaging/dconf/profile-local" "$pkgdir/usr/share/grassfield/dconf/profile-local"
  install -Dm644 "$root/packaging/fontconfig/fonts.conf" "$pkgdir/usr/share/grassfield/fontconfig/fonts.conf"
  install -Dm644 "$root/packaging/xdg-config/kwalletrc" "$pkgdir/usr/share/grassfield/xdg-config/kwalletrc"
  dconf compile "$srcdir/grassfield.db" "$root/packaging/dconf/grassfield.d"
  install -Dm644 "$srcdir/grassfield.db" "$pkgdir/usr/share/grassfield/dconf/grassfield.db"

  # Version and build provenance: the shell's About reads VERSION (a sibling of the shell directory).
  install -Dm644 "$root/VERSION" "$pkgdir/usr/share/grassfield/VERSION"
  install -Dm644 "$srcdir/BUILD-COMMIT" "$pkgdir/usr/share/grassfield/BUILD-COMMIT"
  install -Dm644 "$srcdir/BUILD-DEPS" "$pkgdir/usr/share/grassfield/BUILD-DEPS"
  install -Dm644 "$root/CHANGELOG.md" "$pkgdir/usr/share/doc/grassfield/CHANGELOG.md"
  install -Dm644 "$root/README.md" "$pkgdir/usr/share/doc/grassfield/README.md"
  install -Dm644 "$root/branding/LICENSES.md" "$pkgdir/usr/share/licenses/grassfield-desktop/BRANDING.md"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/grassfield-desktop/LICENSE"
  install -Dm644 "$root/THIRD_PARTY.md" "$pkgdir/usr/share/licenses/grassfield-desktop/THIRD_PARTY.md"
  install -Dm644 "$root/packaging/licenses/omarchy-MIT.txt" "$pkgdir/usr/share/licenses/grassfield-desktop/omarchy-MIT.txt"
  install -Dm644 "$root/packaging/licenses/unicode-license-v3.txt" "$pkgdir/usr/share/licenses/grassfield-desktop/unicode-license-v3.txt"
  install -Dm644 "$root/packaging/licenses/clipboard-protocols-notices.txt" "$pkgdir/usr/share/licenses/grassfield-desktop/clipboard-protocols-notices.txt"
}

package_grassfield-compositor() {
  pkgdesc+=" — optional Hyprland plugin (titlebars, minimize, appmenu)"
  # A plugin only hooks into the Hyprland build it was compiled for, and the hyprland version is never constrained here
  # (ADR-0009 "Amendment 2026-10-23", audit GF-033): the session loads this build only when its stamp is the running
  # Hyprland's ABI, else the user's own build (grassfield-compositor-rebuild, as the user, into the user's cache), else none
  # (degraded mode with a notice). Nothing is ever compiled as root or by a pacman hook.
  # The plugin and the shell of one release speak one protocol (ADR-0007; the gfc/1 amendment of 2026-10-24 changed the
  # Stages event): this package needs the desktop of exactly its own version, so pacman upgrades the pair together and
  # refuses a partial upgrade of either. The desktop does not depend on this package: it runs without the plugin (C2).
  depends=(hyprland "grassfield-desktop=$pkgver-$pkgrel")
  # Own code MIT; the server code generated from the KDE appmenu protocol XML LGPL-2.1-or-later; Hyprland's headers BSD-3-Clause.
  license=(MIT LGPL-2.1-or-later BSD-3-Clause)
  # Debug symbols stay in the .so (built RelWithDebInfo): a crash inside Hyprland has to be readable. No split package.
  options=(!strip)
  # What the user's rebuild needs besides Hyprland's own dependencies (headers, lua, hyprwayland-scanner, pixman, libdrm,
  # libglvnd).
  optdepends=(
    'cmake: grassfield-compositor-rebuild (the extension for a newer Hyprland)'
    'gcc: grassfield-compositor-rebuild'
    'make: grassfield-compositor-rebuild'
    'pkgconf: grassfield-compositor-rebuild'
  )
  local root
  root=$(_root)
  install -Dm755 "$srcdir/compositor-out/grassfield-compositor.so" "$pkgdir/usr/lib/grassfield/grassfield-compositor.so"
  # Its stamp: the ABI it was built for, written by its own CMake build from the headers it was compiled against
  # (compositor/abi-stamp.cmake; config/hypr/grassfield/compositor.lua loads the build whose stamp is the ABI of the
  # Hyprland that runs). Packaging stops when it is not the installed Hyprland's: the build is stale.
  local built_abi installed_abi
  built_abi=$(head -n 1 "$srcdir/compositor-out/grassfield-compositor.abi")
  installed_abi=$("$root/packaging/arch/grassfield-compositor-rebuild" --print-abi)
  if [[ -z $built_abi || $built_abi != "$installed_abi" ]]; then
    echo "grassfield-compositor: the plugin was built for '$built_abi', the installed Hyprland is '$installed_abi': rebuild it" >&2
    return 1
  fi
  # The stamp's second line: the Grassfield version of the build (the same id as the sources' VERSION below), compared by
  # the loader and the rebuild with the installed sources: a build of another Grassfield version is never loaded.
  install -d "$pkgdir/usr/lib/grassfield"
  printf '%s\nsource %s-%s\n' "$built_abi" "$pkgver" "$pkgrel" >"$pkgdir/usr/lib/grassfield/grassfield-compositor.abi"
  chmod 0644 "$pkgdir/usr/lib/grassfield/grassfield-compositor.abi"
  install -Dm755 "$root/packaging/arch/grassfield-compositor-rebuild" "$pkgdir/usr/lib/grassfield/grassfield-compositor-rebuild"
  # The commands a person types are on PATH (grassfield-compositor-rebuild, grassfield-compositor-rebuild --check).
  install -d "$pkgdir/usr/bin"
  ln -s ../lib/grassfield/grassfield-compositor-rebuild "$pkgdir/usr/bin/grassfield-compositor-rebuild"
  # The sources the user's rebuild is made from (the plugin only: no unit tests, no build directory).
  local src=$pkgdir/usr/src/grassfield-compositor
  # The list is shared with tests/shell/gates.sh (packaging/arch/compositor-rebuild-sources.txt).
  local from to
  while read -r from to; do
    [[ -z $from || $from == \#* ]] && continue
    if [[ -d $root/$from ]]; then
      mkdir -p "$(dirname "$src/$to")"
      cp -a --no-preserve=ownership "$root/$from" "$src/$to"
    else
      install -Dm644 "$root/$from" "$src/$to"
    fi
  done <"$root/packaging/arch/compositor-rebuild-sources.txt"
  printf '%s-%s\n' "$pkgver" "$pkgrel" >"$src/VERSION" # the source id the rebuild reports (a pacman version)
  # (cmake/VERSION, from the list, is the product version for the rebuild's CMake.) The build commit of the plugin:
  install -Dm644 "$srcdir/BUILD-COMMIT" "$pkgdir/usr/lib/grassfield/BUILD-COMMIT"
  install -Dm644 "$root/LICENSE" "$pkgdir/usr/share/licenses/grassfield-compositor/LICENSE"
  install -Dm644 "$root/THIRD_PARTY.md" "$pkgdir/usr/share/licenses/grassfield-compositor/THIRD_PARTY.md"
  install -Dm644 "$root/packaging/licenses/hyprland-BSD-3-Clause.txt" "$pkgdir/usr/share/licenses/grassfield-compositor/hyprland-BSD-3-Clause.txt"
  install -Dm644 "$root/packaging/licenses/appmenu-LGPL-2.1-or-later.txt" "$pkgdir/usr/share/licenses/grassfield-compositor/appmenu-LGPL-2.1-or-later.txt"
}

package_grassfield-store() {
  pkgdesc="Grassfield Store: find, install, open and uninstall apps from Arch's repositories, Omarchy's, its setups and web apps"
  # ADR-0037 f: grassfield-desktop of the same build (design system, translations, menu bridge); polkit (pkexec, the helper's
  # action, ADR-0037 b.1); gnupg (gpgv: the catalog's signature); kimageformats (the JPEG XL icons of Arch's app data, S3).
  # Omarchy's commands (web apps, its terminal and setups' recipes, b.2), pacman, flock and sha256sum (grassfield-store-run)
  # come with the system. The Store's own helper is its only root code: the security review of step 3 covers it and its
  # policy, and grassfield-store-run (run as the user).
  depends=("grassfield-desktop=$pkgver-$pkgrel" polkit gnupg kimageformats qt6-declarative qt6-wayland zlib)
  optdepends=(
    "archlinux-appstream-data: Arch's app data on this computer (else the Store fetches it from your package mirror and checks it)"
  )
  license=(MIT)
  DESTDIR="$pkgdir" cmake --install "$srcdir/store-build"
  install -Dm644 "$(_root)/LICENSE" "$pkgdir/usr/share/licenses/grassfield-store/LICENSE"
  install -Dm644 "$srcdir/BUILD-COMMIT" "$pkgdir/usr/share/grassfield/store/BUILD-COMMIT"
}

package_grassfield-icons() {
  pkgdesc="Grassfield icon theme: own icons, a composed third-party set (GPL-3.0) with Pebble folders and store, Breeze fallback"
  arch=(any)
  # MIT for Grassfield's own glyphs (root LICENSE); GPL-3.0-only for the third-party art. MacTahoe ships COPYING (GPL
  # version 3, unmodified text), its README states no licence and no file carries an "or later" notice: GPL-3.0-only.
  # Pebble's README states "GPL-3.0" and links a LICENSE file that does not exist at the pin (owner accepted the risk
  # 2026-10-23, THIRD_PARTY.md).
  license=(MIT GPL-3.0-only)
  # The project URL (package metadata is shown by pacman and software centres: no Apple trademark name there); the
  # upstream URLs and commits are in /usr/share/licenses/grassfield-icons/SOURCE.
  depends=(breeze-icons)
  options=(!strip)
  install -d "$pkgdir/usr/share/icons"
  cp -a --no-preserve=ownership "$srcdir/grassfield-icons" "$pkgdir/usr/share/icons/grassfield-icons"
  # The gtk-update-icon-cache pacman hook builds icon-theme.cache on the target; the composer ships none.
  local lic="$pkgdir/usr/share/licenses/grassfield-icons"
  install -Dm644 "$srcdir/mactahoe-icon-theme/COPYING" "$lic/COPYING"
  install -Dm644 "$srcdir/mactahoe-icon-theme/AUTHORS" "$lic/AUTHORS"
  install -Dm644 "$(_root)/LICENSE" "$lic/LICENSE"
  install -Dm644 "$(_root)/THIRD_PARTY.md" "$lic/THIRD_PARTY.md"
  printf '%s\n' \
    "MacTahoe icon theme: https://github.com/vinceliuice/MacTahoe-icon-theme at commit ${_mactahoe_commit}" \
    "Pebble icon theme:   https://github.com/a-shewale/Pebble-Icon-Theme at commit ${_pebble_commit}" \
    >"$lic/SOURCE"
  printf '%s\n' \
    "Pebble icon theme (https://github.com/a-shewale/Pebble-Icon-Theme, commit ${_pebble_commit}), user a-shewale:" \
    "its folders (places), the store icon and the icons not provided by the other layers are used in this theme." \
    "Its README states GPL-3.0; the repository holds no licence file at this commit." \
    "Its README credits MacTahoe, Hatter (https://github.com/Mibea/Hatter, base of its folders) and Adwaita as sources." \
    >"$lic/PEBBLE"
  # GPL-3.0 section 5a: the composer edits some of the upstream SVG files it copies (icons-compose.py clean_svg).
  printf '%s\n' \
    "Modification notice (GPL-3.0 section 5a): the build of this theme (packaging/arch/icons-compose.py, clean_svg) edits a small" \
    "number of the SVG files copied from the layers above: an empty <pattern href=\"#x\"/> is written out with the attributes and" \
    "content of the pattern it references, and a fill or stroke that points to a missing or contentless paint server is replaced" \
    "by none, so that Qt's SVG renderer can read the file. The drawings are otherwise unchanged. Date of this change: 2026-10-25." \
    >"$lic/NOTICE"
}

package_grassfield-wallpapers() {
  pkgdesc="Grassfield wallpaper photographs: sixteen photographs from Wikimedia Commons (CC0, CC BY, public domain)"
  arch=(any)
  # Each photograph keeps its own licence (THIRD_PARTY.md, "Wallpaper photographs"; the owner accepted the two public-domain
  # ones on 2026-10-31, ADR-0040). The credits, sources, licences and changes are in THIRD_PARTY.md and photos.json.
  license=(CC0-1.0 CC-BY-2.0 CC-BY-3.0 CC-BY-4.0 LicenseRef-public-domain)
  depends=()
  local id dir="$pkgdir/usr/share/grassfield/wallpapers/photos"
  for id in "${GF_PHOTO_IDS[@]}"; do
    install -Dm644 "$srcdir/photos/$id.jpg" "$dir/$id.jpg"
  done
  # Settings > Wallpaper reads the list beside the pictures (WallpaperConfig.parsePhotos).
  install -Dm644 "$(_root)/packaging/arch/wallpaper-photos.json" "$dir/photos.json"
  install -Dm644 "$(_root)/THIRD_PARTY.md" "$pkgdir/usr/share/licenses/grassfield-wallpapers/THIRD_PARTY.md"
}

package_grassfield-login-themes() {
  pkgdesc="Grassfield login and boot themes: an SDDM theme in the lock screen's layout and a Plymouth theme with the mark (ADR-0042; activated only by the owner's commands)"
  arch=(any)
  # The SDDM theme's QML is source code (MIT, as the repository); the Plymouth images drawn in build.sh: CC-BY-SA-4.0; the
  # mark in the Plymouth theme is the owner's (all rights reserved).
  license=(MIT CC-BY-SA-4.0 LicenseRef-Grassfield-logo-all-rights-reserved)
  depends=("grassfield-desktop=$pkgver-$pkgrel")
  optdepends=('sddm: the login theme (sddm-greeter-qt6)' 'plymouth: the boot theme')
  # Nothing is activated here: no SDDM drop-in, no Plymouth default, no initramfs change (docs/owner-setup/login-boot-themes.md).
  local sddm="$pkgdir/usr/share/sddm/themes/grassfield" ply="$pkgdir/usr/share/plymouth/themes/grassfield"
  install -Dm644 -t "$sddm" "$(_root)"/packaging/sddm/theme/{Main.qml,Strings.js,metadata.desktop,theme.conf}
  install -d "$ply"
  install -m644 "$srcdir"/plymouth-grassfield/*.png "$srcdir/plymouth-grassfield/grassfield.plymouth" "$ply/"
  install -Dm644 "$(_root)/LICENSE" "$pkgdir/usr/share/licenses/grassfield-login-themes/LICENSE"
  install -Dm644 "$(_root)/branding/LICENSES.md" "$pkgdir/usr/share/licenses/grassfield-login-themes/BRANDING.md"
}
