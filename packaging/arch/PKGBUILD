            'SKIP')
sha1sums=('SKIP'
          'SKIP'
          'a5eeee96a4b9eaaa9edfc29978a51350ae1681f1'
          'd0b41e3e969f335acd11780e2f113650998abdd7'
          '0204c6b1c12e800674ffd3423f3c0b903af020f1'
          '196669deb715c8b405f4287cd1fd81d50f98c2c0'
