# Maintainer: Grassfield project
# Local package build from this repository. grassfield-desktop and grassfield-compositor need no download;
# grassfield-icons fetches TWO pinned upstream commits (MacTahoe and Pebble icon themes, GPL-3.0, ADR-0017);
# grassfield-wallpapers fetches sixteen photographs from upload.wikimedia.org, each checked by its SHA-1 (ADR-0040 step 2c):
#   cd packaging/arch && makepkg -si        (owner runs it; installs with sudo through pacman)
# Remove: sudo pacman -Rns grassfield-login-themes grassfield-desktop grassfield-compositor grassfield-icons grassfield-wallpapers   (all of them:
#   the icon theme and the photographs are installed with the others; naming only the first two leaves the 60 MiB icon
#   theme and the photographs behind, GF-046)
# Never constrain the hyprland version here (ADR-0009, master-prompt §5.6).
#
# Provenance (GF-044): the package is built from a `git archive` snapshot of HEAD, unpacked into $srcdir/snapshot by
# prepare(); every build directory is under $srcdir, nothing is written to the live working tree and nothing that is
# not committed is packaged (a dirty tree is reported). The commit is recorded in /usr/share/grassfield/BUILD-COMMIT (desktop) and /usr/lib/grassfield/BUILD-COMMIT (plugin).
# The installed plugin is the one built here (RelWithDebInfo, not stripped: a crash inside Hyprland needs its symbols;
# the package is larger by the debug sections, there is no split -debug package).
#
# One version source (D-11): the VERSION file at the repository root. pkgver is that version without the hyphen
# (1.0.0-rc1 -> 1.0.0rc1, which pacman orders before 1.0.0); pkgrel restarts at 1 with every new VERSION. A rebuild of the
# same VERSION for the [grassfield] channels (a new Hyprland, ADR-0033 e, owner decision O7) sets GRASSFIELD_PKGREL, a
# positive integer, instead of a commit; unset, the pkgrel below is used.

_here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
_ver=$(tr -d '[:space:]' <"$_here/../../VERSION")
pkgbase=grassfield
pkgname=(grassfield-desktop grassfield-compositor grassfield-icons grassfield-store grassfield-wallpapers grassfield-login-themes)
pkgver=${_ver//-/}
if [[ -n ${GRASSFIELD_PKGREL:-} && ! $GRASSFIELD_PKGREL =~ ^[1-9][0-9]*$ ]]; then
  echo "PKGBUILD: GRASSFIELD_PKGREL must be a positive integer, not '$GRASSFIELD_PKGREL'" >&2
  exit 1
fi
pkgrel=${GRASSFIELD_PKGREL:-1}
pkgdesc="Grassfield Desktop: a polished desktop session for Omarchy (built for Omarchy, based on Arch Linux)"
arch=(x86_64)
url="https://grassfield.invalid"
# Grassfield's own code is MIT (ADR-0005, accepted by the owner 2026-10-18; root LICENSE, installed by every package).
# Each package function sets its own license= array (own art CC-BY-SA-4.0, generated appmenu code LGPL-2.1-or-later,
# the icon pack GPL-3.0-only, ...): THIRD_PARTY.md has the table, scripts/dev/check-licenses.sh checks it.
# Third-party notices: THIRD_PARTY.md, installed under /usr/share/licenses/<package>/.
license=(MIT)
# Everything the build compiles against or runs is here: `makepkg -s` installs the global depends and makedepends only,
# not the depends of the package functions below. Found by the first builds in a clean container (grassfield-packages,
# ADR-0033 f): hyprwayland-scanner (the plugin's protocol code, compositor/CMakeLists.txt), kio, solid, kcoreaddons and
# kservice (apps/files), qt6-webengine (QtPdf) and qt6-multimedia (apps/preview). quickshell: the build records the version
# the shell was built for (BUILD-DEPS, below), which Software Update's compatibility check reads (ADR-0033 s3.4).
makedepends=(cmake ninja pkgconf hyprland hyprwayland-scanner gtest lua extra-cmake-modules qt6-declarative qt6-tools
             hyprcursor librsvg python dconf git wayland kio solid kcoreaddons kservice qt6-webengine qt6-multimedia
             quickshell gcr-4 libsecret)
options=(!debug)
# grassfield-icons (ADR-0017, owner decision 2026-10-23): ONE theme composed from two third-party themes by
# packaging/arch/icons-compose.py (layers: our own icons, MacTahoe, Pebble, our device glyphs; Pebble folders and store
# bag; Apple logos removed per packaging/arch/icons-apple-logos.txt). Integrity: the commit id (makepkg checks it out by
# id) and the SHA-256 of the `git archive` of that commit (pacman 7.1 calc_checksum_git). No upstream script runs: the
# composer reads src/, links/ and Pebble/ only. The pins live in icon-pins.sh, which scripts/dev/icons.sh sources too
# (one definition); only the sha256sums below are written here, because makepkg's updpkgsums rewrites them in place.
source "$_here/icon-pins.sh"
_mactahoe_commit=$MT_PIN
_pebble_commit=$PB_PIN
source=("mactahoe-icon-theme::git+${MT_REPO}.git#commit=${_mactahoe_commit}"
        "pebble-icon-theme::git+${PB_REPO}.git#commit=${_pebble_commit}")
# grassfield-wallpapers (ADR-0040 step 2c, the owner's call of 2026-10-31): the sixteen photographs as uploaded to Wikimedia
# Commons. Their ids and addresses live in wallpaper-pins.sh (the list with names, authors and licences is
# wallpaper-photos.json); each is checked by the SHA-1 Commons publishes for it (sha1sums below, in the pins' order; no
# SHA-256 is published, updpkgsums can add them). build() shrinks them, package_grassfield-wallpapers() installs them.
source "$_here/wallpaper-pins.sh"
for _i in "${!GF_PHOTO_IDS[@]}"; do
  source+=("photo-${GF_PHOTO_IDS[_i]}.jpg::${GF_PHOTO_URLS[_i]}")
done
unset _i
sha256sums=('4d91771b305c25b6a81e8a24e7c3d4ae49cce9754db199437191fa30cb9c60b0'
