# pacman scriptlet of grassfield-desktop (runs as root): the login-path check of GF-015, which reads files and only
# prints (its lines are the owner's feedback that the login screen reaches Grassfield), and Software Update's two steps
# (ADR-0033 b.8, h.3), which run grassfield-channel-scriptlet, a root program over grassfield-channel.sh (opus security
# review): pre_remove takes the [grassfield] section and the Grassfield keys away, post_upgrade migrates a configuration
# that still names a previous host.

post_install() {
  echo "grassfield: checking the login path (also: /usr/lib/grassfield/grassfield-login-check)"
  /usr/lib/grassfield/grassfield-login-check 2>&1 | sed 's/^/grassfield: /' || true
  echo "grassfield: restart the computer once: SDDM reads its configuration only when it starts, so until then the login screen still starts your previous session. After that it starts Grassfield; Omarchy stays one command away: grassfield-login set omarchy"
}

post_upgrade() {
  # GF-115: since this version the shell is started from /usr/share/grassfield/shell by path. A shell still running from the
  # earlier unit was started by name (through /etc/xdg/quickshell) and Quickshell matches instances by the path they were
  # started with, so the key bindings, lid handler and sleep lock cannot reach it until it restarts. Restarting is safe while
  # locked (the compositor keeps the lock, ADR-0010). Said only when upgrading from a version older than the first one that
  # loads by path (pacman passes the new version as $1 and the old one as $2); later upgrades stay quiet.
  # FIRST_PATH_LOADED is the first version after the last release that started the shell by name (main was 0.4.0-12 when this
  # was written, so any release that carries this scriptlet, 1.0.0rc1-1 included, is above it and no later one repeats the note).
  FIRST_PATH_LOADED=0.4.0-13
  if [ -n "${2:-}" ] && [ "$(vercmp "$2" "$FIRST_PATH_LOADED" 2>/dev/null || echo 0)" -lt 0 ]; then
    echo "grassfield: after this upgrade restart the shell once: systemctl --user restart grassfield-shell (or log out and in)"
  fi
  # ADR-0041 step 1, S2: the lock, idle and the sleep inhibitor moved from the UI's process into grassfield-security. The two
  # processes started before the upgrade keep the earlier split until they restart: the UI still holds the lock and idle,
  # the security process hosts none. The new key binding, the lid and Omarchy's sleep lock reach the lock anyway (they fall
  # back to Grassfield's stand-in, which restarts a security process from before S2, and the restarted one takes the lock
  # back from its marker; the opus review of 77a0ceb3, MINOR-1), but until both restart the earlier UI also locks on idle.
  # Said once, when upgrading from a version before the first release that carries S2: every build of 1.0.0rc7 and earlier
  # predates it (the next release is 1.0.0rc8 or later; a rebuild of an rc7 tag never carries it). S3 (the polkit agent and
  # the secret sheets moved into grassfield-security, grassfield-prompter accepting that unit only) lands before 1.0.0rc8
  # too, so the same note covers it: until the processes restart, an earlier UI keeps the session's polkit agent and a
  # running bridge still expects the UI's unit, so the restart line names the bridge and reloads the user manager first.
  FIRST_SECURITY_PROCESS_LOCK=1.0.0rc8
  if [ -n "${2:-}" ] && [ "$(vercmp "$2" "$FIRST_SECURITY_PROCESS_LOCK" 2>/dev/null || echo 0)" -lt 0 ]; then
    echo "grassfield: after this upgrade log out and back in once: the lock screen now runs in its own process (or: systemctl --user daemon-reload && systemctl --user restart grassfield-prompter grassfield-security grassfield-shell)"
  fi
  /usr/lib/grassfield/grassfield-login-check 2>&1 | sed 's/^/grassfield: /' || true
  # 1.0.0-rc7 installed zz-grassfield-gtk.json in the browsers' policy directories (machine-wide). An unmodified copy is
  # removed by this upgrade; one the administrator edited is kept by pacman as .pacsave and never deleted here. Chromium reads
  # every file of its policy directory whatever its name (config_dir_policy_loader.cc), so a kept file still applies to
  # every session, the Omarchy one included: said here, with what to do.
  for f in /etc/chromium/policies/managed/zz-grassfield-gtk.json /etc/opt/chrome/policies/managed/zz-grassfield-gtk.json; do
    if [ -e "$f.pacsave" ]; then
      echo "grassfield: $f.pacsave is the policy file of 1.0.0-rc7 that you edited, kept for you. Grassfield no longer uses it, but the browsers read every file of that directory, so it still applies to every session, Omarchy's included. If you do not need your edits, delete it (sudo rm $f.pacsave); if you do, move them into a file of your own and delete it."
    fi
    if [ -e "$f" ]; then
      echo "grassfield: $f is still there and applies to every session, Omarchy's included, although Grassfield no longer needs it: delete it (sudo rm $f) unless you want it."
    fi
  done
  # A /etc/pacman.d/grassfield.conf whose primary Server is a previous host of this build is written again for its channel.
  /usr/lib/grassfield/grassfield-channel-scriptlet upgrade || echo "grassfield: the [grassfield] configuration was not migrated (see above)"
}

pre_remove() {
  # No [grassfield] line, no /etc/pacman.d/grassfield.conf and no trusted Grassfield key are left behind: an Include whose
  # file is gone would stop every pacman command, and a locally signed key is trusted for every repository.
  /usr/lib/grassfield/grassfield-channel-scriptlet remove ||
    echo "grassfield: Software Update's [grassfield] configuration was not fully removed (see above): delete the [grassfield] lines at the end of /etc/pacman.conf, then /etc/pacman.d/grassfield.conf"
}
