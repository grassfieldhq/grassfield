[Unit]
Description=Grassfield security process (the lock, idle and the sleep inhibitor; the polkit agent from S3)
Documentation=file:///usr/share/doc/grassfield/README.md
# ADR-0041 step 1 (the owner's SQ-1 B, ADR-0010 "Separate security process"): a second Quickshell process beside the UI,
# so that a crash of the desktop never takes the lock down. S1 started it hosting nothing; since S2 it hosts the lock, idle
# and the sleep inhibitor (shell/security.qml, shell/security/SecurityHost.qml), and the UI asks it for every lock over
# IPC; S3 adds the polkit agent, S4 safe mode.
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# Only inside the Grassfield session, never in the Omarchy session.
ConditionEnvironment=GRASSFIELD_SESSION=1
# A loop of this process ends at its fifth start in five minutes (ADR-0041 step 1b: the compositor then keeps any lock,
# the known limit); with RestartSec=1 a loop faster than one crash every 59 s reaches it (tests/shell/unit_restart_limits.sh).
StartLimitIntervalSec=300
StartLimitBurst=5
# Fail-safe for lock before sleep (D-12), moved here from grassfield-shell.service at S2 with the inhibitor. With the default
# RestartMode=normal this unit passes through "failed" on every failure (a crash, an exit code, 255 included) before the
# restart, so OnFailure= starts Omarchy's sleep-lock unit after each one: it holds a logind delay inhibitor while this
# process restarts or stays failed and, before a sleep, asks it to lock through Grassfield's `omarchy-shell` stand-in
# (packaging/shims), which starts it again if needed. Its Grassfield drop-in skips it once this process is up again
# (active/running; packaging/systemd/sleep-lock-gate, keyed on this unit alone). A logout starts it too, and the gate then
# skips it (the compositor is gone).
OnFailure=omarchy-sleep-lock.service

[Service]
Type=simple
Slice=session.slice
# Quickshell's own reload is off: package upgrades must not hot-reload a half-written tree (as the UI's unit).
Environment=QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1
# Qt's "@2x" image lookup off, as in the UI's unit (review of cbd6ef05): a file:// picture is decoded from the path asked
# for, never from a "<name>@2x.<ext>" beside it (the lock checks its wallpaper still by that path).
Environment=QT_HIGHDPI_DISABLE_2X_IMAGE_LOADING=1
# The same cleared search paths and option variables as grassfield-shell.service (GF-115, the review of 360d6fa): a leaked
# developer path or a stray QS_MANIFEST must not replace this process's QML either. tests/security/security_unit.sh keeps
# the two lists identical; tests/security/shell_unit_env.sh derives the UI's from `qs --help`.
UnsetEnvironment=QML_IMPORT_PATH QML2_IMPORT_PATH QML_PLUGIN_PATH QML_DISK_CACHE_PATH QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH QS_CONFIG_PATH QS_CONFIG_NAME QS_MANIFEST GTK_MODULES GTK3_MODULES GTK_PATH GIO_EXTRA_MODULES QT_VULKAN_LIB QSG_RHI_BACKEND
# This process never asks the portal (no GTK platform theme work at start; gate P5, ADR-0035 D-4).
UnsetEnvironment=GTK_USE_PORTAL
# ADR-0054: the session sets QT_QPA_PLATFORMTHEME=xdgdesktopportal for the apps (Qt's portal theme makes a blocking portal call
# when a Qt process starts: the same wait as GTK_USE_PORTAL above, gate P5). This process keeps Omarchy's gtk3, its value before the
# ADR (Hyprland imports the session's value into the systemd user manager, and Environment= wins over it).
Environment=QT_QPA_PLATFORMTHEME=gtk3
# GF-115: the root is loaded by path from the system tree only; `qs.*` resolves from /usr/share/grassfield/shell, the
# UI root's directory, so the security modules keep their place. Every `qs ipc` caller names this same path.
ExecStart=/usr/bin/qs -n -p /usr/share/grassfield/shell/security.qml
# Back within about 1 s after any exit while the session runs; a stop through systemd is never restarted (logout stops
# graphical-session.target, PartOf=), and Requisite= refuses a start once the target is gone.
Restart=always
RestartSec=1
TimeoutStopSec=5
# Memory guard from the S1 measurement (ADR-0041 step 1; the integrator's nested pass of #72: 157 MB of RSS at idle for
# the root hosting one IPC handler): MemoryHigh about twice that, MemoryMax about four times, as a slow leak reaches the
# first after days and a runaway one the second (ADR-0041 R4). S2 (docs/testing/gates.md "P2 and the security process"):
# offscreen, the root with the lock and idle loaded grows by about 45 MB of RSS over S1's (65 -> 110 MB, medians of three);
# the lock's surfaces and the stills (about 33 MB per 4K output, decoded once each) come on top when locked:
# 157 + 45 + 2 x 33 = 268 MB for two 4K outputs,
# under MemoryHigh, MemoryMax far above it. The nested measurement with the lock drawn decides (NOT VERIFIED at S2's
# commit: the integrator's `scripts/gates/rss.sh --nested` with both processes); until it, both stay as set at S1. The
# throttling above MemoryHigh could delay drawing the lock past the sleep delay: the margin above is kept for that reason.
# CPUQuota as the UI unit's (one and a half cores): a spinning process cannot starve the compositor, while the lock
# screen's rendering and the PAM exchange (S2) keep a whole core; the 50% of the first version would have throttled them
# (the integrator's merge review of #72). A loop is caught by the restart limit above and, from S2, by the heartbeat.
MemoryHigh=320M
MemoryMax=640M
CPUQuota=150%
# No NoNewPrivileges/ProtectSystem here on purpose, as for the UI's unit: from S2 the lock and from S3 the polkit agent
# rely on the setuid/setgid helpers unix_chkpwd and polkit-agent-helper-1, which NoNewPrivileges would break, leaving the
# session unable to unlock.

[Install]
WantedBy=graphical-session.target
