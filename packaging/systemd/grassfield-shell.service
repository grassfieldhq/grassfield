[Unit]
Description=Grassfield shell (menu bar, Dock, notifications, polkit agent)
Documentation=file:///usr/share/doc/grassfield/README.md
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# Only inside the Grassfield session, never in the Omarchy session.
ConditionEnvironment=GRASSFIELD_SESSION=1
# The start limit is the backstop of a crash loop (ADR-0041 step 1a, owner decision SQ-2 A): systemd refuses the eleventh
# start within 5 minutes, so with RestartSec=1 a loop faster than one crash every 29 s ends here in "failed" (the first
# limit, 10 in 30 s, needed a crash within 2 s of each start and never tripped the loop of 2026-10-29, a crash 5 s after
# every start). The loop detector below counts failures instead and stops a loop of any pace at the third failure within
# 10 minutes.
StartLimitIntervalSec=300
StartLimitBurst=10
# grassfield-shell-failed.service (ADR-0041 step 1a): the failure counter, started after every failure (with the default
# RestartMode=normal, systemd 254+, this unit passes through "failed" on EVERY failure, before the restart; a clean exit 0,
# SIGTERM or `qs kill` ends "inactive" and does not). At the third failure within 10 minutes it cancels the pending restart
# and writes the safe-mode state; a logout counts nothing. Omarchy's sleep lock is no longer started from here (ADR-0041
# step 1, S2): the lock, idle and the sleep inhibitor run in grassfield-security.service, whose OnFailure= arms it; a crash
# of this UI changes nothing about the lock or sleep.
OnFailure=grassfield-shell-failed.service

[Service]
Type=simple
Slice=session.slice
# Quickshell's own reload is off: package upgrades must not hot-reload a half-written tree.
Environment=QS_DISABLE_FILE_WATCHER=1 QS_NO_RELOAD_POPUP=1
# Quickshell's crash handler off (ADR-0041 S2, the integrator's nested run of e1a3ff4c, ui-crash): with it, a crash 10 s or
# more after the start leaves the crashed process alive, blocked in its signal handler while a reporter it forked relaunches
# the shell as its own child ("Quickshell has been restarted"), so systemd sees no failure: no restart of its own, no
# OnFailure=, no count toward safe mode, and the crashed process keeps its memory charged to this unit. Without it the
# process ends on the signal: a failure (unlike SIGTERM, which leaves the unit inactive), so systemd restarts it after
# RestartSec=, runs OnFailure= and counts it, and the journal records the crash (coredumpctl list), with no core file
# (LimitCORE= below) (macOS: the process dies, launchd restarts it, ReportCrash writes the report).
Environment=QS_DISABLE_CRASH_HANDLER=1
# No core file (the opus delta review of 122f8d67, MAJOR): systemd-coredump stores a crashed process's whole memory under
# /var/lib/systemd/coredump, readable by its user through an ACL, and this process hosts the polkit agent and the secret sheets until ADR-0041 S3/S4
# move them (polkit, Wi-Fi, network-share and keyring passwords).
# A same-user process that Yama keeps from reading this one's memory could crash it and read the dump instead. With
# LimitCORE=0, systemd-coredump honours the limit: it records the crash in the journal (signal, PID, unit: coredumpctl list
# shows it, without a file and without a stack) and stores nothing. The process still dies by the signal, so Restart=,
# OnFailure= and the failure counter are unchanged.
# Exactly 0, the hard limit included: never `0:infinity` or any soft-only form. With a hard limit above 0, a same-user process
# can raise the soft one with prlimit, crash this process and read the dump (the opus gate of 55bfea41). The tests pin this
# exact line (tests/security/security_unit.sh, tests/shell/shell_unit.sh). The applications this shell starts (the Dock,
# Search, Launchpad: `uwsm-app --`, a scope that runs in this process's tree) inherit the hard limit of 0: their crashes
# still give a notice (the journal entry), but no core file, a terminal opened from the Dock included (ADR-0041 S2: a
# decision to revisit, starting the applications through the user manager instead).
LimitCORE=0
# Qt's "@2x" image lookup off (review of cbd6ef05): a file:// picture is decoded from the very path the shell asked for (the
# lock checks its wallpaper still by that path), never from a "<name>@2x.<ext>" beside it. The shell ships no such file.
Environment=QT_HIGHDPI_DISABLE_2X_IMAGE_LOADING=1
# Leaked developer search paths and accidental overrides must not replace or disable the shell's QML (review of 360d6fa,
# the GF-115 class): a `qs/security/lock` directory on QML_IMPORT_PATH replaced the whole lock screen, and a stray
# QS_MANIFEST (or QS_CONFIG_NAME) made `qs -n -p` refuse to start at all (no lock, no polkit agent). So the unit clears
# the QML and Qt plugin search paths, every variable `qs --help` maps to an option (the packaged command line needs
# none), the GTK module variables the gtk3 platform theme would load modules from, GIO_EXTRA_MODULES (GSettings loads
# GIO modules from it), and the Vulkan loader override with the variable that selects the Vulkan backend
# (QSG_RHI_BACKEND; the shell runs on Qt's default backend). Not a native-loader boundary: EGL, GBM, Mesa and Vulkan
# driver variables and LD_LIBRARY_PATH still reach qs (some GPU setups need them).
# systemd applies UnsetEnvironment= last, over Environment= and the manager's environment. Grassfield's QML modules and Qt
# plugins then come from Qt's built-in locations (/usr/lib/qt6/qml, /usr/lib/qt6/plugins), the shell from -p below, and
# nothing is set in their place. This is not a defence against code that already runs as the user (it can set the
# environment, LD_PRELOAD, a user drop-in for this unit, a compiled-QML cache under XDG_CACHE_HOME: out of scope, as for
# Omarchy; docs/specs/security.md). tests/security/shell_unit_env.sh holds the list (and derives the qs options from
# `qs --help`); scripts/dev/shell-run.sh --unit-env applies it.
UnsetEnvironment=QML_IMPORT_PATH QML2_IMPORT_PATH QML_PLUGIN_PATH QML_DISK_CACHE_PATH QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH QS_CONFIG_PATH QS_CONFIG_NAME QS_MANIFEST GTK_MODULES GTK3_MODULES GTK_PATH GIO_EXTRA_MODULES QT_VULKAN_LIB QSG_RHI_BACKEND
# Gate P5, ADR-0035 D-4: with GTK_USE_PORTAL=1 (env-grassfield) the gtk3 platform theme's gtk_init asks the portal for its
# settings synchronously, so the shell's start would wait on xdg-desktop-portal. The shell takes its appearance from
# grassfield.json itself.
UnsetEnvironment=GTK_USE_PORTAL
# ADR-0054: the session sets QT_QPA_PLATFORMTHEME=xdgdesktopportal for the apps (Qt's portal theme makes a blocking portal call
# when a Qt process starts: the same wait as GTK_USE_PORTAL above, gate P5). This process keeps Omarchy's gtk3, its value before the
# ADR (Hyprland imports the session's value into the systemd user manager, and Environment= wins over it).
Environment=QT_QPA_PLATFORMTHEME=gtk3
# The lock before sleep is grassfield-security's (ADR-0041 S2); this shell holds no inhibitor and no session lock.
# GF-115: the shell loads ONLY from the system location. `-c grassfield` would also search $XDG_CONFIG_HOME/quickshell, a
# user-writable directory, and a copy there would replace the polkit agent (and, through the same tree, the security
# process's lock screen). Every `qs ipc` caller (bindings, stand-ins, apps) names the same path, the lock's callers the
# security root next to it. tests/shell/session_services.sh keeps them in step.
ExecStart=/usr/bin/qs -n -p /usr/share/grassfield/shell
# ADR-0048 D-4: the CPU and I/O limits the shell set on apps the person could not see are lifted when it stops or crashes
# (the restarted shell resets them again at start). "-": a failure here never marks the unit failed.
ExecStopPost=-/usr/lib/grassfield/grassfield-energy reset
# Gate R1 and GF-030: back after 100 ms after ANY exit (the start itself is what gate R1 measures; ADR-0056; a loop is still ended by the start limit above, 10 starts x (0.1 s + the 10 s of the slowest loop the model knows) = 101 s < 300 s, and by the failure counter at the third failure) while the session runs: a crash, SIGTERM, `qs kill`, exit 0. The
# session lock is the security process's (ADR-0041 S2): a lock shown when this shell goes away stays drawn and keeps the
# keyboard. A stop through systemd is never restarted: logout (graphical-session.target stops, PartOf=) or
# `systemctl --user stop`; Requisite= refuses a start once the session target is gone.
Restart=always
RestartSec=100ms
TimeoutStopSec=5
# GF-081: Quickshell exits 255 when the compositor goes away first, which is how EVERY session end looks, but ALSO on "Failed
# to load configuration" and a missing path. So 255 stays a failure (SuccessExitStatus=255 would hide a broken shell from
# OnFailure=): the logout case is handled on the OnFailure side, where the sleep-lock gate (packaging/systemd/sleep-lock-gate)
# runs nothing once the compositor is gone (the session's Wayland socket or Hyprland instance directory no longer exists).
# GF-040, resource guard. Measured (docs/audits/final-1.0/benchmarks/real-session-samples.md): idle 0.25 to 0.33 % of a
# core, RSS 530 MB rising about 6 MB/h to 566 MB after 6 h; other real sessions peaked at 600 to 725 MB (gate P2 is 608 MB
# after 10 min); one historical runaway (0.4.0-1) reached about 118 % CPU and 9.5 GB. The limits are set far above any
# healthy figure and far below the runaway, so they never touch normal use:
#   MemoryHigh=1536M  soft ceiling, about 2x the worst healthy peak: above it the kernel reclaims and throttles the shell
#                     instead of letting it grow, and the pressure shows in `systemctl --user status`.
#   MemoryMax=3G      hard ceiling (a third of the runaway): the shell is killed and Restart=always brings it back in
#                     1 s; the lock lives in the security process and is not touched (ADR-0041 S2).
#   CPUQuota=150%     one and a half cores: a spinning shell cannot starve the compositor, while the Overview and
#                     Stage animations (a GUI thread plus the render thread) keep their headroom.
MemoryHigh=1536M
MemoryMax=3G
CPUQuota=150%
# No NoNewPrivileges/ProtectSystem here on purpose: the polkit agent (until S3) relies on the setuid helper
# polkit-agent-helper-1, which NoNewPrivileges would break (the lock's unix_chkpwd is the security process's since S2).

[Install]
WantedBy=graphical-session.target
