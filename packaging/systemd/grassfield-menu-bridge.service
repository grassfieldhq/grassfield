[Unit]
Description=Grassfield menu bridge (applications' menus in the menu bar)
Documentation=file:///usr/share/doc/grassfield/README.md
# ADR-0008, master-prompt §5.8: the only Grassfield daemon. It owns com.canonical.AppMenu.Registrar only while
# grassfield-shell reports that the compositor plugin serves org_kde_kwin_appmenu, and executes nothing but
# DBusMenu calls (GetLayout, AboutToShow, Event).
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target
# Only inside the Grassfield session, never in the Omarchy session (Qt/Chromium apps would hide their menus).
ConditionEnvironment=GRASSFIELD_SESSION=1

[Service]
Type=simple
Slice=session.slice
ExecStart=/usr/bin/grassfield-menu-bridge
Restart=on-failure
# Back-off between restarts (systemd >= 254): 1 s, growing to 30 s, so a crash loop cannot reach the start limit quickly.
RestartSec=1
RestartSteps=5
RestartMaxDelaySec=30
TimeoutStopSec=5
# Socket: $XDG_RUNTIME_DIR/grassfield/menu-bridge.sock (directory 0700, socket 0600). Kept across restarts.
RuntimeDirectory=grassfield
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077

# Hardening without namespaces: the session bus and its own Unix socket are all it needs. In a user unit, ProtectSystem=,
# ProtectHome=, PrivateTmp=, PrivateNetwork= and the other mount, network or kernel protections make systemd add
# PrivateUsers=self, and from that user namespace /proc/<pid>/exe, /proc/<pid>/ns/pid and /proc/<pid>/root of the
# applications cannot be read (as for grassfield-prompter.service, ADR-0035 decision 2c-6): every application would share
# one penalty bucket, every open-registered would be answered foreign-namespace (MB17) and every Ongoing1 Publish refused
# (MB18). tests/shell/session_services.sh keeps those options out of this unit; the seccomp-based ones below need no
# namespace.
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# No CapabilityBoundingSet= here: a user manager has no CAP_SETPCAP, so it can drop the bounding set only inside a user
# namespace, which this unit must not have (above); the line would make every start fail at step CAPABILITIES (status 218).
# NoNewPrivileges=yes already keeps the process from gaining any capability.
# Resource budget (ADR-0008: <= 20 MB RSS expected, idle CPU 0 %).
# Measured: idle ~15 MB; one 30 MB GetLayout reply peaked at 115 MB (the message is held several times while read).
# MemoryHigh throttles at 64 MB, MemoryMax = 256 MB leaves room for a reply of ~60 MB; the bridge refuses larger
# layouts after the first read and remembers an application that killed it (docs/specs/menu-bridge.md MB14).
MemoryHigh=64M
MemoryMax=256M
TasksMax=16

[Install]
WantedBy=graphical-session.target
