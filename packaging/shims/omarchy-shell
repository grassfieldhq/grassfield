#!/bin/sh
# Grassfield session stand-in for Omarchy's `omarchy-shell` IPC wrapper (D-12, GF-030). Installed to
# /usr/lib/grassfield/omarchy-shims/, a directory that comes first in PATH only in a Grassfield session (see
# omarchy-restart-shell next to this file).
#
# Omarchy's sleep-lock unit (omarchy-sleep-lock.service: a logind delay inhibitor and a PrepareForSleep monitor, whose
# omarchy-system-sleep-lock asks the shell to lock with `omarchy-shell lock lock` and polls `omarchy-shell lock status`
# until it reports {"secure": true}) is the fail-safe of the Grassfield session: grassfield-security.service starts it
# (OnFailure=) after every failure of the security process (ADR-0041 step 1, S2: the lock, idle and the sleep inhibitor
# live there; the UI's unit no longer holds an inhibitor). This stand-in answers those two calls with Grassfield's own lock
# (WlSessionLock + PamContext("omarchy-lock-password") in grassfield-security), never with another locker:
#   lock lock     when grassfield-security is not running, starts it again (reset-failed first: a process at its start
#                 limit is tried once more before sleep), waits for its IPC, then
#                 `qs ipc -p /usr/share/grassfield/shell/security.qml call lock lock`; also the UI's way to a stopped
#                 security process when it asks for a lock (shell/services/LockClient.qml)
#   lock status   {"secure": <Hyprland reports LOCK on every monitor>, "requested": <grassfield-security's crash-recovery
#                 marker says "locked">} (read-only: hyprctl -j monitors, the marker file)
# It also forwards Omarchy's update status (omarchy-update-status, called by `omarchy update` while its lock is held:
# `omarchy.system-update refresh|clear`) as a check request to Grassfield's Software Update (ADR-0033 d.5, U9): only the
# request goes, through a short `qs ipc` call; the shell's waiter checks once the lock is released, and nothing started
# here outlives the call (a long-lived child would inherit and keep Omarchy's lock).
# Every other call fails as Omarchy's wrapper does when its shell is not running ("-q": silent success). Nothing here
# unlocks. Test: tests/security/sleep_lock_units.sh.
# Quickshell's option variables are cleared: a stray QS_MANIFEST or QS_CONFIG_NAME made `qs ipc -p` exit 108 ("--path
# excludes --manifest"), so the sleep-lock fallback's lock request failed (re-review of bf9e280, M1; the list is the one
# grassfield-shell.service clears; tests/security/lock_request_env.sh).
unset QS_CONFIG_PATH QS_CONFIG_NAME QS_MANIFEST

quiet=0
if [ "${1:-}" = "-q" ]; then
  quiet=1
  shift
fi

fail() {
  [ "$quiet" = 1 ] && exit 0
  echo "$1" >&2
  exit 1
}

# grassfield-security's crash-recovery marker (shell/security/LockMachine.js markerName): "locked" once a lock was requested.
marker() {
  id=${HYPRLAND_INSTANCE_SIGNATURE:-${WAYLAND_DISPLAY:-default}}
  id=$(printf '%s' "$id" | tr -c 'A-Za-z0-9_.-' '_')
  cat "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/grassfield-lock-$id" 2>/dev/null
}

lock_lock() {
  case $(systemctl --user show --property=ActiveState --value grassfield-security.service 2>/dev/null) in
    active | activating | reloading)
      # An upgrade from a build before ADR-0041 S2 leaves the earlier security process running, which hosts no lock (its
      # `security state` answers "starting"): restarted, the new one hosts the lock and restores it from the marker (the opus
      # review of 77a0ceb3, MINOR-1). Anything else (an answer of S2, no answer yet) is left alone.
      if [ "$(timeout -k 0.2 2 qs ipc -p /usr/share/grassfield/shell/security.qml call security state 2>/dev/null)" = starting ]; then
        systemctl --user restart --no-block grassfield-security.service >/dev/null 2>&1
      fi
      ;;
    *)
      systemctl --user reset-failed grassfield-security.service >/dev/null 2>&1
      systemctl --user start --no-block grassfield-security.service >/dev/null 2>&1
      ;;
  esac
  # The caller bounds this with its own timeout (omarchy-system-sleep-lock: what is left of logind's window).
  tries=0
  while [ "$tries" -lt 100 ]; do
    out=$(qs ipc -p /usr/share/grassfield/shell/security.qml call lock lock 2>/dev/null) && case $out in
      ok | already-locked | refused:*)
        echo "$out"
        exit 0
        ;;
    esac
    tries=$((tries + 1))
    sleep 0.1
  done
  fail "grassfield-security is not running"
}

lock_status() {
  secure=false
  # Fail closed: secure only when the answer is exactly ONE JSON value, a non-empty ARRAY of monitors whose solitaryBlockedBy
  # is an ARRAY holding "LOCK". jq's index() on a string finds a substring, so a monitor answering a string such as
  # "UNLOCKED" read as locked; .[] walks an object's values as it walks an array; and without -s, `jq -e` decides on the
  # LAST of several values, so "[unlocked] [locked]" or "4294967296[locked]" read as locked (tests/fuzz/fuzz_helpers.py,
  # lock-status; the integrator's review of 265e6c7, major 1). Hyprland 0.56.2 always answers one array of objects with
  # an array; the checks cover a future shape.
  if hyprctl -j monitors 2>/dev/null | jq -e -s 'length == 1 and (.[0] | type == "array" and length > 0 and all(.[]; (.solitaryBlockedBy // []) | type == "array" and index("LOCK") != null))' >/dev/null 2>&1; then
    secure=true
  fi
  requested=false
  # "locked" or "locked sleeps=<n>" (shell/security/LockMachine.js markerLine).
  case $(marker) in
    locked | "locked sleeps="*) requested=true ;;
  esac
  printf '{"secure": %s, "requested": %s}\n' "$secure" "$requested"
}

update_check() {
  timeout -k 0.2 2 qs ipc -p /usr/share/grassfield/shell call update check omarchy >/dev/null 2>&1 || fail "grassfield-shell is not running"
}

case "${1:-} ${2:-}" in
  "lock lock") lock_lock ;;
  "lock status") lock_status ;;
  "omarchy.system-update refresh" | "omarchy.system-update clear") update_check ;;
  *) fail "omarchy-shell is not running (Grassfield session)" ;;
esac
