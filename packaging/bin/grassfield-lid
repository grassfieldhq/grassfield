#!/bin/bash
# Lid and clamshell handling of the Grassfield session (docs/audits/final-1.0/02-omarchy-compatibility.md §5.3).
#
#   grassfield-lid closed      the lid was closed (Hyprland switch bind, config/hypr/grassfield/system.lua)
#   grassfield-lid opened      the lid was opened
#   grassfield-lid reconcile   a monitor was added or removed, or the session started
#
# macOS model: with the lid closed and an external display connected, the computer keeps running on that display (the
# laptop panel is switched off and its windows move to the external display); with the lid closed and no external display
# it sleeps, and the screen is locked first. logind decides about suspend (HandleLidSwitchDocked defaults to ignore, so a
# docked lid does not suspend). On every lid close this script asks the security process to lock with `lock lid` (ADR-0041
# step 1, S2: the lock lives in grassfield-security.service, the instance /usr/share/grassfield/shell/security.qml); it
# decides (shell/security/lock/Lock.qml lockOnLid, LockMachine.lidShouldLock: no lock while a physical external display is
# active, i.e. clamshell mode; it locks also when logind does not suspend, D-4). This script only turns the laptop panel
# off or on for clamshell mode. Nothing here suspends or unlocks.
#
# When the security process does not answer (stopped, crashed, restarting) and no external display is connected, the lock
# is not dropped: Grassfield's `omarchy-shell` stand-in starts grassfield-security again and asks it to lock (follow-up N3;
# the lock stays grassfield-security's WlSessionLock + PamContext, no other locker). That matters when logind does not
# suspend on the lid (HandleLidSwitch=ignore or lock): nothing else would lock then.
#
# Test hooks (dev plumbing, ADR-0019): GRASSFIELD_LID_PROC (default /proc/acpi/button/lid), GRASSFIELD_DRM (default
# /sys/class/drm), GRASSFIELD_LID_LOCK (the lock command), GRASSFIELD_LID_FALLBACK (the stand-in), honoured only in a dev
# session (GRASSFIELD_DEV exactly "1" and GRASSFIELD_SESSION not "1"). Outside it a stray value is ignored: the lid always
# asks the installed shell, falls back to the installed stand-in and reads the real lid and display state, so the session
# environment cannot redirect or drop the lock request (follow-up of the re-review of bf9e280; a fake "external display
# connected" would have skipped the fallback). XDG_RUNTIME_DIR holds the marker and the lock file.

set -u
# The lock request must not be defeatable by the session's environment: a stray QS_MANIFEST or QS_CONFIG_NAME made
# `qs ipc -p` exit 108 ("--path excludes --manifest") and the lid did not lock (re-review of bf9e280, M1). The list is the
# one grassfield-shell.service clears (tests/security/lock_request_env.sh); the stand-in below inherits the cleared set.
unset QS_CONFIG_PATH QS_CONFIG_NAME QS_MANIFEST

LID_PROC=/proc/acpi/button/lid
DRM=/sys/class/drm
RUNTIME=${XDG_RUNTIME_DIR:-/tmp}
MARKER=$RUNTIME/grassfield-lid-internal-off
LOCKFILE=$RUNTIME/grassfield-lid.lock
LOCK_CMD="qs ipc -p /usr/share/grassfield/shell/security.qml call lock lid"
FALLBACK=/usr/lib/grassfield/omarchy-shims/omarchy-shell
if [[ ${GRASSFIELD_DEV:-} == 1 && ${GRASSFIELD_SESSION:-} != 1 ]]; then
  LID_PROC=${GRASSFIELD_LID_PROC:-$LID_PROC}
  DRM=${GRASSFIELD_DRM:-$DRM}
  LOCK_CMD=${GRASSFIELD_LID_LOCK:-$LOCK_CMD}
  FALLBACK=${GRASSFIELD_LID_FALLBACK:-$FALLBACK}
fi

# Ask the security process to lock (it decides about clamshell mode). Its answers: ok, already-locked, docked, refused: <why>.
lock_on_close() {
  local answer
  if answer=$($LOCK_CMD 2>/dev/null); then
    case $answer in
      ok | already-locked | docked | refused:*) return 0 ;;
    esac
  fi
  # No answer (or "Not ready to accept queries yet"): the security process is down or starting. Clamshell decides here
  # instead.
  external_connected && return 0
  # In the background: the panel handling must not wait for a restart (the stand-in waits up to ~10 s).
  [[ -x $FALLBACK ]] && setsid -f "$FALLBACK" lock lock >/dev/null 2>&1 </dev/null
  return 0
}

lid_closed() {
  local state
  for state in "$LID_PROC"/*/state; do
    [[ -r $state ]] || continue
    [[ $(<"$state") == *closed* ]] && return 0
  done
  return 1
}

# A connector of a built-in panel is eDP-N, LVDS-N or DSI-N (Hyprland uses the DRM connector names).
internal_connector() {
  local dir name
  for dir in "$DRM"/card*-*; do
    name=${dir##*/}
    name=${name#card*-}
    [[ $name =~ ^(eDP|LVDS|DSI)-[0-9A-Za-z]+$ ]] && { printf '%s\n' "$name"; return 0; }
  done
  return 1
}

external_connected() {
  local status name
  for status in "$DRM"/card*-*/status; do
    [[ -e $status ]] || continue
    name=${status%/status}
    name=${name##*/}
    [[ $name =~ -(eDP|LVDS|DSI)-[^/]+$ ]] && continue
    [[ $(<"$status") == connected ]] && return 0
  done
  return 1
}

reconcile() {
  local internal
  (
    flock -n 9 || exit 0
    if lid_closed && external_connected && internal=$(internal_connector); then
      if [[ ! -e $MARKER ]]; then
        : >"$MARKER"
        hyprctl eval "hl.monitor({ output = \"$internal\", disabled = true })" >/dev/null 2>&1 || rm -f "$MARKER"
      fi
    elif [[ -e $MARKER ]]; then
      # Back to the user's own monitors.lua (scale, position): a reload applies it again.
      rm -f "$MARKER"
      hyprctl reload >/dev/null 2>&1 || true
    fi
  ) 9>"$LOCKFILE"
}

case ${1:-} in
  closed)
    # First, before logind may suspend: the security process locks unless an external display is active (clamshell: the computer
    # keeps running and stays unlocked, as on macOS). Sent on every close, whatever /proc says (a lid that only reports
    # through the input switch still locks).
    lock_on_close
    reconcile
    ;;
  opened | reconcile)
    reconcile
    ;;
  *)
    echo "usage: grassfield-lid closed|opened|reconcile" >&2
    exit 2
    ;;
esac
