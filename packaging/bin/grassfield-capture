#!/usr/bin/python3 -I
# Grassfield's screenshots and screen recordings (ADR-0035 D-10, step 8; ADR-0045 OC-1). Bound by
# config/hypr/grassfield/system.lua (real session only): `grassfield-capture screen` (Shift-Cmd-3: every display, one picture
# each, as macOS saves them) and `grassfield-capture selection` (Shift-Cmd-4 and Print: a crosshair over the live screen; a drag
# picks an area, a click without a drag picks the window under the pointer, else the display, Esc cancels; a second press while
# the crosshair shows cancels it, as Omarchy's capture did). grim takes the picture, slurp draws the crosshair in Grassfield's
# colours (capture.* in ui/tokens/tokens.json, mirrored below; tests/shell/capture.sh holds them equal). Each file is named as
# on macOS ("Screenshot 2026-10-31 at 14.05.12.png", the next display's " (2)", translated) where Save to says (below; by default
# the Screenshots folder in the Pictures folder, never the Desktop unless chosen: owner 2026-11-07); the focused
# display's picture (or the selection) is copied to the clipboard, and a Grassfield notice shows it with "Open in Preview"
# (Preview is Grassfield's viewer, org.grassfield.Preview), which opens every picture of that capture. Nothing names an Omarchy
# shortcut; no tensaku. Standard library only; strings through tr() (gate I1: scripts/dev/check-i18n.py).
#
# The capture toolbar (Shift-Cmd-5, shell/capture) runs the same modes with its options, and a window mode:
#   grassfield-capture screen|window|selection [--save screenshots|desktop|documents|clipboard|preview] [--timer 0|5|10]
#                      [--pointer] [--output NAME (screen)] [--geometry "X,Y WxH" (window, selection)]
# The toolbar chooses on its own surface (macOS 27): the frame of Capture Selected Portion and the window clicked in Capture
# Selected Window come as --geometry (whole numbers, a positive size, wholly on one enabled display, or the usage, exit 2), the
# display clicked in Capture Entire Screen as --output (that display only; without it every display). Without --geometry the
# helper's crosshair chooses (the keys, and the toolbar's fallback): `window` is the crosshair restricted to the windows (slurp
# -r), a click picks the window drawn on top there. --save: the Screenshots folder in the Pictures folder (xdg-user-dir
# PICTURES; the folder named in the session's language, made on first use, an existing English "Screenshots" kept), the Desktop,
# the Documents folder (copied too), the clipboard only (no file, no notice, as macOS), or Preview (the picture is kept in the
# Screenshots folder, since Preview cannot save a document, and opened in Preview at once, no notice). Without --save (the keys)
# the toolbar's choice applies: capture.location of grassfield.json, as the shell reads it (stored_location). --timer: a
# countdown after the choice and before the picture; --pointer: grim draws the pointer (-c).
#   grassfield-capture record screen|selection [--save screenshots|desktop|documents|preview] [--timer 0|5|10] [--pointer]
#                             [--mic] [--output NAME (screen)] [--geometry "X,Y WxH" (selection)]
# records with gpu-screen-recorder (an Omarchy base package) and Omarchy's backend arguments (omarchy-capture-screenrecording:
# `-w <display> -s <size>` for a whole display, `-w WxH+X+Y` in logical coordinates for an area, `-k auto -f 60 -fm cfr
# -fallback-cpu-encoding yes`, the microphone as `-a default_input -ac aac`; never the desktop's sound, as macOS). `screen`
# records the display clicked or the toolbar's (--output), else the focused one; `selection` the toolbar's frame (--geometry)
# or the crosshair's choice (a whole display is recorded as that display). The movie is written to a hidden file of this
# helper's in the destination (the default: the Videos folder, xdg-user-dir VIDEOS) and then takes its name, "Screen Recording
# 2026-11-04 at 14.05.12.mp4" (the start time, translated), never replacing a file; a notice "Screen Recording" with "Open"
# (Preview plays it) follows. A recording with --save clipboard is not offered (a movie is not copied): it goes to the Videos
# folder. While a recording or a countdown runs this helper holds a lock and keeps its state in a private file,
# $XDG_RUNTIME_DIR/grassfield/capture-state.json (0600, by rename, in the 0700 folder of the capture notice), which the shell watches (its countdown and the menu bar's stop item):
#   {"v": 1, "phase": "idle" | "starting" | "selecting" | "countdown" | "recording", "kind": "shot" | "recording",
#    "pid", "start", "until" (ms since the epoch, countdown), "rect" {x, y, w, h} and "output" (where the capture is),
#    "recorder", "recorderStart" and "started" (ms, recording)}
#   grassfield-capture stop
# ends what that state names (the menu bar's stop item, Ctrl-Cmd-Esc, the session locking): SIGINT to the recorder this helper
# started (gpu-screen-recorder saves its file on SIGINT), recognised by its pid, its start time and its parent (this helper's
# pid and start time), never by name; during a choice or a countdown, SIGINT to that helper, which then captures nothing. A
# recorder still running STOP_SECONDS later is killed (Omarchy kills it after 5 s). Nothing starts while the session is
# locked: Hyprland runs none of these keys under the lock, the shell refuses the toolbar then, and this helper reads the lock
# itself (session_locked: the shell's crash-recovery marker, which says "locked" from the moment a lock is asked for, and
# Hyprland's displays blocked by "LOCK", as the omarchy-shell stand-in reads them) before a picture and before the recorder
# starts; a recording writes its state ("starting") at once, so that the shell stops one that becomes active under the lock,
# and the recording helper reads the marker every LOCK_POLL_SECONDS and ends the recording when the session locks, even
# without a shell.
# Once a picture is taken (saved, or copied alone), the shutter sound plays when Settings > Sound > "Play user
# interface sound effects" is on (ADR-0047 B-5: pw-play, at the alert volume, through the effects output).
import contextlib
import datetime
import fcntl
import json
import os
import re
import select
import shutil
import signal
import stat
import subprocess
import sys
import time

# capture.* of ui/tokens/tokens.json, as slurp takes them (#rrggbbaa): the veil over the screen, the selection's fill and
# border, the border's width in pixels. The boxes a click can pick (the windows, then the displays) are filled with the veil
# itself, so the veil stays even: slurp draws them with Cairo's SOURCE operator, which replaces the veil rather than darkening
# it twice, and the one under the pointer takes the selection's fill and border (review of step 8: displays left out of the
# boxes made slurp 1.5.0 cancel a click outside every window).
COLOURS = {"veil": "#0000002E", "selection": "#FFFFFF24", "border": "#FFFFFFE6"}
BORDER_WIDTH = 1
SLURP = ["slurp", "-b", COLOURS["veil"], "-s", COLOURS["selection"], "-c", COLOURS["border"], "-B", COLOURS["veil"],
         "-w", str(BORDER_WIDTH)]
# A selection smaller than this many square pixels is a click: slurp answered a point (a newer slurp, outside every box) or
# a hand that moved a pixel or two; the window on top there, else the display.
CLICK_AREA = 20
# Hyprland 0.56's clients JSON: "fullscreen" is the window's mode, 1 maximized (Zoom), 2 fullscreen (FullscreenController.hpp);
# either covers the other windows of its workspace, except the pinned ones and those allowed over it.
FULLSCREEN = 2
WAIT_SECONDS = 120
# The previous capture's notice is closed before a capture, and the picture is taken at least this long after: the shell
# unmaps the banner's window at once, and Hyprland fades a layer out in at most its global speed, 300 ms
# (config/hypr/grassfield/looknfeel.lua), so a picture never shows the notice of the one before. The crosshair does not wait.
BANNER_GONE_SECONDS = 0.5
PREVIEW = "org.grassfield.Preview.desktop"
PREVIEW_ICON = "org.grassfield.Preview"
# The toolbar's options (shell/capture/CaptureModel.js builds the same argv).
MODES = ("screen", "window", "selection")
RECORD_MODES = ("screen", "selection")
SAVE_TO = ("screenshots", "desktop", "documents", "clipboard", "preview")
TIMERS = ("0", "5", "10")
# Save to without --save (the keys): capture.location of grassfield.json, else the older capture.saveTo's documents, clipboard and
# preview (its desktop, the old default, reads as the new one), else the Screenshots folder (shell/store/CaptureLocation.js).
DEFAULT_SAVE = "screenshots"
KEPT_FROM_SAVE_TO = ("documents", "clipboard", "preview")
# The shell hides its countdown when the time is up, and Hyprland drops the countdown's layer at once (no_anim,
# config/hypr/grassfield/windows.lua); the picture (or the recording) waits this long after, as for the last notice.
COUNTDOWN_GONE_SECONDS = 0.5
# A recorder still running this long after its SIGINT is killed (its file may then be cut short).
STOP_SECONDS = 10
# gpu-screen-recorder's arguments, as omarchy-capture-screenrecording (v4.0.6 and v4.5.0, the same; 4.5.0 adds a wf-recorder fallback for machines without gpu-screen-recorder, which are not x86_64) gives them; Omarchy records a display at its
# own size up to 4K, at 4K above.
RECORDER = ["-k", "auto", "-f", "60", "-fm", "cfr", "-fallback-cpu-encoding", "yes"]
RECORDER_MAX = (3840, 2160)
OUTPUT_NAME = re.compile(r"[A-Za-z0-9._-]{1,64}")
# The toolbar's --geometry, "X,Y WxH" in the compositor's logical coordinates, whole numbers (as slurp prints it).
GEOMETRY_ARG = re.compile(r"(-?[0-9]{1,6}),(-?[0-9]{1,6}) ([0-9]{1,6})x([0-9]{1,6})")
# While recording, the shell's lock marker is read this often (seconds): the session locking ends the recording.
LOCK_POLL_SECONDS = 0.5

TITLE = "Screenshot"
NAME = "Screenshot %(date)s at %(time)s"
BODY = "Saved to the Desktop and copied."
BODY_DOCUMENTS = "Saved to Documents and copied."
# The default place: the folder by its own name (the Screenshots folder in Pictures, the Videos folder for a recording).
BODY_FOLDER = "Saved to %(folder)s and copied."
OPEN = "Open in Preview"
REC_TITLE = "Screen Recording"
REC_NAME = "Screen Recording %(date)s at %(time)s"
REC_DESKTOP = "Saved to the Desktop."
REC_DOCUMENTS = "Saved to Documents."
REC_FOLDER = "Saved to %(folder)s."
REC_FAILED = "The screen recording could not be saved."
REC_OPEN = "Open"
# The folder screenshots go to by default, in the Pictures folder, named in the session's language when it is made (an existing
# folder of the English name is used as it is, so that changing the language does not start a second one).
SCREENSHOTS = "Screenshots"
CATALOG = {
    "fr": {
        TITLE: "Capture d’écran",
        NAME: "Capture d’écran %(date)s à %(time)s",
        BODY: "Enregistrée sur le Bureau et copiée.",
        BODY_DOCUMENTS: "Enregistrée dans Documents et copiée.",
        BODY_FOLDER: "Enregistrée dans %(folder)s et copiée.",
        OPEN: "Ouvrir dans la Visionneuse",
        REC_TITLE: "Enregistrement de l’écran",
        REC_NAME: "Enregistrement de l’écran %(date)s à %(time)s",
        REC_DESKTOP: "Enregistré sur le Bureau.",
        REC_DOCUMENTS: "Enregistré dans Documents.",
        REC_FOLDER: "Enregistré dans %(folder)s.",
        REC_FAILED: "L’enregistrement de l’écran n’a pas pu être sauvegardé.",
        REC_OPEN: "Ouvrir",
        SCREENSHOTS: "Captures d’écran",
    },
