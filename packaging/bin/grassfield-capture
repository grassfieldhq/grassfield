# The shutter (branding/sounds, installed by grassfield-desktop) and the settings it follows (ADR-0047 B-3), read with the
# settings contract's rules (ADR-0020: a number is clamped, any other invalid value is the default; the file is opened only
# when it is a regular file of at most 1 MiB, never waited on). ui/Grassfield/Ui/SoundEffects.js is the shell's twin.
SHUTTER = "/usr/share/sounds/grassfield/stereo/screen-capture.wav"
SOUND_DEFAULTS = {"uiEffects": True, "alertVolume": 0.75, "effectsOutput": ""}
NODE_NAME = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.:@+-]{0,254}")


class UnsafeJson(ValueError):
    """A file the shell and Settings read as their defaults (ui/Grassfield/Ui/JsonSafety.js)."""


# JsonSafety.js numberReason: an integer-valued number token that JavaScript cannot keep exactly.
NUMBER_TOKEN = re.compile(r"(-?)([0-9]+)(?:\.([0-9]*))?(?:[eE]([-+]?[0-9]+))?")
SAFE_INTEGER = 9007199254740991


def unsafe_number(token):
    m = NUMBER_TOKEN.fullmatch(token)
    if not m:
        return False
    frac = m[3] or ""
    digits = (m[2] + frac).lstrip("0")
    exp = (int(m[4]) if m[4] else 0) - len(frac)
    if not digits:
        return False
    trimmed = digits.rstrip("0")
    exp += len(digits) - len(trimmed)
    digits = trimmed
    if exp < 0:
        return False
    length = len(digits) + exp
    if length > 16:
        return (m[3] is None and m[4] is None) or len(digits) >= 16
    return length == 16 and int(digits + "0" * exp) > SAFE_INTEGER


def safe_pairs(pairs):
    # JsonSafety.js unsafeReason: a key twice in one object, or an integer-like key, makes the whole file unsafe.
    out = {}
    for key, value in pairs:
        if key in out or re.fullmatch(r"0|[1-9][0-9]*", key):
            raise UnsafeJson(key)
        out[key] = value
    return out


def checked_number(token, kind):
    if unsafe_number(token):
        raise UnsafeJson(token)
    return kind(token)


def settings_group(name):
    # One group of grassfield.json ({} when the file, or the group, cannot be used). A file the shell would not read (a duplicate
    # key, an integer beyond 2^53, an integer-like key: JsonSafety.js) reads as the defaults here too, as SettingsStore reads it.
    home = os.environ.get("GRASSFIELD_CONFIG_HOME") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config"), "grassfield")
    group = None
    try:
        fd = os.open(os.path.join(home, "grassfield.json"), os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        with os.fdopen(fd, "rb") as f:
            st = os.fstat(f.fileno())
            if stat.S_ISREG(st.st_mode) and st.st_size <= 1 << 20:
                data = json.loads(f.read(1 << 20).decode("utf-8"), object_pairs_hook=safe_pairs,
                                  parse_int=lambda t: checked_number(t, int), parse_float=lambda t: checked_number(t, float))
                group = data.get(name) if isinstance(data, dict) else None
    except (OSError, ValueError):
        group = None
    return group if isinstance(group, dict) else {}


def stored_location():
    # Save to for the keys (no --save): the toolbar's choice as the shell reads it (shell/store/CaptureLocation.js).
    capture = settings_group("capture")
    if "location" in capture:
        return capture["location"] if capture["location"] in SAVE_TO else DEFAULT_SAVE
    saved = capture.get("saveTo")
    return saved if saved in KEPT_FROM_SAVE_TO else DEFAULT_SAVE


def sound_settings():
    out = dict(SOUND_DEFAULTS)
    sound = settings_group("sound")
    if not sound:
        return out
    if isinstance(sound.get("uiEffects"), bool):
        out["uiEffects"] = sound["uiEffects"]
    volume = sound.get("alertVolume")
    if isinstance(volume, (int, float)) and not isinstance(volume, bool) and volume == volume and abs(volume) != float("inf"):
        out["alertVolume"] = max(0.0, min(1.0, float(volume)))
    output = sound.get("effectsOutput")
    if isinstance(output, str) and (output == "" or NODE_NAME.fullmatch(output)):
        out["effectsOutput"] = output
    return out


def shutter():
    s = sound_settings()
    player = shutil.which("pw-play")
    if not s["uiEffects"] or s["alertVolume"] <= 0 or player is None:
        return
    # The level on the volume keys' cubic scale; a target that is not connected falls back to the default output (WirePlumber).
    argv = [player, "--media-role", "Notification", "--volume", "%.3f" % s["alertVolume"] ** 3]
    if s["effectsOutput"]:
        argv += ["--target", s["effectsOutput"]]
    try:
        subprocess.Popen(argv + ["--", SHUTTER], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,  # i18n-ignore (a file path)
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


class Cancelled(Exception):
    """A choice or a countdown ended by `stop` (SIGINT) or the session ending (SIGTERM): nothing is captured."""


def tr(text):
    lang = next((os.environ[v] for v in ("GRASSFIELD_LANG", "LC_ALL", "LC_MESSAGES", "LANG") if os.environ.get(v)), "")
    return CATALOG.get(lang.partition("_")[0].partition(".")[0].partition("@")[0], {}).get(text, text)


def run(argv, timeout=5, **kw):
    try:
        return subprocess.run(argv, capture_output=True, timeout=timeout, **kw)
    except (OSError, subprocess.SubprocessError):
        return None


def hyprctl(what):
    r = run(["hyprctl", "-j", what])
    if r is None or r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


def logical(m):
    # A display's place and logical size ({x, y, w, h}), as grim and slurp take them.
    try:
        scale = float(m["scale"])
        w, h = int(m["width"]), int(m["height"])
        if int(m.get("transform", 0)) % 2:
            w, h = h, w
        return {"x": int(m["x"]), "y": int(m["y"]), "w": round(w / scale), "h": round(h / scale)}
    except (KeyError, TypeError, ValueError, ZeroDivisionError):
        return None


def displays(monitors):
    # The enabled displays, the focused one first, then in Hyprland's order: (name, rectangle).
    out = []
    for m in monitors or []:
        if isinstance(m, dict) and not m.get("disabled") and isinstance(m.get("name"), str):
            r = logical(m)
            if r:
                out.append((m["name"], r, bool(m.get("focused"))))
    return [(n, r) for n, r, f in sorted(out, key=lambda d: not d[2])]


def windows(monitors):
    # What a click can pick: the windows on the displays' shown workspaces, as {rect, full, over, pinned, floating, order},
    # in Hyprland's stacking order (its clients list goes from the bottom up: a new window is added at the end, a raised one
    # moved there). On a workspace with a fullscreen or zoomed window, that window and the windows drawn over it (pinned, or
    # allowed over it: Hyprland clears that for the others when a window goes fullscreen), never those behind.
    shown, special = set(), set()
    for m in monitors or []:
        if not isinstance(m, dict) or m.get("disabled"):
            continue
        for key in ("activeWorkspace", "specialWorkspace"):
            ws = m.get(key)
            if isinstance(ws, dict) and isinstance(ws.get("id"), int) and ws["id"] != 0:
                shown.add(ws["id"])
                if key == "specialWorkspace":
                    special.add(ws["id"])  # a named workspace's id is negative too: only the shown special ones count
    found = []
    for c in hyprctl("clients") or []:
        try:
            if not c["mapped"] or c["hidden"] or c["workspace"]["id"] not in shown:
                continue
            (x, y), (w, h) = c["at"], c["size"]
            if w > 0 and h > 0:
                mode = c.get("fullscreen")
                found.append({"ws": c["workspace"]["id"], "special": c["workspace"]["id"] in special,
                              "full": isinstance(mode, int) and 1 <= mode <= FULLSCREEN,
                              "over": c.get("pinned") is True or c.get("allowedOverFullscreen") is True,
                              "pinned": c.get("pinned") is True, "floating": c.get("floating") is True, "order": len(found),
                              "rect": {"x": int(x), "y": int(y), "w": int(w), "h": int(h)}})
        except (KeyError, TypeError, ValueError):
            continue
    covered = {e["ws"] for e in found if e["full"]}
    return [e for e in found if e["ws"] not in covered or e["full"] or e["over"]]


def contains(r, px, py):
    return r["x"] <= px < r["x"] + r["w"] and r["y"] <= py < r["y"] + r["h"]


def on_top(wins, px, py):
    # The window drawn on top at a point, as Hyprland draws them (render/Renderer.cpp, renderWorkspaceWindows and
    # renderWorkspaceWindowsFullscreen): pinned windows above everything, then a special workspace's windows, a window over
    # a fullscreen one above it, floating windows above tiled ones, then the later in its clients list. Where a fullscreen
    # or zoomed window is, only the windows of its own workspace (and pinned ones) are drawn over it: a window of another
    # display's workspace that reaches there is under it. None when no window is there.
    under = [e for e in wins if contains(e["rect"], px, py)]
    full = [e["ws"] for e in under if e["full"]]
    if full:
        under = [e for e in under if e["pinned"] or e["ws"] in full or e["special"]]
    if not under:
        return None
    return max(under, key=lambda e: (e["pinned"], e["special"], not e["full"], e["floating"], e["order"]))["rect"]


def topmost(wins, sel):
    # A click on a window: slurp answers the smallest box under the pointer, which may be a window behind a larger one in
    # front. The window drawn on top under the pointer is taken instead. The pointer is read after slurp has ended: when it
    # has left slurp's box meanwhile (or cannot be read), slurp's answer stands.
    if not any(e["rect"] == sel for e in wins):
        return sel
    pos = hyprctl("cursorpos")
    try:
        px, py = int(pos["x"]), int(pos["y"])
    except (KeyError, TypeError, ValueError):
        return sel
    if not contains(sel, px, py):
        return sel
    return on_top(wins, px, py) or sel


def parse_geometry(text):
    m = re.fullmatch(r"(-?[0-9]{1,6}),(-?[0-9]{1,6}) ([0-9]{1,6})x([0-9]{1,6})", text.strip())
    return {"x": int(m[1]), "y": int(m[2]), "w": int(m[3]), "h": int(m[4])} if m else None


def snapped(sel, wins, screens):
    # A click slurp answered as a tiny area (a point, or a hand that moved a pixel or two): the window on top there, else the
    # display there, else nothing. A larger area is the user's own.
    if sel["w"] * sel["h"] >= CLICK_AREA:
        return sel
    window = on_top(wins, sel["x"], sel["y"])
    if window:
        return window
    return next((r for r in screens if contains(r, sel["x"], sel["y"])), None)


def geometry_text(r):
    return "%d,%d %dx%d" % (r["x"], r["y"], r["w"], r["h"])


def on_one_display(sel, monitors):
    # The toolbar's --geometry: a positive size wholly on one enabled display (its logical rectangle); else None.
    if sel is None or sel["w"] <= 0 or sel["h"] <= 0:
        return None
    for _, r in displays(monitors):
        if r["x"] <= sel["x"] and r["y"] <= sel["y"] and sel["x"] + sel["w"] <= r["x"] + r["w"] \
                and sel["y"] + sel["h"] <= r["y"] + r["h"]:
            return sel
    return None


def lock_requested():
    # grassfield-shell's crash-recovery marker ($XDG_RUNTIME_DIR/grassfield-lock-<instance>, shell/security/LockMachine.js
    # markerName and markerLine; read the same way by the omarchy-shell stand-in): "locked" or "locked sleeps=<n>" from the
    # moment a lock is requested until the unlock, also while the shell is restarting.
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not os.path.isabs(runtime):
        return False
    instance = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") or os.environ.get("WAYLAND_DISPLAY") or "default"
    path = os.path.join(runtime, "grassfield-lock-" + re.sub(r"[^A-Za-z0-9_.-]", "_", instance))
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as f:
            words = f.read(64).split()
    except OSError:
        return False
    return bool(words) and words[0] == b"locked"


def session_locked(monitors=None):
    # The session is locked, or a lock was asked for: the shell's marker, or Hyprland's own answer (a display blocked by
    # "LOCK", as the omarchy-shell stand-in reads it). No capture starts then (ADR-0045 OC-1: nothing is recorded behind the
    # lock, even when the lock came between the toolbar's action and this helper).
    if lock_requested():
        return True
    for m in (monitors if monitors is not None else hyprctl("monitors")) or []:
        blocked = m.get("solitaryBlockedBy") if isinstance(m, dict) else None
        if isinstance(blocked, list) and "LOCK" in blocked:
            return True
    return False


def user_dir(key, fallback):
    # One of the user's folders as the shell finds the Desktop (shell/desktop/DesktopFiles.qml): xdg-user-dir's answer for
    # `key` (DESKTOP, DOCUMENTS, PICTURES, VIDEOS), else ~/<fallback>; never the home folder itself or the root.
    home = os.path.expanduser("~")
    r = run(["xdg-user-dir", key])
    path = os.fsdecode(r.stdout).strip() if r is not None and r.returncode == 0 else ""
    if not path or not os.path.isabs(path) or os.path.realpath(path) in ("/", os.path.realpath(home)):
        path = os.path.join(home, fallback)
    try:
        os.makedirs(path, exist_ok=True)
    except OSError:
        return None
    return path


def desktop():
    return user_dir("DESKTOP", "Desktop")


def screenshots():
    # The Screenshots folder in the Pictures folder: one already there under any of its names (the session's language first, then
    # English and every translation of the catalog, so that changing the language never starts a second folder), else the
    # session's language's, made now. A name taken by something that is not a folder: the Pictures folder itself.
    pictures = user_dir("PICTURES", "Pictures")
    if pictures is None:
        return None
    names = []
    for name in [tr(SCREENSHOTS), SCREENSHOTS] + [table.get(SCREENSHOTS, "") for table in CATALOG.values()]:
        if name and name not in names:
            names.append(name)
    for name in names:
        path = os.path.join(pictures, name)
        if os.path.isdir(path) and not os.path.islink(path):
            return path
    path = os.path.join(pictures, names[0])
    try:
        os.mkdir(path)
    except FileExistsError:
        return path if os.path.isdir(path) and not os.path.islink(path) else pictures
    except OSError:
        return pictures
    return path


def destination(save, record=False):
    # Where a capture's file goes: the Screenshots folder (a recording: the Videos folder) unless the Desktop or Documents was
    # chosen; Preview keeps its file in the default place too, and a recording asked for the clipboard goes there.
    if save == "desktop":
        return desktop()
    if save == "documents":
        return user_dir("DOCUMENTS", "Documents")
    return user_dir("VIDEOS", "Videos") if record else screenshots()


def saved_note(save, folder, record=False):
    # The notice's sentence naming where the file went: the Desktop, Documents, else the folder by its own name.
    if save == "desktop":
        return tr(REC_DESKTOP if record else BODY)
    if save == "documents":
        return tr(REC_DOCUMENTS if record else BODY_DOCUMENTS)
    return tr(REC_FOLDER if record else BODY_FOLDER) % {"folder": os.path.basename(folder.rstrip("/"))}


def reserve(folder, prefix, ext):
    # A hidden file of this helper's in the folder (made here, O_EXCL, never a link): what grim or the recorder writes before
    # the file takes its name, so that the folder never shows a picture or a movie being written. None when it cannot be made.
    for _ in range(10):
        candidate = os.path.join(folder, ".%s-%s%s" % (prefix, os.urandom(8).hex(), ext))
        try:
            os.close(os.open(candidate, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644))
            return candidate
        except FileExistsError:
            continue
        except OSError:
            return None
    return None


def publish(folder, stem, ext, tmp):
    # The hidden file takes the first free name: "<stem><ext>", then " (2)" and on, linked so that no other file is ever
    # replaced. Returns the path, or None. The hidden file stays (the caller removes it).
    for n in range(1, 100):
        path = os.path.join(folder, stem + (ext if n == 1 else " (%d)%s" % (n, ext)))
        try:
            os.link(tmp, path)
            return path
        except FileExistsError:
            continue
        except OSError:
            # A file system without hard links (a Desktop on FAT): a new file of that name, then a copy; a copy that
            # fails (a full disk) leaves no file behind.
            try:
                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
            except FileExistsError:
                continue
            except OSError:
                return None
            try:
                with os.fdopen(fd, "wb") as out, open(tmp, "rb") as src:
                    shutil.copyfileobj(src, out)
            except BaseException:
                # A full disk, or a signal (SIGTERM is SystemExit here): no partial file stays.
                with contextlib.suppress(OSError):
                    os.unlink(path)
                raise
            return path
    return None


def save_picture(folder, stem, grim):
    # grim writes a hidden file of this helper's in the folder, which then takes the first free name (publish). Returns the
    # path, or None (nothing left behind).
    tmp = reserve(folder, "grassfield-capture", ".png")
    if tmp is None:
        return None
    try:
        r = run(grim + [tmp], timeout=30)
        if r is None or r.returncode != 0 or os.path.getsize(tmp) == 0:
            return None
        return publish(folder, stem, ".png", tmp)
    except OSError:
        return None
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def selecting(argv):
    # This helper's slurp running (its exact command line, Grassfield's colours): a second press cancels the crosshair; any
    # other slurp of the user's (a portal's, a script's) is left alone.
    line = " ".join(argv)
    if not re.fullmatch(r"[A-Za-z0-9# -]+", line):
        return False
    r = run(["pkill", "-u", str(os.getuid()), "-f", "-x", line])
    return r is not None and r.returncode == 0


def crosshair(windows_only):
    # slurp as this helper runs it: the window mode restricts the choice to the boxes it is given (the windows).
    return SLURP + ["-r"] if windows_only else SLURP


def choose(monitors, windows_only=False):
    wins = windows(monitors)
    screens = [rect for _, rect in displays(monitors)]
    boxes = [e["rect"] for e in wins] + ([] if windows_only else screens)
    r = run(crosshair(windows_only), timeout=3600, input="".join(geometry_text(b) + "\n" for b in boxes).encode())
    if r is None or r.returncode != 0:
        return None  # Esc, or cancelled by a second press
    sel = parse_geometry(r.stdout.decode("utf-8", "replace"))
    if sel is None:
        return None
    if windows_only:
        # Only a window: slurp answered one of the boxes, and the window drawn on top under the pointer is taken.
        picked = topmost(wins, sel)
        return picked if any(e["rect"] == picked for e in wins) else None
    return snapped(topmost(wins, sel), wins, screens)


def runtime_folder():
    # $XDG_RUNTIME_DIR/grassfield: the user's own (0700, not a link), as the share picker's; None when it cannot be had.
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not os.path.isabs(runtime):
        return None
    folder = os.path.join(runtime, "grassfield")
    try:
        os.makedirs(folder, mode=0o700, exist_ok=True)
        st = os.lstat(folder)
    except OSError:
        return None
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
        return None
    return folder


def notice_file():
    # $XDG_RUNTIME_DIR/grassfield/capture-notice: the pid and start time of the notify-send showing the last capture's
    # notice.
    folder = runtime_folder()
    return os.path.join(folder, "capture-notice") if folder else None


def stat_fields(pid):
    # The fields of /proc/<pid>/stat after the command name in parentheses (field 3 is the first), or None.
    try:
        with open("/proc/%d/stat" % pid, "rb") as f:
            return f.read().rpartition(b")")[2].split()
    except OSError:
        return None


def started(pid):
    # A process's start time (field 22 of /proc/<pid>/stat), or None.
    try:
        return int(stat_fields(pid)[19])
    except (TypeError, ValueError, IndexError):
        return None


def parent(pid):
    # A process's parent (field 4 of /proc/<pid>/stat), or None.
    try:
        return int(stat_fields(pid)[1])
    except (TypeError, ValueError, IndexError):
        return None


def own(pid, start):
    # The process `pid` is still the one recorded (its start time) and this user's.
    try:
        return start is not None and started(pid) == start and os.stat("/proc/%d" % pid).st_uid == os.getuid()
    except OSError:
        return False


# ---- the capture state (the toolbar's countdown and recording, read by the shell) ----

def state_path():
    folder = runtime_folder()
    return os.path.join(folder, "capture-state.json") if folder else None


def write_state(state):
    # By rename: the shell never reads half a file. A state that cannot be written is left as it was (the shell then shows
    # nothing of this capture).
    path = state_path()
    if path is None:
        return
    tmp = "%s.%d.tmp" % (path, os.getpid())
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(dict({"v": 1}, **state)) + "\n")
        os.replace(tmp, path)
    except OSError:
        with contextlib.suppress(OSError):
            os.unlink(tmp)


def read_state():
    path = state_path()
    if path is None:
        return {}
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd) as f:
            state = json.loads(f.read(4096))
    except (OSError, ValueError):
        return {}
    return state if isinstance(state, dict) else {}


def take_lock():
    # The capture lock (one recording or countdown at a time): held, as an open file, until this helper ends. None when another
    # helper holds it, or without a private runtime folder.
    folder = runtime_folder()
    if folder is None:
        return None
    try:
        fd = os.open(os.path.join(folder, "capture-lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        return None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


def me():
    pid = os.getpid()
    return {"pid": pid, "start": started(pid)}


def countdown(seconds, rect, output, kind, lock):
    # The timer: the shell shows the seconds left over `rect` while the state says so (only with the lock: without it another
    # capture owns the state, and this countdown runs unseen). Interrupted by SIGINT or SIGTERM (Cancelled).
    until = time.time() + seconds
    if lock is not None:
        write_state(dict(me(), phase="countdown", kind=kind, until=int(until * 1000), rect=rect, output=output))
    while True:
        left = until - time.time()
        if left <= 0:
            break
        time.sleep(min(left, 0.25))
    if lock is not None and kind == "shot":
        write_state({"phase": "idle"})
    time.sleep(COUNTDOWN_GONE_SECONDS)


def close_previous():
    # The last capture's notice goes before this capture (macOS: the thumbnail of the last screenshot is put away), so its
    # banner is in no picture. Only the notify-send this helper started is told to close: the process is held by a pidfd,
    # then it must still be the one recorded (its start time), this user's, notify-send with `-p`. Returns the time from which
    # the picture may be taken (now when there was nothing to close).
    path = notice_file()
    if path is None:
        return time.monotonic()
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd) as f:
            pid, start = (int(v) for v in f.read(64).split())
        handle = os.pidfd_open(pid)
    except (OSError, ValueError):
        return time.monotonic()
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            argv = f.read().split(b"\0")
        if (started(pid) != start or os.stat("/proc/%d" % pid).st_uid != os.getuid() or argv[0] != b"notify-send"
                or b"-p" not in argv):
            return time.monotonic()
        signal.pidfd_send_signal(handle, signal.SIGINT)
        select.select([handle], [], [], 1.0)  # readable once it has ended
    except OSError:
        return time.monotonic()
    finally:
        os.close(handle)
    return time.monotonic() + BANNER_GONE_SECONDS


def remember(pid):
    path = notice_file()
    start = started(pid)
    if path is None or start is None:
        return
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write("%d %d\n" % (pid, start))
    except OSError:
        pass


def notify(paths, title_key=TITLE, body_key=BODY, label_key=OPEN, picture=True):
    # The notice with the picture (a recording's shows Preview's icon); a click or its button opens the capture's files in
    # Preview. It is the shell's ordinary banner (its own time on screen, then the Notification Center); this helper waits for
    # the click at most WAIT_SECONDS, then asks notify-send to close the notice (SIGINT: notify-send closes the one it
    # showed), since its button would do nothing once this helper has ended. No path: a notice without a button.
    hints = ["-h", "string:image-path:" + paths[0]] if paths and picture else []
    actions = ["-A", "default=" + tr(label_key), "-A", "open=" + tr(label_key)] if paths else []
    argv = (["notify-send", "-a", tr(title_key), "-i", PREVIEW_ICON] + hints + ["-p", "-w"] + actions
            + ["--", tr(title_key), tr(body_key)])
    if not shutil.which("notify-send"):
        image = "{'image-path': <%s>}" % json.dumps(paths[0]) if paths and picture else "@a{sv} {}"
        run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications", "--object-path",
             "/org/freedesktop/Notifications", "--method", "org.freedesktop.Notifications.Notify", tr(title_key), "0",
             PREVIEW_ICON, tr(title_key), tr(body_key), "[]", image, "-1"], timeout=10)
        return
    try:
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        return
    out = b""
    try:
        # The pid is recorded once notify-send has printed the notice's id: from then on SIGINT closes its notice (before, it
        # would only end it, leaving the notice up).
        until = time.monotonic() + WAIT_SECONDS
        while b"\n" not in out and time.monotonic() < until:
            if select.select([proc.stdout], [], [], 0.1)[0]:
                chunk = os.read(proc.stdout.fileno(), 4096)
                if not chunk:
                    break
                out += chunk
        if b"\n" in out:
            remember(proc.pid)
        rest, _ = proc.communicate(timeout=max(0.1, until - time.monotonic()))
        out += rest or b""
    except subprocess.TimeoutExpired:
        pass
    finally:
        # Unanswered in time, or this helper told to end (SIGTERM): notify-send closes its notice and ends with it.
        if proc.poll() is None:
            proc.send_signal(signal.SIGINT)
            try:
                proc.communicate(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.communicate()
    if proc.returncode == 0 and set(out.decode("utf-8", "replace").split()[1:]) & {"default", "open"}:
        open_with(PREVIEW, paths)


def open_with(desktop_id, paths):
    # As the Dock starts an app (uwsm-app: its own app scope), from a transient unit of the user manager; without uwsm (a
    # session started another way) Preview's own command.
    launcher = shutil.which("uwsm-app")
    app = [launcher, "--", desktop_id] + paths if launcher else ["grassfield-preview"] + paths
    run(["systemd-run", "--user", "--collect", "--quiet", "--"] + app, timeout=30)


def copy_png(data):
    # wl-copy stays behind to serve the clipboard: none of its output is waited for.
    try:
        subprocess.run(["wl-copy", "--type", "image/png"], input=data, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                       timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def shot(opts):
    # A screenshot: the screen (every display), a window or a selection, then the toolbar's timer, then the picture.
    mode, save = opts["mode"], opts["save"]
    pointer = ["-c"] if opts["pointer"] else []
    monitors = hyprctl("monitors")
    if mode == "screen":
        screens = displays(monitors)
        if opts["output"]:
            # The display clicked in the toolbar's Capture Entire Screen mode, and only it.
            screens = [s for s in screens if s[0] == opts["output"]]
        shots = [["grim", "-o", name] + pointer for name, _ in screens]
        if not shots:
            return 1
        ready = close_previous()
        area, output = screens[0][1], screens[0][0]
    elif opts["geometry"] is not None:
        # The area chosen on the toolbar's own surface (its frame, the window clicked): no crosshair.
        sel = on_one_display(opts["geometry"], monitors)
        if sel is None:
            sys.stderr.write("grassfield-capture: --geometry is not on one display\n")
            return 2
        ready = close_previous()
        shots = [["grim", "-g", geometry_text(sel)] + pointer]
        area, output = sel, ""
    else:
        if selecting(crosshair(mode == "window")):
            return 0
        ready = close_previous()  # the crosshair shows at once; the picture waits for the last notice to be gone
        sel = choose(monitors, mode == "window")
        if sel is None:
            return 0
        shots = [["grim", "-g", geometry_text(sel)] + pointer]
        area, output = sel, ""
    if opts["timer"]:
        lock = take_lock()
        try:
            countdown(opts["timer"], area, output, "shot", lock)
        except BaseException:
            if lock is not None:
                write_state({"phase": "idle"})
            raise
        finally:
            if lock is not None:
                os.close(lock)
    time.sleep(max(0.0, ready - time.monotonic()))
    if session_locked():
        return 1  # the session locked meanwhile: no picture of what the lock covers
    if save == "clipboard":
        # The clipboard only (macOS: no file, no thumbnail): the focused display's picture, or the choice.
        r = run(shots[0] + ["-"], timeout=30)
        if r is None or r.returncode != 0 or not r.stdout:
            return 1
        shutter()
        copy_png(r.stdout)
        return 0
    folder = destination(save)
    if folder is None:
        return 1
    now = datetime.datetime.now()
    stem = tr(NAME) % {"date": now.strftime("%Y-%m-%d"), "time": now.strftime("%H.%M.%S")}
    paths = [p for p in (save_picture(folder, stem, grim) for grim in shots) if p]
    if not paths:
        return 1
    shutter()
    if save == "preview":
        open_with(PREVIEW, paths)
        return 0
    try:
        with open(paths[0], "rb") as f:
            copy_png(f.read())
    except OSError:
        pass
    notify(paths, TITLE, saved_note(save, folder), OPEN)
    return 0


# The recorder this helper started, and whether a signal came while it was being started (record()).
RECORDING = {"proc": None, "starting": False, "pending": False}


def on_record_signal(signum, frame):
    # While the recorder runs, SIGINT (stop, through this helper) and SIGTERM (the session ending) are passed on to it as
    # SIGINT: it saves its file and ends, and this helper names the file. Before, the choice or the countdown ends (Cancelled).
    proc = RECORDING["proc"]
    if proc is not None:
        with contextlib.suppress(OSError):
            proc.send_signal(signal.SIGINT)
    elif RECORDING["starting"]:
        RECORDING["pending"] = True
    else:
        raise Cancelled()


def recorder_size(monitors, name):
    # Omarchy's default_resolution: a display is recorded at its own size ("0x0") up to 4K, at 4K above (Omarchy reads the
    # focused display; this reads the one recorded).
    for m in monitors or []:
        if isinstance(m, dict) and m.get("name") == name:
            try:
                if int(m["width"]) > RECORDER_MAX[0] or int(m["height"]) > RECORDER_MAX[1]:
                    return "%dx%d" % RECORDER_MAX
            except (KeyError, TypeError, ValueError):
                pass
    return "0x0"


def recorder_argv(target, monitors, opts, out):
    # gpu-screen-recorder's command line: a whole display by name (with its size), an area as WxH+X+Y in the compositor's
    # logical coordinates, as slurp gives them (the recorder scales to the display's pixels itself, as Omarchy notes).
    kind, value = target
    argv = ["gpu-screen-recorder", "-w", value]
    if kind == "monitor":
        argv += ["-s", recorder_size(monitors, value)]
    argv += RECORDER + ["-cursor", "yes" if opts["pointer"] else "no", "-o", out]
    if opts["mic"]:
        argv += ["-a", "default_input", "-ac", "aac"]
    return argv


def record_target(sel, screens):
    # A choice that is a whole display records that display (Omarchy's --match-monitor), anything else that area.
    whole = [name for name, rect in screens if rect == sel]
    if whole:
        return ("monitor", whole[0]), whole[0]
    return ("region", "%dx%d+%d+%d" % (sel["w"], sel["h"], sel["x"], sel["y"])), ""


def record(opts):
    if not shutil.which("gpu-screen-recorder"):
        sys.stderr.write("grassfield-capture: gpu-screen-recorder is not installed\n")
        return 3
    lock = take_lock()
    if lock is None:
        sys.stderr.write("grassfield-capture: a recording or a countdown is already running\n")
        return 1
    tmp = None
    signal.signal(signal.SIGINT, on_record_signal)
    signal.signal(signal.SIGTERM, on_record_signal)
    try:
        # At once, before anything slow: the shell sees a recording coming (it stops one that starts while the session is
        # locked). Inside the try: a stop that arrives during these first steps raises Cancelled here, and the finally below
        # writes the idle state back (counter-review of ADR-0045, LOW-1: it was left "starting" with a dead pid).
        write_state(dict(me(), phase="starting", kind="recording"))
        monitors = hyprctl("monitors")
        screens = displays(monitors)
        if session_locked(monitors):
            return 1  # the session locked between the toolbar's Record and this helper: nothing is recorded
        if opts["mode"] == "screen":
            named = [s for s in screens if s[0] == opts["output"]] or screens[:1]
            if not named:
                return 1
            target, rect, output = ("monitor", named[0][0]), named[0][1], named[0][0]
            ready = close_previous()
        elif opts["geometry"] is not None:
            # The frame of the toolbar's Record Selected Portion: no crosshair.
            rect = on_one_display(opts["geometry"], monitors)
            if rect is None:
                sys.stderr.write("grassfield-capture: --geometry is not on one display\n")
                return 2
            target, output = record_target(rect, screens)
            ready = close_previous()
        else:
            write_state(dict(me(), phase="selecting", kind="recording"))
            ready = close_previous()
            rect = choose(monitors)
            if rect is None:
                return 0
            target, output = record_target(rect, screens)
        if opts["timer"]:
            countdown(opts["timer"], rect, output, "recording", lock)
        time.sleep(max(0.0, ready - time.monotonic()))
        folder = destination(opts["save"], record=True)
        tmp = reserve(folder, "grassfield-recording", ".mp4") if folder else None
        if tmp is None or session_locked():
            return 1  # (the session locked during the choice or the countdown: nothing is recorded)
        argv = recorder_argv(target, monitors, opts, tmp)
        begun = datetime.datetime.now()
        RECORDING["starting"] = True
        try:
            RECORDING["proc"] = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                                 stderr=subprocess.DEVNULL)
        except OSError:
            return 1
        finally:
            RECORDING["starting"] = False
    except Cancelled:
        return 0
    finally:
        if RECORDING["proc"] is None:
            # A late signal (the shell's stop of a "starting" state under the lock) is noted, not raised, while the idle
            # state is written: raised here it would leave "starting" behind (final counter-review, INFO-1).
            RECORDING["starting"] = True
            write_state({"phase": "idle"})
            if tmp is not None:
                with contextlib.suppress(OSError):
                    os.unlink(tmp)
    proc = RECORDING["proc"]
    write_state(dict(me(), phase="recording", kind="recording", recorder=proc.pid, recorderStart=started(proc.pid),
                     started=int(time.time() * 1000), rect=rect, output=output))
    if RECORDING["pending"]:
        on_record_signal(signal.SIGINT, None)
    # The session locking ends the recording from here too (the shell's marker, read every LOCK_POLL_SECONDS): a shell that
    # is not running then, or restarts under the lock, records nothing behind it.
    told = False
    while True:
        try:
            proc.wait(timeout=LOCK_POLL_SECONDS)
            break
        except subprocess.TimeoutExpired:
            if not told and lock_requested():
                told = True
                on_record_signal(signal.SIGINT, None)
    write_state({"phase": "idle"})
    os.close(lock)
    # From here the notice's wait ends with the session, as a screenshot's does, and a late SIGINT ends it quietly.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    signal.signal(signal.SIGINT, raise_cancelled)
    path = None
    try:
        if os.path.getsize(tmp) > 0:
            stem = tr(REC_NAME) % {"date": begun.strftime("%Y-%m-%d"), "time": begun.strftime("%H.%M.%S")}
            path = publish(os.path.dirname(tmp), stem, ".mp4", tmp)
    except OSError:
        path = None
    finally:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
    if path is None:
        notify([], REC_TITLE, REC_FAILED, REC_OPEN)
        return 1
    if opts["save"] == "preview":
        open_with(PREVIEW, [path])
        return 0
    notify([path], REC_TITLE, saved_note(opts["save"], os.path.dirname(path), record=True), REC_OPEN, picture=False)
    return 0


def stop():
    # Ends what the state names: the recording (SIGINT to its recorder), or a choice or a countdown (SIGINT to its helper).
    # Exit 0 when something was told to end, 1 otherwise.
    state = read_state()
    phase = state.get("phase")
    if phase not in ("starting", "selecting", "countdown", "recording"):
        return 1
    lock = take_lock()
    if lock is not None:
        # Nobody holds the lock: the helper that wrote this state is gone (killed); the state is left over.
        write_state({"phase": "idle"})
        os.close(lock)
        return 1
    pid, start = state.get("pid"), state.get("start")
    if type(pid) is not int or pid <= 1 or not own(pid, start):
        return 1
    target, since = pid, start
    if phase == "recording":
        target, since = state.get("recorder"), state.get("recorderStart")
        # The recorder this helper started: its own child, as it started (never a process found by its name).
        if type(target) is not int or target <= 1 or not own(target, since) or parent(target) != pid:
            return 1
    try:
        handle = os.pidfd_open(target)
    except OSError:
        return 1
    try:
        # Held by the pidfd now: still the same process (a pid reused between the check and the pidfd would differ here).
        if not own(target, since):
            return 1
        signal.pidfd_send_signal(handle, signal.SIGINT)
        if not select.select([handle], [], [], STOP_SECONDS)[0] and phase == "recording":
            signal.pidfd_send_signal(handle, signal.SIGKILL)
    except OSError:
        return 1
    finally:
        os.close(handle)
    return 0


def parse(args):
    # The command line as a dict, or None (usage). Each option once, each value from its list.
    if args == ["stop"]:
        return {"action": "stop"}
    action = "shot"
    if args[:1] == ["record"]:
        action, args = "record", args[1:]
    if not args or args[0] not in (RECORD_MODES if action == "record" else MODES):
        return None
    out = {"action": action, "mode": args[0], "save": None, "timer": 0, "pointer": False, "mic": False, "output": "",
           "geometry": None}
    seen, i = set(), 1
    while i < len(args):
        option = args[i]
        if option in seen:
            return None
        seen.add(option)
        if option in ("--save", "--timer", "--output", "--geometry") and i + 1 < len(args):
            value = args[i + 1]
            if option == "--save" and value in SAVE_TO:
                out["save"] = value
            elif option == "--timer" and value in TIMERS:
                out["timer"] = int(value)
            elif option == "--output" and out["mode"] == "screen" and OUTPUT_NAME.fullmatch(value):
                out["output"] = value
            elif option == "--geometry" and out["mode"] != "screen" and GEOMETRY_ARG.fullmatch(value):
                # Whole numbers, a positive size (on one display: checked against Hyprland's displays when used).
                m = GEOMETRY_ARG.fullmatch(value)
                out["geometry"] = {"x": int(m[1]), "y": int(m[2]), "w": int(m[3]), "h": int(m[4])}
                if out["geometry"]["w"] <= 0 or out["geometry"]["h"] <= 0:
                    return None
            else:
                return None
            i += 2
        elif option == "--pointer" or (option == "--mic" and action == "record"):
            out[option[2:]] = True
            i += 1
        else:
            return None
    return out


def raise_cancelled(signum, frame):
    raise Cancelled()


def main():
    opts = parse(sys.argv[1:])
    if opts is None:
        sys.stderr.write("usage: grassfield-capture screen|window|selection [--save screenshots|desktop|documents|clipboard|preview]"
                         " [--timer 0|5|10] [--pointer] [--output NAME (screen)] [--geometry 'X,Y WxH' (window, selection)]\n"
                         "       grassfield-capture record screen|selection [--save screenshots|desktop|documents|preview]"
                         " [--timer 0|5|10] [--pointer] [--mic] [--output NAME (screen)] [--geometry 'X,Y WxH' (selection)]\n"
                         "       grassfield-capture stop\n")
        return 2
    if opts["action"] == "stop":
        return stop()
    if opts["save"] is None:
        opts["save"] = stored_location()  # the keys: the toolbar's Save to
    if opts["action"] == "record" and opts["save"] == "clipboard":
        opts["save"] = DEFAULT_SAVE  # a movie is not copied (see above): the Videos folder
    if opts["action"] == "record":
        try:
            return record(opts)
        except Cancelled:
            return 0
    # A signal (the session ending) still runs the clean-up of save_picture(): no hidden file is left in the folder. SIGINT
    # (stop, during the toolbar's countdown) ends the capture without a picture.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    signal.signal(signal.SIGINT, raise_cancelled)
    try:
        return shot(opts)
    except Cancelled:
        return 0


if __name__ == "__main__":
    sys.exit(main())
