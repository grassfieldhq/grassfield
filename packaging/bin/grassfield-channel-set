#!/bin/bash
# Grassfield's Software Update channel (ADR-0033 c.3, owner decisions O1 and O4; docs/specs/updates.md U15).
#
#   grassfield-channel-set           print the channel: stable, beta, custom, repair or off
#   grassfield-channel-set stable    set Grassfield updates up, or leave the beta (installs nothing: pacman never downgrades);
#                                    refused (exit 1) while the installed VERSION is a prerelease, missing or malformed
#   grassfield-channel-set beta      switch to the beta channel (installs nothing; "Update Now" does)
#   grassfield-channel-set repair    put [grassfield] back after Omarchy rewrote pacman.conf, or rewrite a custom file
#   grassfield-channel-set off       turn Grassfield updates off: no [grassfield], no Grassfield key left in pacman
#   grassfield-channel-set unhold    allow system updates Grassfield hasn't tested (ADR-0041 step 2a): grassfield-unhold
#                                    replaces grassfield-hold in one root transaction, by pkexec grassfield-hold-helper (its own
#                                    polkit action org.grassfield.packages.hold: a password every time)
#   grassfield-channel-set hold      hold them again: grassfield-hold replaces grassfield-unhold
#   grassfield-channel-set hold-state  print (read-only) held, allowed, allowed-moved or none: the hold is installed; its twin
#                                    is, and the toolkit is still inside the hold's bounds; the same, but the toolkit moved past
#                                    them (holding again is impossible until the next Grassfield update); neither is installed
#
# The user's command, also run by Settings with no terminal; it refuses to run as root. The change itself is made by
# `pkexec /usr/lib/grassfield/grassfield-channel-helper <verb>` (polkit action org.grassfield.packages.set-channel: an
# administrator's password). Then, as the user, it links Omarchy's hook so that the [grassfield] lines survive Omarchy's
# own channel changes: omarchy-refresh-pacman runs `omarchy-hook pre-refresh-pacman`, which runs the files of
# ~/.config/omarchy/hooks/pre-refresh-pacman.d/ (50-grassfield -> /usr/share/grassfield/omarchy-hooks/pre-refresh-pacman);
# `off` removes that link. Refused while an Omarchy update runs (omarchy-update-lock holds its lock).
# Exit 0 done; 1 refused, cancelled or failed (the message says which); 2 usage.
#
# Dev plumbing (ADR-0019, honoured only in a dev session: GRASSFIELD_DEV exactly "1" and GRASSFIELD_SESSION not "1"):
# GRASSFIELD_UPDATE_PKEXEC, the recording stand-in run instead of pkexec. In a dev session nothing else runs: without the
# stand-in the change is refused, and the hook link in the home folder is never made or removed.
set -uo pipefail

helper=/usr/lib/grassfield/grassfield-channel-helper
hold_helper=/usr/lib/grassfield/grassfield-hold-helper
repository=/usr/share/grassfield/pacman/repository.conf
version_file=/usr/share/grassfield/VERSION
build_deps=/usr/share/grassfield/BUILD-DEPS
bounds_lib=/usr/lib/grassfield/grassfield-hold-bounds.sh
pacman_conf=/etc/pacman.conf
include=/etc/pacman.d/grassfield.conf
hook=/usr/share/grassfield/omarchy-hooks/pre-refresh-pacman
pkexec=pkexec
dev=0
if [[ ${GRASSFIELD_DEV:-} == 1 && ${GRASSFIELD_SESSION:-} != 1 ]]; then
  dev=1
  pkexec=${GRASSFIELD_UPDATE_PKEXEC:-}
fi

fail() {
  echo "grassfield-channel-set: $*" >&2
  exit 1
}

conf_value() { # KEY -> its value in the packaged repository.conf
  local line
  [[ -r $repository ]] || fail "missing $repository"
  while IFS= read -r line; do
    [[ $line == "$1="* ]] && { printf '%s\n' "${line#*=}"; return 0; }
  done <"$repository"
}

sections() { # the number of [grassfield] sections of pacman.conf
  awk '{ l = $0; sub(/#.*/, "", l); gsub(/^[ \t]+|[ \t]+$/, "", l); if (l == "[grassfield]") n++ } END { print n + 0 }' \
    "$pacman_conf" 2>/dev/null || echo 0
}

has_section() {
  (($(sections) > 0))
}

primary() { # the first Server value of the included file
  awk '{ l = $0; sub(/#.*/, "", l)
         if (match(l, /^[ \t]*Server[ \t]*=[ \t]*/)) { v = substr(l, RLENGTH + 1); gsub(/[ \t]+$/, "", v); print v; exit } }' \
    "$include" 2>/dev/null
}

state() {
  local base server
  if [[ ! -f $include ]]; then
    # Lines without their file stop every pacman command: "repair" writes the file again.
    has_section && echo repair || echo off
    return
  fi
  # Missing, or twice (pacman refuses "already registered"): the helper's restore leaves exactly one.
  [[ $(sections) == 1 ]] || { echo repair; return; }
  base=$(conf_value GRASSFIELD_REPO_BASE)
  server=$(primary)
  # The plain form, or the staged rollout's cohort form that the package scriptlet writes (ADR-0050 2).
  case $server in
    "$base/stable/\$arch" | "$base/stable/cohort/"[01][0-9]"/\$arch") echo stable ;;
    "$base/beta/\$arch" | "$base/beta/cohort/"[01][0-9]"/\$arch") echo beta ;;
    *) echo custom ;;
  esac
}

# The channel rule (ADR-0033 O15b, owner decision of 2026-11-04, the macOS model): an installed VERSION that is a prerelease
# (-betaN, -rcN), or missing, empty, unreadable or malformed, can only follow beta; beta carries every release, a plain version
# goes to stable and to beta when it is newer. Once a plain X.Y.Z is installed, stable is available. Strict: the whole file,
# trimmed, must be X.Y.Z (one line).
stable_allowed() {
  local v
  [[ -f "$version_file" && -r "$version_file" ]] || return 1
  v=$(<"$version_file") || return 1
  v=${v#"${v%%[![:space:]]*}"}
  v=${v%"${v##*[![:space:]]}"}
  [[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

# The channel a set up chooses when the caller does not say (and the one repair falls back to).
fallback_channel() {
  stable_allowed && echo stable || echo beta
}

require_stable_allowed() {
  stable_allowed || fail "beta updates stay on while a beta version of Grassfield is installed (stable has no release yet): you can turn them off once the release is installed"
}

require_build() {
  local base host
  base=$(conf_value GRASSFIELD_REPO_BASE)
  host=${base#https://}
  host=${host%%/*}
  host=${host%%:*}
  [[ -n $(conf_value GRASSFIELD_SIGNING_FINGERPRINT) ]] || fail "no signing key in this build"
  [[ $base == file://* || ($host != *.invalid && $host != invalid) ]] || fail "no package repository in this build"
}

# Omarchy's update holds ${XDG_RUNTIME_DIR:-/tmp}/omarchy-update.lock (omarchy-update-lock): tested, released at once.
require_no_update() {
  local lock=${XDG_RUNTIME_DIR:-/tmp}/omarchy-update.lock
  [[ -e $lock ]] || return 0
  flock -n "$lock" true || fail "an Omarchy update is running: try again when it has finished"
}

# hold-state: what the hold is (see the header). Read-only: pacman -Q of the local database and the build's own record, with
# the code that computed the hold's bounds (ADR-0041 step 2a; the same rule as U27).
# By NAME: `pacman -Q grassfield-hold` also answers for the twin, which provides that name (pacman 7.1), so the list of names is read.
hold_state() {
  local qs qt names
  names=$(pacman -Qq 2>/dev/null) || { echo none; return; }
  if [[ $'\n'$names$'\n' == *$'\n'grassfield-hold$'\n'* ]]; then
    echo held
  elif [[ $'\n'$names$'\n' == *$'\n'grassfield-unhold$'\n'* ]]; then
    # shellcheck source=packaging/arch/hold-bounds.sh
    if [[ -f $bounds_lib && ! -L $bounds_lib ]] && . "$bounds_lib" &&
      qs=$(pacman -Q -- quickshell 2>/dev/null | awk '{ print $2; exit }') &&
      qt=$(pacman -Q -- qt6-base 2>/dev/null | awk '{ print $2; exit }') &&
      gf_hold_allows "$build_deps" "$qs" "$qt"; then
      echo allowed
    else
      echo allowed-moved
    fi
  else
    echo none
  fi
}

# run_helper verb...: the channel helper; run_hold_helper verb: the hold helper (its own polkit action, a password every time).
run_helper() { run_program "$helper" "$@"; }
run_hold_helper() { run_program "$hold_helper" "$@"; }
run_program() {
  local rc program=$1
  shift
  if [[ -z $pkexec ]]; then
    echo "grassfield-channel-set: dev guard: $* suppressed in a dev session" >&2
    exit 1
  fi
  "$pkexec" "$program" "$@"
  rc=$?
  case $rc in
    0) return 0 ;;
    126 | 127) fail "not allowed: the authentication was cancelled or refused, or no authentication agent answered" ;;
    *) fail "the change failed (${program##*/} $*: exit $rc); nothing else was changed" ;;
  esac
}

hook_link() {
  [[ -n ${HOME:-} ]] || fail "HOME is not set: the Omarchy hook cannot be linked"
  printf '%s\n' "$HOME/.config/omarchy/hooks/pre-refresh-pacman.d/50-grassfield"
}

link_hook() {
  local link
  link=$(hook_link)
  if ((dev)); then
    echo "grassfield-channel-set: dev guard: link $link suppressed in a dev session" >&2
    return 0
  fi
  mkdir -p -- "${link%/*}" && ln -sfnT -- "$hook" "$link" || fail "cannot link the Omarchy hook $link"
}

unlink_hook() {
  local link
  link=$(hook_link)
  if ((dev)); then
    echo "grassfield-channel-set: dev guard: removing $link suppressed in a dev session" >&2
    return 0
  fi
  if [[ -L $link ]]; then
    rm -f -- "$link" || fail "cannot remove the Omarchy hook $link"
  fi
}

if ((EUID == 0)); then
  fail "run it as your user; it asks for permission itself"
fi
if (($# > 1)); then
  echo "usage: grassfield-channel-set [stable|beta|repair|off|hold|unhold|hold-state]" >&2
  exit 2
fi

case ${1-} in
  "")
    state
    ;;
  stable | beta)
    require_build
    [[ $1 == stable ]] && require_stable_allowed
    require_no_update
    run_helper set "$1"
    link_hook
    ;;
  repair)
    current=$(state)
    case $current in
      repair)
        require_no_update
        if [[ -f $include ]]; then
          run_helper restore
        else
          require_build
          run_helper set "$(fallback_channel)"
        fi
        ;;
      custom)
        require_build
        require_no_update
        case $(primary) in
          */beta/\$arch | */beta/cohort/[01][0-9]/\$arch) run_helper set beta ;;
          *) run_helper set "$(fallback_channel)" ;;
        esac
        ;;
      stable | beta) echo "grassfield-channel-set: nothing to repair ($current)" ;;
      *) fail "Grassfield updates are off: grassfield-channel-set $(fallback_channel) sets them up" ;;
    esac
    link_hook
    ;;
  off)
    require_no_update
    run_helper off
    unlink_hook
    ;;
  hold | unhold)
    require_no_update
    run_hold_helper "$1"
    ;;
  hold-state)
    hold_state
    ;;
  *)
    echo "usage: grassfield-channel-set [stable|beta|repair|off|hold|unhold|hold-state]" >&2
    exit 2
    ;;
esac
