#!/bin/sh
# grassfield-shell-failed: the shell's failure counter, the loop detector of ADR-0041 step 1a (owner decision SQ-2 A,
# 2026-10-29). Installed to /usr/lib/grassfield/grassfield-shell-failed, run by grassfield-shell-failed.service, which
# grassfield-shell.service starts through OnFailure= after EVERY failure of the shell (a crash, an exit code, 255 included;
# systemd's RestartMode=normal passes the unit through "failed" before each restart). A clean exit, SIGTERM or `qs kill`
# ends "inactive" and never comes here, nor does a stop through systemd.
#
# Why: systemd's start limit counts starts within an interval and cannot see how long the shell lived; with RestartSec=100ms the
# unit's own limit (10 starts in 5 minutes) trips only for a loop faster than one crash every 29.9 s, and the first limit
# (10 in 30 s) never tripped the loop of 2026-10-29, a crash 5 s after every start (docs/audits/stability-2026-10-29/audit.md
# 1.2). This script counts failures instead: it keeps the monotonic time of each failure of the last WINDOW seconds in
# $XDG_RUNTIME_DIR/grassfield/shell-failures (0600; the runtime directory is the unit's RuntimeDirectory=) and, at the
# COUNT-th failure within the window, cancels the pending restart (`systemctl --user stop grassfield-shell.service`, which a
# unit waiting in auto-restart accepts) and writes $XDG_RUNTIME_DIR/grassfield/shell-safe-mode, the state the security
# process reads from step S4 on (ADR-0041 step 1: "the UI unit failed, the security process is up"). Until S4 ships, the
# stop gives what the start limit gives today, reached now for a slow loop too: the UI stays stopped, the compositor keeps a
# lock if there was one (ext-session-lock: fail closed, docs/specs/security.md "Lock survival"), Omarchy's sleep lock stays
# armed by the other OnFailure= unit, and its `omarchy-shell` stand-in tries the shell once more at sleep time.
#
# A logout is not a failure: `qs` exits 255 when the compositor goes away first (GF-081), so this script asks
# session-gone (next to it: the test the sleep-lock gate uses) and counts nothing when the compositor is certainly gone.
# Anything it cannot do (no runtime directory, an unreadable clock, a ledger it cannot write) is logged and counts
# nothing: a counter that cannot count must never stop the shell (the restarts go on, as before this script).
# Nothing here unlocks, starts or signals a process: the one state change is the stop of the shell unit, and the
# compositor keeps the session locked across it.
#
# Environment, for tests only, which run a scratch copy of this script: GRASSFIELD_SHELL_FAIL_WINDOW (seconds of the
# window, default 600), GRASSFIELD_SHELL_FAIL_COUNT (the threshold, default 3), GRASSFIELD_SHELL_FAIL_NOW (the monotonic
# time to use instead of /proc/uptime). The unit clears all three (UnsetEnvironment=), so in the session they are never
# read: nothing in the user manager's environment can lower the threshold (opus security review of b1d826b).
set -u
me=grassfield-shell-failed
say() { echo "$me: $*" >&2; }
digits() { case ${1:-} in '' | *[!0-9]*) return 1 ;; *) return 0 ;; esac; }
window=${GRASSFIELD_SHELL_FAIL_WINDOW:-600}
digits "$window" || window=600
count_max=${GRASSFIELD_SHELL_FAIL_COUNT:-3}
digits "$count_max" && [ "$count_max" -ge 1 ] || count_max=3
# 1. A session that is ending: the compositor is certainly gone, so this exit is the logout's, not a crash.
if "$(dirname "$0")/session-gone"; then
  exit 0
fi
# 2. The clock: monotonic seconds, which a wall-clock change (DST, NTP) never moves.
now=${GRASSFIELD_SHELL_FAIL_NOW:-}
if [ -z "$now" ]; then
  now=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)
  now=${now%%.*}
fi
if ! digits "$now"; then
  say "cannot read the clock: this failure is not counted"
  exit 0
fi
# 3. The ledger: one failure time per line, only the ones within the window are kept, this one is added.
if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
  say "no XDG_RUNTIME_DIR: this failure is not counted"
  exit 0
fi
dir=$XDG_RUNTIME_DIR/grassfield
umask 077
if ! mkdir -p "$dir" 2>/dev/null || [ ! -d "$dir" ] || [ -L "$dir" ]; then
  say "cannot use $dir: this failure is not counted"
  exit 0
fi
ledger=$dir/shell-failures
tmp=$ledger.new
{
  if [ -f "$ledger" ] && [ ! -L "$ledger" ]; then
    # Lines that are not a plain number, or a time from the future, are dropped (a ledger is never trusted blindly).
    awk -v now="$now" -v w="$window" '$1 ~ /^[0-9]+$/ && now - $1 >= 0 && now - $1 <= w { print $1 }' "$ledger" 2>/dev/null
  fi
  echo "$now"
} >"$tmp" 2>/dev/null || { say "cannot write the ledger: this failure is not counted"; rm -f "$tmp"; exit 0; }
mv -f "$tmp" "$ledger" 2>/dev/null || { say "cannot write the ledger: this failure is not counted"; rm -f "$tmp"; exit 0; }
count=$(wc -l <"$ledger" 2>/dev/null | tr -d ' ')
digits "$count" || { say "cannot read the ledger back: this failure is not counted"; exit 0; }
say "failure $count of $count_max within ${window} s"
if [ "$count" -lt "$count_max" ]; then
  exit 0
fi
# 4. The loop ends: the state file first (written whole, then renamed), then the stop, then the journal line with the
# stop's result (a stop that failed is said as well). The session stays locked if it was.
printf 'loop %s %s\n' "$now" "$count" >"$dir/shell-safe-mode.new" && mv -f "$dir/shell-safe-mode.new" "$dir/shell-safe-mode"
if systemctl --user stop grassfield-shell.service; then
  say "grassfield-shell failed $count times within ${window} s: its restarts stopped (safe mode state written); the compositor keeps any lock"
else
  say "grassfield-shell failed $count times within ${window} s, but the stop of its unit failed (exit $?): the restarts go on"
fi
exit 0
