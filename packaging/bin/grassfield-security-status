#!/bin/sh
# grassfield-security-status: what the Grassfield security process answers (ADR-0041 step 1, S1; the lock since S2).
# Read-only, needs no privileges; the measurements and the owner's checks run it.
#   grassfield-security-status        prints one line: state=<what the process hosts> lock=<unlocked|locked>
#                                     heartbeat=<public lock state and sequence>
#                                     unit=<ActiveState SubState MainPID MemoryCurrent of grassfield-security.service>
# Exit 0 when the process answers, 1 when it does not ("not running"). It calls the security instance's IPC targets by its
# path (the unit's ExecStart path), with Quickshell's option variables cleared as every `qs ipc` caller of the session
# does (a stray QS_MANIFEST made `qs ipc -p` exit 108: the re-review of bf9e280). From a TTY (no WAYLAND_DISPLAY) the
# instance is on another display connection than the caller's, which `qs ipc` filters out: --any-display lifts the
# filter there (Quickshell 0.3.1, "instances will not be filtered by the display connection they were launched on";
# the integrator's merge review of #72), and the path still names one instance.
unset QS_CONFIG_PATH QS_CONFIG_NAME QS_MANIFEST
path=/usr/share/grassfield/shell/security.qml
display=""
[ -n "${WAYLAND_DISPLAY:-}" ] || display="--any-display"
# shellcheck disable=SC2086  # $display is empty or one option
state=$(timeout -k 0.2 2 qs ipc $display -p "$path" call security state 2>/dev/null) || { echo "security: not running (no answer from $path)" >&2; exit 1; }
# shellcheck disable=SC2086
lock=$(timeout -k 0.2 2 qs ipc $display -p "$path" call lock state 2>/dev/null) || lock="?"
# shellcheck disable=SC2086
beat=$(timeout -k 0.2 2 qs ipc $display -p "$path" call security heartbeat 2>/dev/null) || beat="?"
unit=$(systemctl --user show -p ActiveState -p SubState -p MainPID -p MemoryCurrent --value grassfield-security.service 2>/dev/null | tr '\n' ' ')
printf 'state=%s lock=%s heartbeat="%s" unit="%s"\n' "$state" "$lock" "$beat" "${unit% }"
exit 0
