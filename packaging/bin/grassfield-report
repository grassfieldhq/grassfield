#!/usr/bin/python3 -I
"""grassfield-report: a diagnostic report for beta testers (ADR-0053).

  grassfield-report [--output PATH]

Writes ONE private text file (mode 0600, never overwriting) and prints its path on stdout:
  - in the user's Downloads folder (XDG_DOWNLOAD_DIR of user-dirs.dirs, else ~/Downloads when it exists, else the home),
    or at PATH (a file, or an existing folder to write into);
  - named grassfield-report-<YYYYMMDD-HHMMSS>.txt (-2, -3... when that name exists).
It holds the versions (Grassfield, its packages, Omarchy, Hyprland, Quickshell, Qt), the compositor plugin's status, the
displays, the audio devices, the Grassfield user units' state and memory (systemctl --user show), the Quickshell processes'
memory and threads, the system's memory and memory pressure, every Grassfield unit that ended by a signal this boot with the
journal around it and the known killers that left a trace, the crashes of the last 7 days (with the first lines of
coredumpctl info for Quickshell, Hyprland and Grassfield programs), the kernel's out-of-memory and crash lines, systemd-oomd's
and earlyoom's lines, this boot's journal of the Grassfield user units (the liveness probe's routine runs left out, repeated
lines folded, its last 512 KiB at most), the last lines of the UI's and the security process's own Quickshell logs (the
free text of every log, such as window titles, network names and notification bodies, replaced by <text>) and
Grassfield's configuration files with secret-looking values removed. The home path, the user name, the real name and the
host name are replaced everywhere, and so are hardware serial numbers (the displays', R7-SEC-04; a USB audio device's in
ALSA and PipeWire names) and Bluetooth or network hardware addresses. The person reads it and decides whether to share it.

Rules: never as root, no sudo, no network, no recording or playback, no configuration change. Every command is read-only,
run without a shell, with a timeout and LC_ALL=C, all of them within a time budget of 75 s (Settings waits 90 s); a missing
tool is one line in the report, never a failure.
Inspired by Project Luma's support report (MPL-2.0): the rules and the idea; no code copied. Standard library only.
Exit status: 0 written, 1 not written (the reason on stderr), 2 usage or run as root.
Test hooks (dev sessions only): GRASSFIELD_REPORT_ROOT prefixes the system files read (VERSION, os-release, the schema)
and /proc; GRASSFIELD_REPORT_BUDGET replaces the time budget (seconds); tests/shell/diagnostic_report.sh.
"""
import datetime
import json
import os
import platform
import pwd
import re
import signal
import socket
import subprocess
import sys
import time

# A dev-plumbing hook (ADR-0019): honoured only in a dev session (GRASSFIELD_DEV "1", GRASSFIELD_SESSION not "1").
DEV = os.environ.get("GRASSFIELD_DEV") == "1" and os.environ.get("GRASSFIELD_SESSION") != "1"
FILE_ROOT = os.environ.get("GRASSFIELD_REPORT_ROOT", "") if DEV else ""
VERSION_FILE = FILE_ROOT + "/usr/share/grassfield/VERSION"
OS_RELEASE = FILE_ROOT + "/etc/os-release"
PROC = FILE_ROOT + "/proc"

TIMEOUT = 10
JOURNAL_TIMEOUT = 20
# All the commands together: Settings' button waits 90 s for the report (Backend.act); a command that would start after the
# budget is spent is one line in the report instead.
BUDGET = 75
try:
    BUDGET = max(1, int(os.environ.get("GRASSFIELD_REPORT_BUDGET", ""))) if DEV else BUDGET
except ValueError:
    pass
START = time.monotonic()
# This boot's journal of the Grassfield units: at most this many lines read (a memory bound), its last JOURNAL_MAX bytes kept
# once the liveness probe's routine runs are left out and repeated lines folded.
JOURNAL_SCAN = 100000
JOURNAL_READ = 32 * 1024 * 1024
JOURNAL_MAX = 512 * 1024
KERNEL_LINES = 200
KERNEL_MAX = 32 * 1024
OOMD_LINES = 200
KILLS = 5
KILL_WINDOW = 5
KILL_LINES = 150
KILLS_MAX = 96 * 1024
QS_LOG_LINES = 150
QS_LOG_MAX = 24 * 1024
CRASH_DETAILS = 5
CRASH_FRAMES = 8
SECTION_MAX = 64 * 1024
CRASH_LINES = 100
CONFIG_FILES = 20
CONFIG_MAX = 256 * 1024
PACKAGES = re.compile(r"^(grassfield\S*|omarchy\S*|hyprland|quickshell|quickshell-git|qt6-base|qt6-declarative|qt6-wayland)$")
MONITOR_FIELDS = ("name", "make", "model", "width", "height", "refreshRate", "x", "y", "scale", "transform", "focused",
                  "dpmsStatus", "vrr", "disabled", "mirrorOf", "currentFormat")
# Names too common to be replaced as words (a user called "user" would turn every "user unit" into "<user> unit").
GENERIC_NAMES = {"user", "users", "admin", "test", "guest", "live", "demo", "root", "home", "localhost", "linux", "archlinux",
                 "omarchy", "grassfield"}
REDACTED = "[redacted]"
SECRET_WORDS = {"password", "passwd", "passphrase", "pass", "pwd", "secret", "secrets", "token", "tokens", "credential",
                "credentials", "cookie", "cookies", "psk", "auth", "authorization", "bearer", "private", "apikey"}
KEY_QUALIFIERS = {"api", "access", "private", "secret", "signing", "encryption", "auth", "ssh", "session", "gpg", "pgp",
                  "master", "client", "shared", "wifi", "wpa", "license", "licence"}
# Free text the user typed, redacted whole: (section, key) of grassfield.json.
FREE_TEXT = {("lock", "message")}
# A display identity (ADR-0044 D-2 `s:<make>|<model>|<serial>`, WallpaperConfig.displayKey `s:<model>|<serial>`): the serial is
# the last field.
SERIAL_KEY = re.compile(r"^(s:(?:[^|]*\|){1,2})[^|]+$")
# A display named by its description (displays.conf `v1<TAB>desc:<description><TAB>...`, apps/settings/qml/Displays.js lineFor,
# config/hypr/grassfield/displays.lua): Hyprland's description is "<make> <model> <serial>", trimmed (R7-SEC-04). The field
# ends at the next tab or the end of the line.
DESC_FIELD = re.compile(r"(?<![A-Za-z0-9_])(desc:)([^\t\r\n]*)")
# The same anywhere else in the report (the journal: a display rule Hyprland or the shell names): up to a tab, the end of the
# line, a quote, a comma, a semicolon, a parenthesis or a colon followed by a space ("desc:<description>: <message>").
DESC_ANY = re.compile(r"(?<![A-Za-z0-9_])(desc:)((?:[^\t\r\n\"',;():]|:(?!\s))*)")
# A word of a description that could be a serial (an EDID serial string or number): 6 characters or more, a digit among them.
EDID_LIKE = re.compile(r"(?=[^0-9]*[0-9])[A-Za-z0-9._-]{6,}")
SERIAL_MARK = "[serial]"
# A serial shorter than this is not replaced across the whole report (it would mangle other words); displays.conf's
# descriptions still lose it.
SERIAL_MIN = 4
# The shell's audio routing key of a USB device, usb:<vendor id>:<product id>:<device.serial> (shell/services/AudioRoutingLogic.js
# deviceKey; its log line drops the serial since rc7, an older journal or a state file may still hold it): the serial goes.
USB_KEY = re.compile(r"(\busb:(?:0x)?[0-9A-Fa-f]{1,8}:(?:0x)?[0-9A-Fa-f]{1,8}:)[^\s)\]\"',;]+")
# A USB device's udev ID_SERIAL (<vendor>_<model>_<serial>) in an ALSA or PipeWire name: alsa_output.usb-<ID_SERIAL>-00.analog-stereo,
# alsa_card.usb-<ID_SERIAL>-00 (wpctl status lists the default nodes by name; the journal may name them). Replaced whole: the
# serial cannot be told from the model in it, and the device's own description stays in the audio devices list.
USB_ID = re.compile(r"(\b(?:alsa|v4l2)_[a-z]+\.usb-)([A-Za-z0-9._-]+?)(-[0-9]{2}(?=[.\s\"',;)\]]|$))", re.M)


def usage(message=""):
    if message:
        print("grassfield-report: " + message, file=sys.stderr)
    print("usage: grassfield-report [--output PATH]", file=sys.stderr)
    return 2


def run(argv, timeout=TIMEOUT, limit=SECTION_MAX, tail=False):
    """(ok, text) of a read-only command: no shell, C locale, stdin closed, bounded output."""
    env = dict(os.environ, LC_ALL="C", LANG="C")
    # Quickshell's option variables would change what `qs log` selects (a stray QS_MANIFEST makes qs exit at once).
    for name in ("LANGUAGE", "QS_CONFIG_PATH", "QS_CONFIG_NAME", "QS_MANIFEST"):
        env.pop(name, None)
    left = BUDGET - (time.monotonic() - START)
    if left < 1:
        return False, "(left out: the report's time budget of %d s is spent)" % BUDGET
    timeout = min(timeout, left)
    try:
        p = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, timeout=timeout, env=env, check=False)
    except FileNotFoundError:
        return False, "(not available: %s is not installed)" % argv[0]
    except subprocess.TimeoutExpired:
        return False, "(no answer from %s within %d s)" % (argv[0], round(timeout))
    except OSError as e:
        return False, "(%s could not run: %s)" % (argv[0], e.strerror or "error")
    out = p.stdout.decode("utf-8", "replace")
    if p.returncode != 0 and not out.strip():
        err = p.stderr.decode("utf-8", "replace").strip().splitlines()
        return False, "(%s exited with %d%s)" % (argv[0], p.returncode, ": " + err[-1][:200] if err else "")
    return True, bounded(out, limit, tail)


def bounded(text, limit, tail=False):
    data = text.encode("utf-8")
    if len(data) <= limit:
        return text
    cut = data[-limit:] if tail else data[:limit]
    note = "[... %d bytes left out ...]" % (len(data) - limit)
    body = cut.decode("utf-8", "ignore")
    return note + "\n" + body if tail else body + "\n" + note


def read_file(path, limit=SECTION_MAX):
    try:
        with open(path, "rb") as f:
            data = f.read(limit + 1)
    except OSError:
        return None
    text = data[:limit].decode("utf-8", "replace")
    return text + ("\n[... cut at %d bytes ...]" % limit if len(data) > limit else "")


# ---- secrets ---------------------------------------------------------------------------------------------------------

def key_words(key):
    spaced = re.sub(r"([a-z0-9])([A-Z])", r"\1 \2", str(key))
    return [w for w in re.split(r"[^A-Za-z0-9]+", spaced.lower()) if w]


def secret_key(key):
    words = key_words(key)
    if any(w in SECRET_WORDS for w in words):
        return True
    if "".join(words) in ("apikey", "accesskey", "privatekey", "secretkey"):
        return True
    return any(w == "key" and i > 0 and words[i - 1] in KEY_QUALIFIERS for i, w in enumerate(words))


def redact_json(value, parent=""):
    """Secret-looking values, the user's free text (FREE_TEXT) and monitor serials: a `serial` field, and the serial field of a
    display identity string (displays.main's `set` and `main`, wallpaper outputs) become "present"."""
    if isinstance(value, dict):
        out = {}
        for k, v in value.items():
            if (secret_key(k) or (parent, k) in FREE_TEXT) and v not in (None, "", [], {}) and not isinstance(v, bool):
                out[k] = REDACTED
            elif k == "serial" and isinstance(v, str):
                out[k] = "present" if v.strip() else ""
            else:
                out[k] = redact_json(v, k)
        return out
    if isinstance(value, list):
        return [redact_json(v, parent) for v in value]
    if isinstance(value, str):
        return SERIAL_KEY.sub(r"\1present", value)
    return value


PATH_RULES = {"pathList", "wallpaperPath"}  # x-grassfield rules of config/schema/grassfield.schema.json that hold a path
SCHEMA_FILE = FILE_ROOT + "/usr/share/grassfield/schema/grassfield.schema.json"
LEFT_OUT = "(a path, left out of the report)"
PATH_START = ("/", "~/", "$HOME/", "file://")
PATH_TOKEN = re.compile(r"file://|\$HOME/|(?<![\w~.])~/|(?<![\w.:/])/(?=[^\s/])")


def is_path(value):
    """An absolute path, a `~/` or `$HOME/` path or a file:// URL."""
    return isinstance(value, str) and value.strip().startswith(PATH_START)


def path_name(value):
    """The file name of a path or file:// URL (percent-decoded), "" when there is none."""
    text = value.strip()
    if text.startswith("file://"):  # file://[host]/path: the path from the first slash after the host, percent-decoded
        text = text[len("file://"):]
        text = text[text.find("/"):] if "/" in text else ""
        text = re.sub(r"%([0-9A-Fa-f]{2})", lambda m: chr(int(m.group(1), 16)), text)
    return os.path.basename(text.rstrip("/"))


def schema_path_types():
    """The settings whose schema type is a path (x-grassfield rule pathList or wallpaperPath), from the installed schema:
    {key tuple: rule}. Missing or unreadable: empty, and the shape of the values (is_path) still applies."""
    text = read_file(SCHEMA_FILE, 1024 * 1024)
    try:
        schema = json.loads(text) if text else {}
    except ValueError:
        return {}
    found = {}

    def walk(node, trail):
        if not isinstance(node, dict):
            return
        ann = node.get("x-grassfield")
        rule = ann.get("rule") if isinstance(ann, dict) else None
        if rule in PATH_RULES and trail:
            found[trail] = rule
        props = node.get("properties")
        if isinstance(props, dict):
            for k, v in props.items():
                walk(v, trail + (k,))

    walk(schema, ())
    return found


def scrub_paths(value, types=None, trail=(), wallpaper=False, siblings=None):
    """No folder path leaves (ADR-0053): a value of a path type in the schema becomes a count (a list) or, for a wallpaper,
    its file name; any other value that looks like a path (absolute, ~/, $HOME/, file://) is left out, or reduced to its file
    name under a wallpaper* key or file; a key that is itself a path (stackOptions) is replaced by a numbered label."""
    types = types or {}
    if isinstance(value, dict):
        out = {}
        for i, (k, v) in enumerate(value.items()):
            key = "(path %d, left out)" % (i + 1) if is_path(k) else k
            out[key] = scrub_paths(v, types, trail + (k,), wallpaper or str(k).lower().startswith("wallpaper"), value)
        return out
    rule = types.get(trail)
    if isinstance(value, list):
        if rule == "pathList" or any(is_path(v) for v in value):
            return "%d entries (the folder paths are left out of the report)" % len(value)
        return [scrub_paths(v, types, trail, wallpaper, siblings) for v in value]
    if isinstance(value, str) and (rule or is_path(value)):
        if not value.strip():
            return value
        folder = trail[-1:] == ("folder",) or (siblings or {}).get("source") == "folder" or value.strip().endswith("/")
        if (rule == "wallpaperPath" or wallpaper) and not folder:
            return path_name(value) or LEFT_OUT
        return LEFT_OUT
    return value


def scrub_text(text, wallpaper=False):
    """Non-JSON files: a path in a `key = value` line, or anywhere in a line, is left out (file name only for wallpaper*)."""
    out = []
    for line in text.splitlines():
        m = LINE_PAIR.match(line)
        if m:
            raw = m.group(3).strip().strip("\"'")
            if is_path(raw):
                out.append(m.group(1) + ((path_name(raw) or LEFT_OUT) if wallpaper else LEFT_OUT))
                continue
        t = PATH_TOKEN.search(line)
        if t:  # a folder name may hold spaces: everything from the first path on is the path
            rest = line[t.start():]
            line = line[:t.start()] + ((path_name(rest) or LEFT_OUT) if wallpaper else LEFT_OUT)
        out.append(line)
    return "\n".join(out)


def folder_styles(value):
    """folder-styles.json keys up to 20,000 folder paths: the report counts them and shows none."""
    folders = value.get("folders") if isinstance(value, dict) else None
    count = len(folders) if isinstance(folders, (dict, list)) else 0
    return {"folders": "%d entries (the folder paths are left out of the report)" % count}


LINE_PAIR = re.compile(r"^(\s*[\"']?([A-Za-z0-9_.\-]+)[\"']?\s*[=:]\s*)(.+)$")


def redact_lines(text):
    out = []
    for line in text.splitlines():
        m = LINE_PAIR.match(line)
        if m and secret_key(m.group(2)) and m.group(3).strip():
            line = m.group(1) + REDACTED
        out.append(line)
    return "\n".join(out)


# Anywhere in the report (the journal included).
PRIVATE_BLOCK = re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?(-----END [A-Z0-9 ]*PRIVATE KEY-----|\Z)", re.S)
BEARER = re.compile(r"(?i)\b(authorization\s*[:=]\s*(?:bearer|basic|token)\s+|bearer\s+)[A-Za-z0-9._~+/=-]{8,}")
SECRET_NAME = (r"(?:password|passwd|passphrase|pass|pwd|secret|token|psk|(?:api|access|private|ssh|session|secret|client)[_-]?key"
               r"|[a-z]*[_-]token|[a-z]*[_-]secret)")
INLINE_PAIR = re.compile(r"(?i)\b(" + SECRET_NAME + r"[\"']?\s*[=:]\s*[\"']?)([^\s\"',;]{1,})")
# `psk 'value'`, `password "value"` (nmcli, wpa_supplicant and shell styles): a quoted value after a space.
QUOTED_PAIR = re.compile(r"(?i)\b(" + SECRET_NAME + r"\s+)([\"'])(.*?)\2")
KNOWN_TOKENS = re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr|github_pat|glpat|xox[abpr]|sk)[-_][A-Za-z0-9_-]{16,}\b")
# A Bluetooth or network hardware address (also in PipeWire node names: bluez_output.A0:B1:...; with _ or - as separator).
HW_ADDRESS = re.compile(r"(?i)(?<![0-9a-f])[0-9a-f]{2}(?:([:_-])[0-9a-f]{2})(?:\1[0-9a-f]{2}){4}(?![0-9a-f])")
# A device named after a person: "Marie’s AirPods", "Paul's Headphones" (Bluetooth names, in wpctl status and the journal).
POSSESSIVE = re.compile(r"(?<![\w<])[A-Z][\w\-]{1,30}(?=['’]s\b)")


def redact_secrets(text):
    text = PRIVATE_BLOCK.sub(REDACTED, text)
    text = BEARER.sub(lambda m: m.group(1) + REDACTED, text)
    text = QUOTED_PAIR.sub(lambda m: m.group(1) + m.group(2) + REDACTED + m.group(2), text)
    text = INLINE_PAIR.sub(lambda m: m.group(1) + REDACTED, text)
    text = KNOWN_TOKENS.sub(REDACTED, text)
    return HW_ADDRESS.sub("XX:XX:XX:XX:XX:XX", text)


# Device names after a person ("Marie’s AirPods") are removed only where device names are: the audio devices section, and the
# journal lines about audio or Bluetooth. Elsewhere a possessive is the interface's own words ("the Dock's tile", "Wayland's
# socket") and is kept as context.
DEVICE_LINE = re.compile(r"(?i)\b(audio|sink|source|output|input|speaker|headphone|headset|microphone|bluetooth|bluez|pipewire|"
                         r"wireplumber|airpods|earbuds|device)")


def redact_device_names(text, every_line=False):
    def one(line):
        if not every_line and not DEVICE_LINE.search(line):
            return line
        return POSSESSIVE.sub(lambda m: m.group(0) if m.group(0).lower() in PRODUCT_NAMES else "<name>", line)
    return "\n".join(one(l) for l in text.split("\n"))


# Free text in the journal (SU-15): what a person wrote or named, which a Grassfield unit may log, such as a window's title,
# a network's name (SSID), a notification's summary and body, a search, a clipboard entry, an app's own message. Two rules:
# 1. a value after one of these keys (`title=…`, `ssid: …`, `body "…"`): replaced whole by <text>, quoted or not (an unquoted
#    one up to , ; ) ] } or the end of the line);
# 2. any quoted text (“…”, "…", «…», '…' standing alone): replaced by <text> unless it is a technical word: lowercase letters,
#    digits and _ . : / @ + - only (a kind, a state, an id), or a display connector (DP-3, eDP-1, HDMI-A-1), or what an earlier
#    rule already put there. The interface's own words around them are kept.
FREE_KEYS = (r"(?:window[ _-]?title|title|ssid|network[ _-]?name|wifi|summary|body|subject|query|search|clipboard|"
             r"notification[ _-]?text|app[ _-]?message|message[ _-]?text)")
FREE_PAIR = re.compile(r"(?i)\b(" + FREE_KEYS + r")(\s*[=:]\s*|\s+(?=[\"“«']))(“[^”\n]*”|\"[^\"\n]*\"|«[^»\n]*»|'[^'\n]*'|[^,;)\]}\n]+)")
QUOTED_TEXT = re.compile(r"“([^”\n]{0,400})”|«([^»\n]{0,400})»|\"([^\"\n]{0,400})\"|(?<![\w'])'([^'\n]{0,400})'(?![\w'])")
TECHNICAL = re.compile(r"^(?:[a-z0-9_.:/@+-]*|(?:e?DP|HDMI|DVI|VGA|DSI|HEADLESS|Virtual|WL)(?:-[A-Z]?[0-9]+)+|<\w+>|\[\w+\]|~[\w./-]*)$")


def redact_free_text(text):
    def pair(m):
        value = m.group(3)
        if value[:1] in "\"“«'":
            closing = {"\"": "\"", "“": "”", "«": "»", "'": "'"}[value[0]]
            return m.group(1) + m.group(2) + value[0] + "<text>" + closing
        return m.group(1) + m.group(2) + "<text>"

    def quoted(m):
        for i, (open_, close) in enumerate((("“", "”"), ("«", "»"), ("\"", "\""), ("'", "'")), start=1):
            inner = m.group(i)
            if inner is not None:
                return m.group(0) if TECHNICAL.match(inner) else open_ + "<text>" + close
        return m.group(0)

    out = []
    for line in text.split("\n"):
        line = FREE_PAIR.sub(pair, line)
        out.append(QUOTED_TEXT.sub(quoted, line))
    return "\n".join(out)


# Possessives that are not people.
PRODUCT_NAMES = {"grassfield", "omarchy", "hyprland", "quickshell", "pipewire", "wireplumber", "linux", "arch", "qt", "gtk", "kde",
                 "gnome", "firefox", "chromium", "bluez", "systemd", "today", "yesterday", "it", "that", "there", "here", "let",
                 "what", "who"}


# ---- hardware serials (R7-SEC-04) -------------------------------------------------------------------------------------

def display_serials(displays):
    """{description: serial} of Hyprland's displays (serial "" when the display has none); {} without an answer."""
    out = {}
    for m in displays or []:
        desc = str(m.get("description") or "").strip()
        if desc:
            out[desc] = str(m.get("serial") or "").strip()
    return out


def redact_desc(text, known, pattern=DESC_FIELD, found=None):
    """The serial of every `desc:` description removed (ADR-0053: serials never leave). A connected display's (`known`, from
    display_serials) is cut from the end of its description; a connected display without a serial keeps its description; any
    other description (a display not connected now) loses its last word, where Hyprland puts the serial, and every word that
    could be a serial (EDID_LIKE: a serial with a space in it; fail closed: a model name with digits goes too). A description
    already cut (its last word the mark) is left as it is. The words taken out of a display not connected now are added to
    `found`, so that redact_serials removes them wherever else they are written without `desc:` (the security review's nit)."""
    def one(m):
        body = m.group(2).rstrip()
        trail = m.group(2)[len(body):]
        serial = known.get(body)
        if serial == "":
            return m.group(0)
        if serial and body.endswith(serial) and len(body) > len(serial):
            return m.group(1) + body[:-len(serial)].rstrip() + " " + SERIAL_MARK + trail
        words = body.split()
        if not words or words[-1] == SERIAL_MARK:
            return m.group(0)
        kept = [SERIAL_MARK if EDID_LIKE.fullmatch(w.strip(":.,;")) else w for w in words[:-1]]
        if found is not None:
            found.update(w.strip(":.,;") for w, k in zip(words, kept + [SERIAL_MARK]) if k == SERIAL_MARK)
        return m.group(1) + " ".join(kept + [SERIAL_MARK]) + trail
    return pattern.sub(one, text)


def redact_serials(text, known, found=None):
    """Hardware serials anywhere in the report: those of the connected displays (SERIAL_MIN characters or more, as a word),
    every `desc:` description's (redact_desc: a display not connected now too), a USB device's serial in the audio routing
    key (USB_KEY) and the USB ID_SERIAL of ALSA and PipeWire names. The words found taken out of a disconnected display's
    description (`found`) are removed wherever else they are, `desc:` or not."""
    found = set() if found is None else found
    for serial in sorted({v for v in known.values() if len(v) >= SERIAL_MIN}, key=len, reverse=True):
        text = re.sub(r"(?<![A-Za-z0-9])" + re.escape(serial) + r"(?![A-Za-z0-9])", SERIAL_MARK, text)
    text = redact_desc(text, known, DESC_ANY, found)
    for word in sorted({w for w in found if len(w) >= SERIAL_MIN and w != SERIAL_MARK}, key=len, reverse=True):
        text = re.sub(r"(?<![A-Za-z0-9])" + re.escape(word) + r"(?![A-Za-z0-9])", SERIAL_MARK, text)
    text = USB_KEY.sub(lambda m: m.group(1) + SERIAL_MARK, text)
    return USB_ID.sub(lambda m: m.group(1) + "[usb device]" + m.group(3), text)


# ---- identity --------------------------------------------------------------------------------------------------------

def identity():
    """(home, [(word, replacement)]) to remove from the report."""
    home = os.path.realpath(os.environ.get("HOME") or pwd.getpwuid(os.getuid()).pw_dir).rstrip("/")
    names = []
    user = os.environ.get("USER") or os.environ.get("LOGNAME") or ""
    gecos = ""
    try:
        entry = pwd.getpwuid(os.getuid())
        user = user or entry.pw_name
        gecos = entry.pw_gecos
    except KeyError:
        pass
    return home, identity_words(user, gecos, socket.gethostname())


def identity_words(user, gecos, host):
    """[(word, replacement)], longest first: the real name (the first GECOS field) whole and each of its words, the user name,
    the host's short name; a word shorter than 3 characters or a generic one is left (it would mangle the report)."""
    full = (gecos or "").split(",")[0].strip()
    candidates = [(full, "<name>")] + [(w, "<name>") for w in re.split(r"[\s\-]+", full)]
    candidates += [(user or "", "<user>"), ((host or "").split(".")[0], "<host>")]
    names = []
    for word, repl in candidates:
        word = word.strip(".,'’\"()")
        if len(word) >= 3 and word.lower() not in GENERIC_NAMES and word.lower() not in [n.lower() for n, _ in names]:
            names.append((word, repl))
    names.sort(key=lambda n: -len(n[0]))
    return names


def redact_identity(text, home, names):
    if home and home != "/":
        text = re.sub(re.escape(home) + r"(?=/|\b|$)", "~", text)
        # The unresolved $HOME too, when it was a symbolic link.
        raw = (os.environ.get("HOME") or "").rstrip("/")
        if raw and raw != home and raw != "/":
            text = re.sub(re.escape(raw) + r"(?=/|\b|$)", "~", text)
    for word, repl in names:
        text = re.sub(r"(?<![A-Za-z0-9])" + re.escape(word) + r"(?![A-Za-z0-9])", repl, text, flags=re.I)
    return text


# ---- sections --------------------------------------------------------------------------------------------------------

def os_release():
    text = read_file(OS_RELEASE) or ""
    values = {}
    for line in text.splitlines():
        m = re.match(r"^([A-Z_]+)=(.*)$", line)
        if m:
            values[m.group(1)] = m.group(2).strip().strip("\"'")
    return values


def packages():
    ok, text = run(["pacman", "-Q"], limit=4 * 1024 * 1024)
    if not ok:
        return text
    lines = [l for l in text.splitlines() if l.split(" ")[0] and PACKAGES.match(l.split(" ")[0])]
    return "\n".join(lines) if lines else "(none of the listed packages is installed)"


def hypr_monitors():
    """Hyprland's displays: ([display, ...], None), or (None, the line the Displays section shows instead). An answer that is
    not JSON is shown only when it does not look like JSON (a message), never a part of one (it would carry the serials)."""
    ok, text = run(["hyprctl", "-j", "monitors"])
    if not ok:
        return None, text
    try:
        data = json.loads(text)
    except ValueError:
        shown = "" if text.lstrip()[:1] in ("[", "{") else "\n" + text[:2000]
        return None, "(hyprctl's answer is not JSON)" + shown
    if not isinstance(data, list):
        return None, "(unexpected answer)"
    return [m for m in data if isinstance(m, dict)], None


def monitors(data, failed):
    if data is None:
        return failed
    out = []
    for m in data:
        row = {k: m[k] for k in MONITOR_FIELDS if k in m}
        row["serial"] = "present" if str(m.get("serial") or "").strip() else "none"
        out.append(row)
    return json.dumps(out, indent=1, ensure_ascii=False)


def plugin():
    ok, text = run(["hyprctl", "grassfield"])
    if not ok:
        return text
    if re.search(r"(?i)unknown request|invalid", text):
        return "not loaded (hyprctl grassfield: %s)" % text.strip()[:200]
    return "loaded\n" + text.strip()


def crash_rows():
    """(ok, [line, ...] of `coredumpctl list` for the last 7 days) or (False, the line the section shows instead)."""
    # The newest rows are kept when the list is longer than a section (coredumpctl lists the oldest first).
    ok, text = run(["coredumpctl", "--no-pager", "--no-legend", "list", "--since=-7d"], tail=True)
    if not ok and "No coredumps found" in text:  # coredumpctl exits 1 when there is none
        return True, []
    if not ok:
        return False, text
    # Only this user's crashes: a member of wheel or adm may list every user's, whose programs are not this report's business.
    uid = str(os.getuid())
    own = []
    lines = text.splitlines()
    if lines and lines[0].startswith("[... ") and lines[0].endswith(" left out ...]"):
        lines = lines[:1] + lines[2:]  # the row right after the cut may be partial (its columns shifted): left out
    for l in lines:
        m = CRASH_UID.match(l)
        if m and m.group(1) == uid:
            own.append(l)
        elif l.startswith("[... ") and l.endswith(" left out ...]"):
            own.insert(0, "[... older crash rows left out ...]")
    return True, own


def crashes(rows):
    ok, lines = rows
    if not ok:
        return lines
    if not lines:
        return "(no crash in the last 7 days)"
    more = len(lines) - CRASH_LINES
    return "\n".join(lines[-CRASH_LINES:]) + ("\n[... %d older lines left out ...]" % more if more > 0 else "")


# A row of `coredumpctl list`: TIME (day, date, time, zone) PID UID GID SIG COREFILE EXE SIZE.
CRASH_UID = re.compile(r"^\S+ \S+ \S+ \S+\s+\d+\s+(\d+)\s")
CRASH_ROW = re.compile(r"^\S+ \S+ \S+ \S+\s+(\d+)\s+\d+\s+\d+\s+\S+\s+\S+\s+(\S.*?)\s+\S+\s*$")
# The programs of the desktop itself: Quickshell (the UI and the security process), Hyprland and Grassfield's own.
RELATED_EXE = re.compile(r"(?:^|/)(?:qs|quickshell|\.quickshell-wrapped|Hyprland|hyprland|grassfield-[\w.+-]+)$")
# The fields of `coredumpctl info` kept: never the command line, the environment, the boot, machine or host identifiers,
# or the core file's path.
INFO_KEYS = ("PID", "Signal", "Timestamp", "Executable", "Unit", "User Unit", "Package")
INFO_FIELD = re.compile(r"^\s*([A-Za-z][A-Za-z -]*?):\s+(.*)$")


def info_digest(text):
    """The first lines of `coredumpctl info`: INFO_KEYS, the message's first sentence and the first frames of the first
    stack (the thread that crashed), when there is one."""
    out, frames, stacks, in_stack = [], 0, 0, False
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("Stack trace of thread"):
            stacks += 1
            in_stack = stacks == 1
            if in_stack:
                out.append("  " + s)
            continue
        if in_stack and re.match(r"^#\d+\s", s):
            if frames < CRASH_FRAMES:
                out.append("    " + s)
            frames += 1
            continue
        if in_stack and not s:
            in_stack = False
        m = INFO_FIELD.match(line)
        if m and m.group(1) in INFO_KEYS:
            out.append("%s: %s" % (m.group(1), m.group(2)))
        elif m and m.group(1) == "Message":
            out.append("Message: %s" % m.group(2))
    if frames > CRASH_FRAMES:
        out.append("    [... %d more frames left out ...]" % (frames - CRASH_FRAMES))
    if stacks == 0:
        out.append("  (no stack: no core file was kept, LimitCORE=0 for the UI and the security process)")
    return "\n".join(out) if out else "(coredumpctl info gave no field)"


def crash_details(rows):
    ok, lines = rows
    if not ok:
        return lines
    pids = []
    for l in lines:
        m = CRASH_ROW.match(l)
        if m and RELATED_EXE.search(m.group(2)):
            pids.append(m.group(1))
    if not pids:
        return "(no crash of Quickshell, Hyprland or a Grassfield program in the last 7 days)"
    parts = []
    shown = pids[-CRASH_DETAILS:][::-1]
    for pid in shown:
        ok, text = run(["coredumpctl", "--no-pager", "--since=-7d", "-1", "info", pid])
        parts.append("--- pid %s\n%s" % (pid, info_digest(text) if ok else text))
    if len(pids) > len(shown):
        parts.append("[... %d older crashes of these programs left out ...]" % (len(pids) - len(shown)))
    return "\n".join(parts)


# ---- journal ---------------------------------------------------------------------------------------------------------

# The liveness probe's routine runs (grassfield-shell-watchdog.service every 30 s): the user manager's lines that say it ran
# and ended well. The probe's own lines (a miss, a kill) and any failure of its unit are kept.
PROBE_ROUTINE = re.compile(r"^\S+ \S+ systemd\[\d+\]: (?:(?:Starting|Started|Finished) Grassfield shell liveness probe\b.*"
                           r"|grassfield-shell-watchdog\.service: (?:Deactivated successfully|Consumed .*)\.?)$")


def fold(lines):
    """(lines, routine probe runs left out, lines folded): the liveness probe's routine lines left out, and each run of
    identical consecutive lines (the same text after the time) folded into its first with "(×N, last <time>)"."""
    out, dropped, folded = [], 0, 0
    key, first, count, last = None, None, 0, ""
    for line in lines:
        if PROBE_ROUTINE.match(line):
            dropped += " Starting " in line
            continue
        stamp, _, rest = line.partition(" ")
        if first is not None and rest == key:
            count += 1
            last = stamp
            folded += 1
            continue
        if first is not None:
            out.append(first if count == 1 else "%s (×%d, last %s)" % (first, count, last))
        key, first, count, last = rest, line, 1, stamp
    if first is not None:
        out.append(first if count == 1 else "%s (×%d, last %s)" % (first, count, last))
    return out, dropped, folded


def journal_read():
    """(ok, text): this boot's journal of the Grassfield user units (every grassfield-* unit: the shell, the security
    process, the menu bridge, the prompter, the portals, the liveness probe...), at most JOURNAL_SCAN lines."""
    ok, text = run(["journalctl", "--user", "-b", "0", "-u", "grassfield-*", "--no-pager", "-q", "-o", "short-iso",
                    "-n", str(JOURNAL_SCAN)], timeout=JOURNAL_TIMEOUT, limit=JOURNAL_READ, tail=True)
    # No unit matched the glob in the journal at all: journalctl exits 1 ("Failed to add filter for units").
    return (True, "") if not ok and "Failed to add filter for units" in text else (ok, text)


def journal(read):
    ok, text = read
    if not ok:
        return text
    lines = [l for l in text.splitlines() if l.strip() and not l.startswith("[... ")]
    kept, dropped, folded = fold(lines)
    if not kept:
        return "(no entry)"
    body = bounded("\n".join(kept), JOURNAL_MAX, tail=True)
    shown = [l for l in body.splitlines() if l and not l.startswith("[... ")]
    head = "This boot, %s to %s" % (shown[0].split(" ", 1)[0], shown[-1].split(" ", 1)[0])
    if len(shown) < len(kept) or len(lines) >= JOURNAL_SCAN:
        head += " (the older lines left out: the section keeps its last %d KiB)" % (JOURNAL_MAX // 1024)
    head += "; %d routine runs of the liveness probe left out; %d repeated lines folded into the line before them (×N)." % (
        dropped, folded)
    return head + "\n" + body


# Kernel lines about memory exhaustion and crashes.
KERNEL_EVENT = re.compile(r"(?i)out of memory|oom[-_ ]?kill|invoked oom-killer|memory cgroup|segfault at|general protection|"
                          r"\btraps:|killed process|page allocation failure")


def kernel_read():
    """(ok, [line, ...]) of this boot's kernel lines about memory exhaustion or a crash, or (False, the reason)."""
    ok, text = run(["journalctl", "-k", "-b", "0", "--no-pager", "-q", "-o", "short-iso", "-n", "50000"],
                   timeout=JOURNAL_TIMEOUT, limit=JOURNAL_READ, tail=True)
    if not ok:
        return False, text
    return True, fold([l for l in text.splitlines() if KERNEL_EVENT.search(l)])[0]


def kernel(read):
    ok, lines = read
    if not ok:
        return lines
    if not lines:
        return ("(no line about memory exhaustion or a crash; the kernel's lines need a user of the wheel, adm or "
                "systemd-journal group)")
    more = len(lines) - KERNEL_LINES
    return bounded(("[... %d older lines left out ...]\n" % more if more > 0 else "") + "\n".join(lines[-KERNEL_LINES:]),
                   KERNEL_MAX, tail=True)


def oom_daemons():
    ok, text = run(["journalctl", "-b", "0", "--no-pager", "-q", "-o", "short-iso", "-n", str(OOMD_LINES),
                    "-u", "systemd-oomd.service", "-u", "earlyoom.service"], timeout=JOURNAL_TIMEOUT)
    if not ok:
        return text
    lines = fold([l for l in text.splitlines() if l.strip()])[0]
    return "\n".join(lines) if lines else "(no line: neither systemd-oomd nor earlyoom acted this boot, or neither is installed)"


# ---- units and processes ---------------------------------------------------------------------------------------------

UNIT_PROPS = ("Id", "ActiveState", "SubState", "Result", "MainPID", "ExecMainCode", "ExecMainStatus", "NRestarts",
              "MemoryCurrent", "MemoryPeak", "MemorySwapPeak", "MemoryMax", "CPUUsageNSec", "ActiveEnterTimestamp")
BYTE_PROPS = ("MemoryCurrent", "MemoryPeak", "MemorySwapPeak", "MemoryMax")
EXEC_CODES = {"0": "none", "1": "exited", "2": "killed", "3": "dumped", "4": "trapped", "5": "stopped", "6": "continued"}
UNSET = str(2 ** 64 - 1)
UI_UNIT = "grassfield-shell.service"
SECURITY_UNIT = "grassfield-security.service"
QS_UNITS = ((UI_UNIT, "the UI"), (SECURITY_UNIT, "the security process"))


def units_read():
    """(ok, [{property: value}, ...] sorted by Id) of the loaded grassfield-* user units, or (False, the reason)."""
    ok, text = run(["systemctl", "--user", "show", "--property=" + ",".join(UNIT_PROPS), "grassfield-*"])
    if not ok:
        return False, text
    found, cur = {}, {}
    for line in text.splitlines() + [""]:
        if not line.strip():
            if cur.get("Id"):
                found[cur["Id"]] = cur
            cur = {}
            continue
        k, _, v = line.partition("=")
        cur[k.strip()] = v.strip()
    return True, [found[k] for k in sorted(found)]


def human_bytes(value):
    if not str(value).isdigit() or str(value) == UNSET:
        return value or "-"
    n = float(value)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if n < 1024 or unit == "TiB":
            return ("%d %s" % (n, unit)) if unit == "B" else ("%.1f %s" % (n, unit))
        n /= 1024


def human_cpu(value):
    if not str(value).isdigit() or str(value) == UNSET:
        return value or "-"
    s = int(value) / 1e9
    return "%dmin %.1fs" % (s // 60, s % 60) if s >= 60 else "%.1fs" % s


def signal_name(number):
    try:
        return signal.Signals(int(number)).name
    except (ValueError, TypeError):
        return str(number)


def unit_lines(u):
    code = u.get("ExecMainCode", "")
    status = u.get("ExecMainStatus", "")
    status_text = "%s (%s)" % (status, signal_name(status)) if code in ("2", "3", "4") else status
    since = u.get("ActiveEnterTimestamp", "")
    pid = u.get("MainPID", "0")
    head = "%s: %s/%s%s%s" % (u.get("Id"), u.get("ActiveState", "?"), u.get("SubState", "?"),
                              " since " + since if since and u.get("ActiveState") == "active" else "",
                              ", main pid " + pid if pid not in ("", "0") else "")
    return "\n".join([
        head,
        "  Result=%s ExecMainCode=%s (%s) ExecMainStatus=%s NRestarts=%s ActiveEnterTimestamp=%s" % (
            u.get("Result", "-"), code or "-", EXEC_CODES.get(code, "?"), status_text or "-", u.get("NRestarts", "-"),
            since or "-"),
        "  " + " ".join("%s=%s" % (k, human_bytes(u.get(k, ""))) for k in BYTE_PROPS)
        + " CPUUsageNSec=%s" % human_cpu(u.get("CPUUsageNSec", "")),
    ])


def proc_fields(path):
    """{key: value} of a /proc file in `Key: value` lines, {} when it cannot be read."""
    text = read_file(path, 64 * 1024)
    out = {}
    for line in (text or "").splitlines():
        k, sep, v = line.partition(":")
        if sep:
            out[k.strip()] = v.strip()
    return out


def kib(value):
    m = re.match(r"^(\d+)\s*kB$", value or "")
    return human_bytes(int(m.group(1)) * 1024) if m else "?"


def qs_processes():
    """[(pid, unit), ...] of the user's Quickshell processes, by pid."""
    uid = os.getuid()
    out = []
    try:
        names = os.listdir(PROC)
    except OSError:
        return out
    for pid in sorted((n for n in names if n.isdigit()), key=int):
        comm = (read_file(os.path.join(PROC, pid, "comm"), 64) or "").strip()
        if comm not in ("qs", "quickshell", ".quickshell-wra"):
            continue
        uids = proc_fields(os.path.join(PROC, pid, "status")).get("Uid", "").split()
        if not uids or uids[0] != str(uid):
            continue
        cgroup = (read_file(os.path.join(PROC, pid, "cgroup"), 4096) or "").strip().splitlines()
        unit = cgroup[-1].rsplit("/", 1)[-1] if cgroup else "?"
        out.append((pid, unit))
    return out


def processes(units):
    ok, items = units
    parts = ["--- Grassfield user units (systemctl --user show)"]
    if not ok:
        parts.append(items)
    elif not items:
        parts.append("(no Grassfield unit is loaded)")
    else:
        parts += [unit_lines(u) for u in items]
    parts.append("--- Quickshell processes (/proc/<pid>/smaps_rollup and status)")
    labels = dict(QS_UNITS)
    procs = qs_processes()
    for pid, unit in procs:
        roll = proc_fields(os.path.join(PROC, pid, "smaps_rollup"))
        status = proc_fields(os.path.join(PROC, pid, "status"))
        label = labels.get(unit, "other")
        if roll:
            mem = "RSS %s, PSS %s (anonymous %s, file %s, shared memory %s), swap %s" % (
                kib(roll.get("Rss")), kib(roll.get("Pss")), kib(roll.get("Pss_Anon")), kib(roll.get("Pss_File")),
                kib(roll.get("Pss_Shmem")), kib(roll.get("Swap")))
        else:
            mem = "smaps_rollup cannot be read; RSS %s" % kib(status.get("VmRSS"))
        parts.append("pid %s, %s (%s): %s; peak RSS %s; %s threads" % (pid, label, unit, mem, kib(status.get("VmHWM")),
                                                                        status.get("Threads", "?")))
    if not procs:
        parts.append("(no Quickshell process of this user)")
    parts.append("--- System memory (free -m)")
    parts.append(run(["free", "-m"])[1].rstrip("\n"))
    parts.append("--- Memory pressure (/proc/pressure/memory)")
    parts.append((read_file(os.path.join(PROC, "pressure", "memory"), 4096) or "(cannot be read)").rstrip("\n"))
    return "\n".join(parts)


# ---- who stopped a unit by a signal ----------------------------------------------------------------------------------

KILL_LINE = re.compile(r"^(\S+) \S+ systemd\[\d+\]: (grassfield-[\w@.\\:-]+\.service): Main process exited, "
                       r"code=(killed|dumped), status=(\w+)/(\w+)")
ISO_STAMP = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:[.,]\d+)?(Z|[+-]\d\d:?\d\d)?$")
# The known killers, by the trace each leaves in the journal around the signal.
KILLERS = (
    (re.compile(r"grassfield-shell-watchdog\S*: .*(?:SIGKILL|the kill failed)"),
     "the liveness probe (grassfield-shell-watchdog): the shell had not answered its question three times in a row"),
    (re.compile(r"(?i)killed by the OOM killer|result 'oom-kill'"),
     "a memory limit: the unit's MemoryMax= reached, or the kernel's OOM killer chose a process of the unit"),
    (re.compile(r"(?i)out of memory: kill|oom-kill:|invoked oom-killer|memory cgroup out of memory"),
     "the kernel's OOM killer: the machine or a memory limit ran out of memory"),
    (re.compile(r"(?i)systemd-oomd\[\d+\]|due to memory pressure"), "systemd-oomd: the memory pressure of a slice"),
    (re.compile(r"(?i)\bearlyoom\[\d+\]"), "earlyoom: the machine was low on memory"),
    (re.compile(r"(?i)watchdog timeout"), "systemd's own watchdog of the unit (WatchdogSec=)"),
    (re.compile(r"(?i)State '[\w-]+' timed out\. Killing"), "systemd: a stop that took longer than TimeoutStopSec="),
)
CRASH_SIGNALS = {"SEGV", "ABRT", "BUS", "ILL", "FPE", "TRAP", "SYS"}


def epoch(stamp):
    m = ISO_STAMP.match(stamp)
    if not m:
        return None
    zone = m.group(2) or "Z"
    if zone == "Z":
        tz = datetime.timezone.utc
    else:
        sign = -1 if zone[0] == "-" else 1
        digits = zone[1:].replace(":", "")
        tz = datetime.timezone(sign * datetime.timedelta(hours=int(digits[:2]), minutes=int(digits[2:])))
    dt = datetime.datetime.strptime(m.group(1), "%Y-%m-%dT%H:%M:%S").replace(tzinfo=tz)
    return int(dt.timestamp())


KILL_SOURCES = re.compile(r"^\S+ \S+ (systemd|kernel|systemd-oomd|earlyoom|grassfield-[\w.-]+|qs|quickshell|Hyprland|uwsm)(\[\d+\])?: ")


def window(argv_head, t):
    ok, text = run(argv_head + ["--no-pager", "-q", "-o", "short-iso", "--since", "@%d" % (t - KILL_WINDOW),
                                "--until", "@%d" % (t + KILL_WINDOW + 1), "-n", str(KILL_LINES)], timeout=JOURNAL_TIMEOUT)
    if not ok:
        return [text]
    # Only the lines that can name a killer (the managers, the kernel, the OOM daemons, Grassfield's own units and its shell):
    # the rest of the journal around a kill is other programs' free text, which the redaction cannot all catch (review).
    lines = [l for l in text.splitlines() if l.strip() and KILL_SOURCES.match(l)]
    return fold(lines)[0] or ["(no line from the managers, the kernel or Grassfield)"]


def kills(read, kernel_read_):
    ok, text = read
    if not ok:
        return text
    found = []
    for line in text.splitlines():
        m = KILL_LINE.match(line)
        if m:
            found.append(m)
    if not found:
        return "(no Grassfield unit ended by a signal this boot)"
    kernel_lines = kernel_read_[1] if kernel_read_[0] else []
    parts = ["Which process sends a signal is recorded by neither Linux nor systemd: below, for each Grassfield unit whose main",
             "process ended by a signal this boot, the journal %d s around it and the known killers whose traces are there." % KILL_WINDOW]
    if len(found) > KILLS:
        parts.append("[... %d earlier signals left out ...]" % (len(found) - KILLS))
    for m in found[-KILLS:]:
        stamp, unit, code, status, sig = m.groups()
        t = epoch(stamp)
        parts.append("")
        parts.append("*** %s %s: main process %s, status %s/%s" % (stamp, unit, code, status, sig))
        if t is None:
            parts.append("(its time cannot be read)")
            continue
        user = window(["journalctl", "--user", "-b", "0"], t)
        system = window(["journalctl", "-b", "0"], t)
        near = [l for l in kernel_lines if abs((epoch(l.split(" ", 1)[0]) or 0) - t) <= KILL_WINDOW]
        seen = "\n".join(user + system + near)
        hints = [why for pattern, why in KILLERS if pattern.search(seen)]
        if code == "dumped" or sig.upper().replace("SIG", "") in CRASH_SIGNALS:
            hints.append("the process itself crashed (signal %s): see the crash details and Quickshell's own logs" % sig)
        if hints:
            parts.append("Known killers with a trace: " + "; ".join(hints) + ".")
        else:
            parts.append("Known killers with a trace: none (not the liveness probe, a memory limit, the kernel's OOM killer, "
                         "systemd-oomd, earlyoom or a systemd timeout): the signal came from a process that writes no journal "
                         "line, such as kill, pkill or killall run by hand, by a script or by a keyboard shortcut.")
        parts.append("--- the user manager and the user's units")
        parts += user
        parts.append("--- the system journal (the kernel included)")
        parts += system
    return bounded("\n".join(parts), KILLS_MAX)


# ---- Quickshell's own logs -------------------------------------------------------------------------------------------

def runtime_dir():
    xdg = os.environ.get("XDG_RUNTIME_DIR", "")
    return xdg if xdg.startswith("/") else "/run/user/%d" % os.getuid()


def tail_file(path, lines, limit):
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - limit))
            data = f.read(limit)
    except OSError:
        return None
    text = data.decode("utf-8", "replace").splitlines()
    if size > limit and text:
        text = text[1:]
    return "\n".join(text[-lines:])


def qs_log(instance):
    """The last lines of an instance's log: Quickshell's log reader decodes its binary log.qslog (a file path, never an instance); the plain log.log when qs cannot."""
    ok, text = run(["qs", "log", "--no-color", "--log-times", "--tail", str(QS_LOG_LINES), os.path.join(instance, "log.qslog")],
                   limit=QS_LOG_MAX, tail=True)
    if ok:
        return text.rstrip("\n") or "(empty)"
    plain = tail_file(os.path.join(instance, "log.log"), QS_LOG_LINES, QS_LOG_MAX)
    return plain if plain is not None else text


def qs_logs(units):
    base = os.path.join(runtime_dir(), "quickshell")
    pids = {u.get("Id"): u.get("MainPID", "0") for u in units[1]} if units[0] else {}
    parts = []
    for unit, label in QS_UNITS:
        pid = pids.get(unit, "0")
        if not pid.isdigit() or pid == "0":
            parts.append("--- %s (%s): not running" % (label, unit))
            continue
        link = os.path.join(base, "by-pid", pid)
        current = os.path.realpath(link)
        if not os.path.islink(link) or not os.path.isdir(current):
            parts.append("--- %s (%s, pid %s): no Quickshell log for this process" % (label, unit, pid))
            continue
        # The instances of the same shell (by-shell/<shell id>/<instance id>): the one before the running one is the one that
        # ended, by a signal or a crash.
        siblings = set()
        try:
            for shell in os.listdir(os.path.join(base, "by-shell")):
                folder = os.path.join(base, "by-shell", shell)
                ids = {os.path.realpath(os.path.join(folder, n)) for n in os.listdir(folder)}
                if current in ids:
                    siblings = ids - {current}
        except OSError:
            pass

        def mtime(path):
            try:
                return os.stat(os.path.join(path, "log.qslog")).st_mtime
            except OSError:
                return -1
        before = sorted((p for p in siblings if mtime(p) >= 0), key=mtime, reverse=True)[:1]
        for path, which in [(current, "the running instance, pid " + pid)] + [(p, "the instance before it") for p in before]:
            parts.append("--- %s (%s), %s (%s)" % (label, unit, which, os.path.basename(path)))
            parts.append(qs_log(path))
    return "\n".join(parts)


def config_dir():
    own = os.environ.get("GRASSFIELD_CONFIG_HOME", "")
    if own:
        return own
    xdg = os.environ.get("XDG_CONFIG_HOME", "")
    base = xdg if xdg.startswith("/") else os.path.join(os.environ.get("HOME", ""), ".config")
    return os.path.join(base, "grassfield")


def configuration(known, found=None):
    folder = config_dir()
    try:
        names = sorted(os.listdir(folder))
    except OSError:
        return "(no configuration folder: Grassfield's defaults apply)"
    parts = []
    shown = 0
    for name in names:
        path = os.path.join(folder, name)
        if os.path.islink(path) or not os.path.isfile(path):
            continue
        if shown >= CONFIG_FILES:
            parts.append("[... more files left out ...]")
            break
        shown += 1
        text = read_file(path, CONFIG_MAX)
        if text is None:
            parts.append("--- %s: (cannot be read)" % name)
            continue
        wallpaper = name.lower().startswith("wallpaper")
        try:
            data = json.loads(text)
            if name == "folder-styles.json":
                data = folder_styles(data)
            types = schema_path_types() if name == "grassfield.json" else {}
            body = json.dumps(scrub_paths(redact_json(data), types, (), wallpaper), indent=1, ensure_ascii=False)
        except ValueError:
            body = "(not JSON: left out)" if name == "folder-styles.json" else scrub_text(redact_desc(redact_lines(text), known, DESC_FIELD, found),
                                                                                           wallpaper)
        parts.append("--- %s\n%s" % (name, body))
    return "\n".join(parts) if parts else "(the folder is empty)"


def default_folder():
    home = os.environ.get("HOME", "")
    xdg = os.environ.get("XDG_CONFIG_HOME", "")
    dirs = os.path.join(xdg if xdg.startswith("/") else os.path.join(home, ".config"), "user-dirs.dirs")
    text = read_file(dirs) or ""
    for line in text.splitlines():
        m = re.match(r'^\s*XDG_DOWNLOAD_DIR\s*=\s*"(.*)"\s*$', line)
        if m:
            value = m.group(1).replace("$HOME", home, 1) if m.group(1).startswith("$HOME") else m.group(1)
            if value.startswith("/") and os.path.isdir(value) and os.path.realpath(value) != os.path.realpath(home):
                return value
    downloads = os.path.join(home, "Downloads")
    return downloads if os.path.isdir(downloads) else home


def create(target, stamp):
    """Open a new file (0600, O_EXCL, no link followed) at `target` (a folder or a file path): (fd, path)."""
    if os.path.isdir(target):
        base, ext = os.path.join(target, "grassfield-report-" + stamp), ".txt"
    else:
        base, ext = os.path.splitext(target)
        ext = ext or ".txt"
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)
    for n in range(1, 100):
        path = base + ("" if n == 1 else "-%d" % n) + ext
        try:
            fd = os.open(path, flags, 0o600)
        except FileExistsError:
            continue
        os.fchmod(fd, 0o600)
        return fd, path
    raise FileExistsError(base + ext)


def report(now):
    rel = os_release()
    displays, failed = hypr_monitors()
    known = display_serials(displays)
    found = set()
    version = (read_file(VERSION_FILE, 200) or "").strip() or "unknown (no %s)" % VERSION_FILE[len(FILE_ROOT):]
    head = [
        "Grassfield diagnostic report",
        "Created: %s UTC by grassfield-report (read-only; nothing was sent anywhere)." % now.strftime("%Y-%m-%d %H:%M:%S"),
        "Removed: the home folder (shown as ~), the user name (<user>), the real name (<name>), the computer's name (<host>),",
        "values that look like passwords, tokens or keys ([redacted]), hardware serial numbers ([serial]) and, in the logs,",
        "free text such as window titles, network names and notification bodies (<text>). Read it before you share it.",
        "",
        "Grassfield version: %s" % version,
        "Session: GRASSFIELD_SESSION=%s XDG_CURRENT_DESKTOP=%s XDG_SESSION_TYPE=%s" % (
            os.environ.get("GRASSFIELD_SESSION", ""), os.environ.get("XDG_CURRENT_DESKTOP", ""), os.environ.get("XDG_SESSION_TYPE", "")),
        "Kernel: %s %s" % (platform.release(), platform.machine()),
    ]
    # Read once, used by several sections. Every log (the journal, the kernel's, Quickshell's) has its free text replaced.
    units = units_read()
    read = journal_read()
    kernel_events = kernel_read()
    rows = crash_rows()
    logs = lambda text: redact_device_names(redact_free_text(text))
    sections = [
        ("Packages", packages()),
        ("Omarchy", "\n".join("%s=%s" % (k, rel[k]) for k in ("NAME", "VERSION_ID", "BUILD_ID") if k in rel) or "(no os-release)"),
        ("Compositor", run(["hyprctl", "version"])[1]),
        ("Compositor plugin", plugin()),
        ("Displays", monitors(displays, failed)),
        ("Audio devices", redact_device_names(run(["wpctl", "status"])[1], every_line=True)),
        ("Processes and units", processes(units)),
        ("Units stopped by a signal (this boot)", logs(kills(read, kernel_events))),
        ("Crashes (last 7 days)", crashes(rows)),
        ("Crash details of Quickshell, Hyprland and Grassfield programs (last 7 days)", logs(crash_details(rows))),
        ("Kernel: out of memory and crashes (this boot)", logs(kernel(kernel_events))),
        ("Memory killers: systemd-oomd and earlyoom (this boot)", logs(oom_daemons())),
        ("Journal of the Grassfield units (this boot)", logs(journal(read))),
        ("Quickshell's own logs", logs(qs_logs(units))),
        ("Configuration (%s)" % config_dir(), configuration(known, found)),
    ]
    body = "\n".join(head) + "\n"
    for title, text in sections:
        body += "\n== %s ==\n%s\n" % (title, text.rstrip("\n"))
    return redact_serials(body, known, found)


def main(argv):
    output = ""
    args = argv[1:]
    while args:
        a = args.pop(0)
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--output" and args:
            output = args.pop(0)
        elif a.startswith("--output="):
            output = a[len("--output="):]
        else:
            return usage("unknown argument: " + a)
    if os.geteuid() == 0:
        print("grassfield-report: run it as yourself, not as root (it reads your session, not the system's)", file=sys.stderr)
        return 2
    now = datetime.datetime.now(datetime.timezone.utc)
    target = output or default_folder()
    if not target:
        return usage("no folder to write into (HOME is not set)")
    home, names = identity()
    text = redact_identity(redact_secrets(report(now)), home, names)
    try:
        fd, path = create(target, now.strftime("%Y%m%d-%H%M%S"))
    except OSError as e:
        print("grassfield-report: cannot write the report in %s: %s" % (target, e.strerror or e), file=sys.stderr)
        return 1
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    print(os.path.abspath(path))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
