#!/bin/bash -p
# grassfield-store-run: Grassfield Store's script in Omarchy's terminal (ADR-0037 b.2; spec SR17). OPUS SECURITY REVIEW
# REQUIRED (ADR-0037 e.9). It runs as the user, never as root: Omarchy's recipes call sudo themselves, in this terminal,
# as in Omarchy's own menu. Started only by the Store, as
#   omarchy-launch-floating-terminal-with-presentation "/usr/lib/grassfield/grassfield-store-run <op-id> <deadline> setup <recipe> [<arg>...]"
#   omarchy-launch-floating-terminal-with-presentation "/usr/lib/grassfield/grassfield-store-run <op-id> <deadline> aur <command> <package>..."
#   omarchy-launch-floating-terminal-with-presentation "/usr/lib/grassfield/grassfield-store-run <op-id> <deadline> flatpak omarchy-pkg-add flatpak"
# the command string built from the validated tokens of ADR-0037 e.5 only, and watched through
# $XDG_RUNTIME_DIR/grassfield/store/<op-id>.started and <op-id>.exit (the terminal is detached: no exit code comes back).
# It never runs as root, and runs every program with PATH=<Omarchy's folder>/bin:/usr/bin, without BASH_ENV or the
# caller's exported shell functions (`bash -p` reads neither for itself): the commands the recipe names are Omarchy's
# pinned ones and the system's; its checks run in the C locale, the recipe in the user's own. Then it:
#   1. refuses to start after <deadline> (Unix seconds: the Store stops waiting for the terminal 60 s after asking);
#   2. takes Omarchy's update lock (the file omarchy-update-lock locks), on a descriptor of its own that every program it
#      starts gets closed (9>&-): `omarchy update` says it is already running, and no process the recipe leaves running
#      keeps the lock (S13); refuses when it is held. The lock goes when this script ends, whatever ends it;
#   3. writes <op-id>.started (its pid and start time: the Store knows it still runs);
#   4. checks again: no db.lck, pacman -Qu answers (exit 0 or 1) and lists nothing but "[ignored]" (S12), the recipe is
#      Omarchy's and pinned (with omarchy-pkg-missing for omarchy-pkg-aur-add and omarchy-pkg-add, which call it), and every file the
#      catalog pins (<op-id>.pins, the signed catalog's pins the Store wrote there) is unchanged in the installed
#      Omarchy; for the AUR (step 3b2), its plan again: Omarchy's package lists read, pacman's HoldPkg and what Grassfield's packages
#      list as optional dependencies (pacman -Qq, -Qi: kio-extras, cmake; ADR-0046 D3; unreadable: exit 7), and no name the
#      deny list (the helper's, ADR-0037 b.1, ADR-0046) names; an install only of names pacman does not resolve from the repositories (a package,
#      a provider, a group: yay would take the repository's), a removal only of packages installed explicitly from
#      outside the repositories, and whose whole plan (-Rs) names no denied package;
#   5. runs the recipe, ${OMARCHY_PATH:-/usr/share/omarchy}/bin/<recipe>, with its arguments, as an argument vector;
#   6. writes <op-id>.exit with the code (by rename, the Store never reads half a file) and exits with it.
# setup: <recipe> is omarchy-install-<name> or omarchy-remove-<name>, with at most 4 arguments of [a-z0-9][a-z0-9.-]{0,63}.
# aur: <command> is omarchy-pkg-aur-add (yay builds the packages, sudo installs them) or omarchy-pkg-drop (sudo pacman
# -Rns), with 1 to 4 package names.
# flatpak: Get Flatpak… (step 3c part 3, ADR-0037 SD24): <command> is omarchy-pkg-add with the one argument flatpak (sudo
# pacman -S --needed flatpak, from the repositories), nothing else.
# Exit: 0 done; 1 the recipe failed; 2 usage; 3 busy (Omarchy's update lock, or pacman's db.lck); 4 the last system update
# did not finish; 5 the installed Omarchy differs from the catalog's pins (or the recipe is missing); 6 too late (the
# terminal opened after the deadline); 7 the AUR's plan refused (a repository resolves the name; a package protected, needed,
# not installed as an app or from a repository; Grassfield's optional dependencies unreadable); 130 stopped with Ctrl+C (before the recipe: nothing was run). A closed
# terminal ends it without an exit file (SIGHUP): the Store reads the system then.
set -uo pipefail
umask 077
# Ctrl+C from the start is answered with 130 (below). A handler, not an ignored signal: an ignored SIGINT would be ignored
# by the recipe too, which Ctrl+C then could not stop.
stopped=0
trap 'stopped=1' INT
# The caller's exported shell functions (BASH_FUNC_<name>%% in the environment, one would stand for a command) reach no
# program: `bash -p` does not import them here, and the recipe, a bash script too, runs without them (below). Nor do
# BASH_ENV and the rest of what bash reads at its start.
unexported=()
while IFS= read -r -d '' entry; do
  [[ $entry == BASH_FUNC_* ]] && unexported+=(-u "${entry%%=*}")
done </proc/$$/environ
unset BASH_ENV ENV CDPATH GLOBIGNORE
# The checks run in the C locale: bash's bracket ranges follow the locale's collation (under en_US.UTF-8 "exämple", "ﬁle"
# or "ab²" would pass [a-z0-9...]), and pacman's words ("[ignored]", "target not found") are read in English, as the
# Store and the helper read them. The user's own locale comes back for the recipe, which speaks to the user (step 5).
lc_all_set=${LC_ALL+1} lc_all=${LC_ALL-}
export LC_ALL=C

usage() {
  echo "grassfield-store-run: ${1:-started by Grassfield Store only}" >&2
  exit 2
}

((EUID != 0)) || usage "runs as the user, never as root"
(($# >= 4 && $# <= 8)) || usage
op=$1 deadline=$2 kind=$3 recipe=$4
shift 4
[[ $op =~ ^[0-9a-f]{32}$ && $deadline =~ ^[0-9]{1,12}$ ]] || usage
case $kind in
  setup)
    [[ $recipe =~ ^omarchy-(install|remove)-[a-z0-9-]+$ ]] || usage
    for arg in "$@"; do
      [[ $arg =~ ^[a-z0-9][a-z0-9.-]{0,63}$ ]] || usage
    done
    ;;
  aur)
    [[ $recipe == omarchy-pkg-aur-add || $recipe == omarchy-pkg-drop ]] || usage
    (($# >= 1)) || usage
    for arg in "$@"; do
      [[ $arg =~ ^[a-z0-9@_+][a-z0-9@._+-]{0,127}$ ]] || usage
    done
    ;;
  flatpak)
    [[ $recipe == omarchy-pkg-add ]] && (($# == 1)) && [[ $1 == flatpak ]] || usage
    ;;
  *) usage ;;
esac
omarchy=${OMARCHY_PATH:-/usr/share/omarchy}
omarchy=${omarchy%/}
[[ $omarchy == /* && $omarchy != *:* ]] || usage
export PATH=$omarchy/bin:/usr/bin
[[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR && ! -L $XDG_RUNTIME_DIR ]] || usage
dir=$XDG_RUNTIME_DIR/grassfield/store
# Its folder is the user's own and not a link before its mode changes (chmod follows a link).
mkdir -p -- "$dir" 9>&- || usage
[[ -d $dir && ! -L $dir && -O $dir ]] || usage
chmod 700 -- "$dir" 9>&- || usage
[[ ! -e $dir/$op.exit && ! -e $dir/$op.started ]] || usage # an operation id runs once

# The exit file, by rename, then the exit (the lock goes with this process). Omarchy's launcher says "Done!" after it.
finish() { # code [message]
  [[ -n ${2:-} ]] && printf '\n%s\n' "$2"
  printf '%s\n' "$1" >|"$dir/.$op.exit" && mv -f -- "$dir/.$op.exit" "$dir/$op.exit" 9>&-
  exit "$1"
}

# 1. The deadline (60 s after the Store asked).
(($(date +%s 9>&-) <= deadline)) || finish 6 "This request came too late: nothing was run. Ask again in Grassfield Store."

# 2. Omarchy's update lock.
exec 9>>"$XDG_RUNTIME_DIR/omarchy-update.lock" || finish 3 "Cannot open Omarchy's update lock."
flock -n 9 || finish 3 "Another installation or an Omarchy update is running. Try again when it has finished."

# 3. Started: its pid and start time (field 22 of /proc/<pid>/stat; the command name before it may hold spaces).
read -r stat </proc/$$/stat || finish 1 "Cannot read /proc/$$/stat."
rest=${stat##*) }
read -r -a fields <<<"$rest"
printf '%s %s\n' "$$" "${fields[19]-}" >|"$dir/.$op.started" && mv -f -- "$dir/.$op.started" "$dir/$op.started" 9>&- ||
  finish 1 "Cannot write $dir/$op.started."

# Ctrl+C stops what runs (its default action there) and is answered with 130 and the exit file: before the recipe,
# nothing of it ran; a check it cut short is not passed.
stop() {
  ((stopped)) && finish 130 "Stopped: nothing was run."
}
stop

# 4. Checked again, under the lock.
dbpath=$(pacman-conf DBPath 9>&-)
code=$?
stop
((code == 0)) || finish 1 "pacman-conf DBPath failed."
[[ ! -e ${dbpath%/}/db.lck ]] || finish 3 "pacman is running (or stopped mid-way and left its lock). Try again when it has finished."
# pacman -Qu exits 0 when it lists packages and 1 when there are none; anything else is not an answer.
updates=$(pacman -Qu 2>/dev/null 9>&-)
code=$?
stop
((code == 0 || code == 1)) || finish 1 "pacman -Qu failed (exit code $code): nothing was run."
while IFS= read -r line; do
  [[ -z $line || $line == *' [ignored]' ]] && continue
  finish 4 "The last system update did not finish ($line). Finish it in Software Update, then try again."
done <<<"$updates"
program=$omarchy/bin/$recipe
[[ -f $program && -x $program ]] || finish 5 "Omarchy's $recipe is not installed: nothing was run."
pins=$dir/$op.pins
[[ -f $pins && ! -L $pins && -O $pins ]] || finish 5 "The Store's pins for this setup are missing: nothing was run."
count=0
# The recipe's own file, and for the AUR's omarchy-pkg-aur-add and Get Flatpak's omarchy-pkg-add the omarchy-pkg-missing
# they call first.
declare -A needed=([bin/$recipe]=1)
[[ $recipe == omarchy-pkg-aur-add || $recipe == omarchy-pkg-add ]] && needed[bin/omarchy-pkg-missing]=1
checked="This setup was checked"
[[ $kind == aur ]] && checked="Installing from the AUR was checked"
[[ $kind == flatpak ]] && checked="Getting Flatpak was checked"
while IFS= read -r line; do
  [[ $line =~ ^([0-9a-f]{64})\ \ ([A-Za-z0-9_.+-]+(/[A-Za-z0-9_.+-]+){0,7})$ ]] || finish 5 "The Store's pins cannot be read: nothing was run."
  want=${BASH_REMATCH[1]} rel=${BASH_REMATCH[2]}
  [[ /$rel/ != */./* && /$rel/ != */../* ]] || finish 5 "The Store's pins cannot be read: nothing was run."
  unset 'needed[$rel]'
  have=$(sha256sum -- "$omarchy/$rel" 2>/dev/null 9>&-) || have=missing
  stop
  [[ ${have%% *} == "$want" ]] ||
    finish 5 "$checked against another version of Omarchy ($rel differs): nothing was run. The Store offers it again once its catalog has checked your Omarchy."
  count=$((count + 1))
done <"$pins"
((count > 0 && ${#needed[@]} == 0)) || finish 5 "The Store's pins do not name $recipe (or what it calls): nothing was run."
stop

# What Grassfield's own packages list as optional dependencies (kio-extras, cmake...): the helper's gf_optional_names, as it is
# (ADR-0046 D3). One name per line.
gf_optional_names() {
  local -a own=()
  local qi
  mapfile -t own < <(pacman -Qq 2>/dev/null 9>&- | grep -E '^grassfield(-|$)')
  ((${#own[@]})) || return 0
  qi=$(pacman -Qi -- "${own[@]}" 2>/dev/null 9>&-) || return 1
  awk '
    /^[^ \t]/ { inopt = ($0 ~ /^Optional Deps[ \t]*:/); if (inopt) sub(/^[^:]*:[ \t]*/, ""); else next }
    inopt { n = $0; sub(/^[ \t]+/, "", n); sub(/[^a-z0-9@._+-].*$/, "", n); if (n != "" && n != "None") print n }' <<<"$qi"
}

# The deny list of grassfield-store-helper's remove (ADR-0037 b.1, S16; ADR-0046 D2, D3), its case list copied as it is
# (Omarchy's lists in omarchy_lists here: $omarchy is Omarchy's folder): tests/integration/store_run.sh holds it to the
# vectors the helper and the Store's C++ rule answer (tests/fixtures/store/removal-vectors.json).
denied() { # name: 0 when the system, Omarchy or Grassfield needs it
  [[ -n ${gfopt[$1]-} ]] && return 0
  case $1 in
    base | base-devel | filesystem | glibc | bash | coreutils | util-linux | shadow | pam | sudo | polkit | dbus | dbus-broker | \
      dbus-broker-units | kmod | mkinitcpio | dracut | grub | efibootmgr | refind | syslinux | snapper | btrfs-progs | \
      cryptsetup | lvm2 | plymouth | archlinux-keyring | intel-ucode | amd-ucode) return 0 ;;
    # The session's runtime (ADR-0046 D3): the compositor, the shell, sound, network, the portals, the login. Qt is not here by
    # prefix: pacman keeps every Qt package the session requires, and an app's own (qt6-speech) must stay removable.
    hyprland | quickshell | networkmanager | mesa | wireplumber | sddm | uwsm | gnome-keyring | xdg-desktop-portal | \
      xdg-desktop-portal-* | pipewire | pipewire-*) return 0 ;;
    linux | linux-* | systemd | systemd-* | limine | limine-* | pacman | pacman-* | yay | yay-* | omarchy | omarchy-* | \
      grassfield | grassfield-*) return 0 ;;
    *-firmware | *-firmware-*) return 0 ;;
    # The apps Omarchy installs on every machine and itself offers to remove (omarchy-remove-preinstalls, ADR-0046 D2): on
    # Omarchy's lists, but not the system's: macOS lets you delete its optional bundled apps. Only HoldPkg keeps them.
    aether | cliamp | libreoffice-fresh | xournalpp | pinta | obsidian | obs-studio | kdenlive | moonlight-qt | lazydocker | \
      omacut | omacalc | omawrite) [[ -n ${hold[$1]-} ]]; return ;;
  esac
  [[ -n ${omarchy_lists[$1]-} || -n ${hold[$1]-} ]]
}

# 4b. The AUR's plan, checked again (the Store checked it before; the system may have changed since).
if [[ $kind == aur ]]; then
  refuse() { finish 7 "$1: nothing was run."; }
  # What denied() reads, for both commands: Omarchy's two package lists (in the installed Omarchy), pacman's HoldPkg and
  # Grassfield's optional dependencies (unreadable: exit 7, nothing is run).
  declare -A omarchy_lists=() hold=() explicit=() foreign=() gfopt=()
  for list in "$omarchy/install/omarchy-base.packages" "$omarchy/install/omarchy-other.packages"; do
    [[ -f $list ]] || continue
    while IFS= read -r line; do
      line=${line%%#*}
      for word in $line; do omarchy_lists[$word]=1; done
    done <"$list"
  done
  ((${#omarchy_lists[@]})) || refuse "Omarchy's package lists are missing or empty"
  while IFS= read -r line; do [[ -n $line ]] && hold[$line]=1; done < <(pacman-conf HoldPkg 2>/dev/null 9>&-)
  gf_names=$(gf_optional_names)
  code=$?
  stop
  ((code == 0)) || refuse "cannot read what Grassfield's packages list as optional dependencies"
  while IFS= read -r line; do [[ -n $line ]] && gfopt[$line]=1; done <<<"$gf_names"
  stop
  if [[ $recipe == omarchy-pkg-aur-add ]]; then
    # Never a name of the deny list: what the Store could not remove it does not build, and an AUR package never takes a
    # name of the system's, Omarchy's or Grassfield's (grassfield-*, omarchy-*: anyone can name a package on the AUR).
    for name in "$@"; do
      denied "$name" && refuse "$name is a name the system, Omarchy or Grassfield uses: Grassfield Store does not build it from the AUR"
    done
    # yay installs from the repositories whatever pacman resolves a name to (the package, a provider of it, a group): only
    # names pacman does not resolve (-Sp, as the user: S10). Exit 0 resolved; 1 with pacman's whole line "error: target
    # not found: <name>" (never a longer name's) not there; anything else is not an answer. A system whose pacman lists
    # no repository at all is not read as "not there".
    [[ -n $(pacman -Slq 2>/dev/null 9>&- | head -n 1) ]] || finish 1 "pacman lists no repository: nothing was run."
    stop
    for name in "$@"; do
      out=$(pacman -Sp --print-format '%n' -- "$name" 2>&1 </dev/null 9>&-)
      code=$?
      stop
      ((code == 0)) && refuse "A repository has $name, or a package that provides it: Grassfield Store installs it from there"
      [[ $'\n'$out$'\n' == *$'\n'"error: target not found: $name"$'\n'* ]] ||
        finish 1 "pacman could not read the repositories (exit code $code): nothing was run."
    done
  else
    while IFS= read -r line; do [[ -n $line ]] && explicit[$line]=1; done < <(pacman -Qqe 2>/dev/null 9>&-)
    while IFS= read -r line; do [[ -n $line ]] && foreign[$line]=1; done < <(pacman -Qqm 2>/dev/null 9>&-)
    stop
    for name in "$@"; do
      denied "$name" && refuse "$name is part of the system, Omarchy or Grassfield"
      [[ -n ${explicit[$name]-} ]] || refuse "$name was not installed as an app (it is not installed, or another package needs it)"
      [[ -n ${foreign[$name]-} ]] || refuse "A repository has $name: Grassfield Store removes it from there"
    done
    # The whole plan: -Rns removes what -Rs --print lists (pacman refuses --print with -n), as the user (S10).
    plan=$(pacman -Rs --print --print-format '%n' -- "$@" 2>&1 9>&-)
    code=$?
    stop
    ((code == 0)) || { printf '%s\n' "$plan"; refuse "pacman cannot remove $*"; }
    while IFS= read -r name; do # one name a line: never split into words, never a file name pattern
      denied "$name" && refuse "Removing $* would also remove $name, part of the system, Omarchy or Grassfield"
    done <<<"$plan"
  fi
fi
stop

# 5. The recipe, without the lock's descriptor, in the user's own locale.
if [[ -n $lc_all_set ]]; then LC_ALL=$lc_all; else unset LC_ALL; fi
echo "Grassfield Store runs Omarchy's $recipe $*"
echo
env "${unexported[@]}" -- "$program" "$@" 9>&-
code=$?
((stopped || code == 130)) && finish 130 "Stopped. Part of it may be installed: Grassfield Store reads what is there."
((code == 0)) && finish 0
finish 1 "$recipe stopped with exit code $code."
