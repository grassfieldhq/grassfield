{
"comment": "Shared vectors for the run-mode rule (ADR-0019). QML: shell/lib/RunMode.js via tests/unit/tst_runmode.qml; C++ (slice M6): apps/runmode.h via tests/unit/files/tst_runmode.cpp. The processes outside Qt or with their own read (slice M7): the compositor plugin (compositor/src/core/RunMode.hpp via compositor/tests/RunModeTest.cpp) and the menu bridge (bridges/menu-bridge/src/Safety.h via tests/unit/menu-bridge/tst_menubridge.cpp) read the modes (dev, session). A key missing from env is an unset variable. Expected values are the whole truth: nothing but the exact strings opens a gate.",
"refused": "refused",
"members": {
 "comment": "Every member of shell/lib/Mode.qml, exactly: its type and the canonical form of its expression, as Qt's syntax tree reads it (checked by tests/shell/run_mode_env.sh, which also runs the real singleton in every environment below). A member that is not here, a second root child, a timer or any other expression fails. The C++ side lists the same names in apps/runmode.h from M6.",
 "root": "Singleton",
 "pragmas": ["Singleton"],
 "imports": ["QtQuick", "Quickshell", "\"RunMode.js\" as RunMode"],
 "properties": {
  "dev": ["bool", "RunMode.dev(%(DEV)s, %(SESSION)s)"],
  "session": ["bool", "RunMode.session(%(SESSION)s)"],
  "fixtures": ["bool", "RunMode.fixtures(%(DEV)s, %(SESSION)s, %(VISUAL_FIXTURES)s)"],
  "ownBus": ["bool", "RunMode.ownBus(%(DEV)s, %(SESSION)s, %(PRIVATE_BUS)s)"],
  "updateNotices": ["bool", "RunMode.updateNotices(%(SESSION)s)"],
  "refused": ["string", "RunMode.REFUSED"],
  "configDir": ["string", "RunMode.configDir(%(CONFIG_HOME)s, %(XDG_CONFIG_HOME)s, %(HOME)s)"],
  "stateDir": ["string", "RunMode.stateDir(%(STATE_HOME)s, %(XDG_STATE_HOME)s, %(HOME)s)"],
  "shellDir": ["string", "Quickshell.shellDir"],
  "stateHome": ["string", "RunMode.homeOverride(%(STATE_HOME)s)"],
  "appsTrace": ["bool", "RunMode.appsTrace(%(APPS_TRACE)s)"],
  "appsGtkPortal": ["bool", "RunMode.appsGtkPortal(%(APPS_GTK_USE_PORTAL)s)"],
  "appsQtTheme": ["string", "RunMode.appsQtTheme(%(APPS_QT_THEME)s)"]
 },
 "functions": {
  "devValue": [["name"], "return RunMode.devPlumbing(%(DEV)s, %(SESSION)s, Quickshell.env((\"GRASSFIELD_\" op0 name)))"]
 },
 "env": {
  "DEV": "Quickshell.env(\"GRASSFIELD_DEV\")",
  "SESSION": "Quickshell.env(\"GRASSFIELD_SESSION\")",
  "VISUAL_FIXTURES": "Quickshell.env(\"GRASSFIELD_VISUAL_FIXTURES\")",
  "PRIVATE_BUS": "Quickshell.env(\"GRASSFIELD_PRIVATE_BUS\")",
  "CONFIG_HOME": "Quickshell.env(\"GRASSFIELD_CONFIG_HOME\")",
  "STATE_HOME": "Quickshell.env(\"GRASSFIELD_STATE_HOME\")",
  "XDG_CONFIG_HOME": "Quickshell.env(\"XDG_CONFIG_HOME\")",
  "XDG_STATE_HOME": "Quickshell.env(\"XDG_STATE_HOME\")",
  "HOME": "Quickshell.env(\"HOME\")",
  "APPS_TRACE": "Quickshell.env(\"GRASSFIELD_APPS_TRACE\")",
  "APPS_GTK_USE_PORTAL": "Quickshell.env(\"GRASSFIELD_APPS_GTK_USE_PORTAL\")",
  "APPS_QT_THEME": "Quickshell.env(\"GRASSFIELD_APPS_QT_QPA_PLATFORMTHEME\")"
 }
},
"runmode": {
 "comment": "RunMode.js as Qt's syntax tree reads it (checked by tests/shell/run_mode_env.sh; qmldom reads no .js, so the body is wrapped in a scratch QML function). Comments and layout may change, nothing else: update on purpose with `python3 -I tests/shell/run_mode_env.d/run.py --print-runmode` after a review of the rule.",
 "functions": {
  "dev": [["devValue", "sessionValue"], "return ((devValue op1f \"1\") op1 (sessionValue op20 \"1\"))"],
  "session": [["sessionValue"], "return (sessionValue op1f \"1\")"],
  "fixtures": [["devValue", "sessionValue", "fixturesValue"], "return (dev(devValue, sessionValue) op1 (fixturesValue op1f \"1\"))"],
  "ownBus": [["devValue", "sessionValue", "privateBusValue"], "return (!dev(devValue, sessionValue) op1b (privateBusValue op1f \"1\"))"],
  "updateNotices": [["sessionValue"], "return session(sessionValue)"],
  "devPlumbing": [["devValue", "sessionValue", "value"], "if (!dev(devValue, sessionValue)) return \"\" ; return (((value op1f undefined) op1b (value op1f null)) ? \"\" : String(value))"],
  "configDir": [["configHome", "xdgConfigHome", "home"], "if (configHome) return configHome ; return (((xdgConfigHome ? xdgConfigHome : (home op0 \"/.config\"))) op0 \"/grassfield\")"],
  "stateDir": [["stateHome", "xdgStateHome", "home"], "if (stateHome) return stateHome ; return (((xdgStateHome ? xdgStateHome : (home op0 \"/.local/state\"))) op0 \"/grassfield\")"],
  "appsTrace": [["value"], "return (value op1f \"1\")"],
  "appsGtkPortal": [["value"], "return (value op1f \"1\")"],
  "appsQtTheme": [["value"], "return (((value op1f \"xdgdesktopportal\")) ? value : \"\")"],
  "homeOverride": [["value"], "return (value ? value : \"\")"]
 },
 "vars": {"REFUSED": "\"refused\""}
},
