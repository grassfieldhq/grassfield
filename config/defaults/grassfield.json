{
  "version": 1,
  "appearance": "dark",
  "material": {
    "transparency": 0.25,
    "profile": "balanced"
  },
  "accessibility": {
    "reduceTransparency": false,
    "reduceMotion": false,
    "increaseContrast": false,
    "textSize": 1,
    "zoom": false,
    "zoomLevel": 2
  },
  "dock": {
    "pinned": [
      "chromium",
      "foot",
      "org.grassfield.Settings"
    ],
    "size": 48,
    "position": "bottom",
    "magnification": 1.6,
    "autohide": false,
    "magnificationEnabled": false,
    "recent": [],
    "showRecents": true,
    "folders": [
      "~/Downloads"
    ],
    "stackOptions": {},
    "minimizeIntoApp": false,
    "clickMinimizes": true,
    "animateOpening": true,
    "showIndicators": true,
    "minimizeEffect": "funnel",
    "endTask": false
  },
  "windows": {
    "titlebarDoubleClick": "fill",
    "tilingEdges": true,
    "tilingMenuBar": true,
    "tilingOptionDrag": true,
    "tilingMargins": true,
    "tilingLayouts": true,
    "tilingSuggestions": true,
    "tilingGroups": true,
    "stages": false,
    "rebuildExtension": false
  },
  "notifications": {
    "dnd": false,
    "previews": "unlocked",
    "history": "week",
    "appStyles": [],
    "appPreviews": []
  },
  "lock": {
    "idleMinutes": 5,
    "displayOffBattery": 2,
    "displayOffPower": 10,
    "requirePasswordAfterDisplayOff": "immediately",
    "showUser": true,
    "showMessage": false,
    "message": ""
  },
  "energy": {
    "preventSleep": true,
    "slowHiddenApps": true
  },
  "hotCorners": {
    "topLeft": "none",
    "topRight": "none",
    "bottomLeft": "none",
    "bottomRight": "none"
  },
  "desktop": {
    "showIcons": true
  },
  "displays": {
    "main": []
  },
  "menubar": {
    "showBackground": false,
    "autoHide": "fullscreen",
    "showNowPlaying": true,
    "showSearch": true,
    "showWifi": true,
    "showSound": true,
    "showBattery": true,
    "showBatteryPercentage": true,
    "showFocus": true,
    "clockDate": "auto",
    "clockShowDayOfWeek": true,
    "clockHours": "auto",
    "clockShowAmPm": true,
    "clockFlashSeparators": false,
    "showTrayItems": true,
    "recentItems": 10,
    "clockShowSeconds": false
  },
  "accent": {
    "color": "multicolor",
    "highlight": "automatic"
  },
  "terminal": {
    "matchAppearance": false,
    "lightTheme": "Catppuccin Latte",
    "darkTheme": "Tokyo Night"
  },
  "keyboard": {
    "shortcutStyle": "automatic",
    "showInputMenu": true,
    "dictation": false
  },
  "region": {
    "formats": "auto",
    "firstDayOfWeek": "auto"
  },
  "preview": {
    "textInImages": true
  },
  "icons": {
    "mode": "default",
    "tint": "accent",
    "folderColor": "theme"
  },
  "pointer": {
    "size": 24,
    "outlineColor": "#ffffff",
    "fillColor": "#000000"
  },
  "capture": {
    "mode": "selection",
    "saveTo": "desktop",
    "location": "screenshots",
    "timer": "none",
    "microphone": "none",
    "showPointer": false,
    "lastSelection": ""
  },
  "search": {
    "showApps": true,
    "showDocuments": true,
    "showRecents": true,
    "showCalculator": true,
    "showConversions": true,
    "showSettings": true,
    "showCommands": true,
    "historyResetAt": 0,
    "clipboard": {
      "enabled": false,
      "retention": "8h",
      "keepOnDisk": false,
      "clearedAt": 0,
      "pinnedClearedAt": 0
    }
  },
  "screensaver": {
    "idleMinutes": 0,
    "kind": "artwork",
    "folder": ""
  },
  "sound": {
    "alert": "meadow",
    "alertVolume": 0.75,
    "effectsOutput": "",
    "uiEffects": true,
    "volumeFeedback": false
  },
  "store": {
    "sources": {
      "aur": false,
      "flathub": false
    },
    "screenshots": true
  },
  "updates": {
    "automaticCheck": true
  },
  "wallpaper": {
    "source": "builtin",
    "path": "",
    "color": "#000000",
    "fit": "fill",
    "interval": "1h",
    "shuffle": true,
    "videoOnBattery": false,
    "online": {
      "provider": "commons"
    },
    "artwork": "grassfield",
    "artworkVariant": "timeOfDay",
    "moving": false,
    "outputs": []
  }
}
